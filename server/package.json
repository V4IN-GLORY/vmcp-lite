{
  "name": "vmcp-server",
  "version": "0.1.2",
  "type": "module",
  "bin": {
    "vmcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "fake-plugin": "node scripts/fake-plugin.mjs",
    "token": "node scripts/print-token.mjs",
    "probe": "node scripts/probe.mjs",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "build:plugin": "rojo build ../plugin.project.json -o VMCP.rbxmx",
    "prepack": "npm run build && npm run build:plugin"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2"
  },
  "files": [
    "dist",
    "VMCP.rbxmx"
  ],
  "private": true
}
