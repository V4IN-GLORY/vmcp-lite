<roblox version="4">
  <Item class="Script" referent="0">
    <Properties>
      <string name="Name">VMCP</string>
      <token name="RunContext">0</token>
      <string name="Source"><![CDATA[--!strict

-- This runs in every DataModel Studio has open. The edit one gets the panel and the toolbar; a
-- playtest's server and clients get the same tools with no UI at all, because the plugin is
-- loaded into those too and that is what makes a live context reachable.

local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local Bridge = require(script.Bridge)
local LogBuffer = require(script.Log.Buffer)

local DEFAULT_PORT = "8791"

-- Started before anything else can log: get_logs is only useful if it was already recording when
-- the interesting error happened.
LogBuffer.Start()

-- An unsaved place reports PlaceId 0, which the server refuses. This GUID stands in for it and is
-- stored per-machine so the place keeps its identity across sessions.
local function getPlaceGuid(): string
	local guid = plugin:GetSetting("placeGuid")
	if not guid then
		guid = HttpService:GenerateGUID(false)
		plugin:SetSetting("placeGuid", guid)
	end
	return guid
end

Bridge.Init(script.Tools, { GetPlaceGuid = getPlaceGuid })

if not RunService:IsEdit() then
	-- A playtest DataModel. It needs the edit session's id to attach to, which the edit session
	-- writes to plugin settings as it connects -- nothing inside a running DataModel can work out
	-- which Studio window spawned it.
	local linkId = plugin:GetSetting("linkId")
	local token = plugin:GetSetting("token")
	if linkId and token and token ~= "" then
		Bridge.Connect(plugin:GetSetting("port") or DEFAULT_PORT, token, {
			role = if RunService:IsServer() then "server" else "client",
			linkId = linkId,
			-- Play Solo is one DataModel wearing both hats, so it answers as client 1 as well.
			alsoClient = RunService:IsServer() and RunService:IsClient(),
		})
	end
	return
end

local Panel = require(script.Panel)

local toolbar = plugin:CreateToolbar("VMCP")
local button = toolbar:CreateButton("Panel", "Open the VMCP bridge panel", "rbxassetid://5325741572")

local widget = plugin:CreateDockWidgetPluginGuiAsync(
	"MCP_Panel",
	DockWidgetPluginGuiInfo.new(Enum.InitialDockState.Float, false, false, 400, 400, 200, 200)
)
widget.Title = "VMCP"

local port = plugin:GetSetting("port") or DEFAULT_PORT
local token = plugin:GetSetting("token")

-- Mounted once, up front. The panel's setters all reach into widgets Mount creates, so touching
-- any of them beforehand is a nil index -- and remounting per click would stack whole trees.
Panel.Mount(widget)
Panel.PortInput.Text = port
Panel.TokenInput.Text = token or ""

Bridge.OnStatus(function(signal: string, word: string, line: string)
	Panel.SetSignal(signal)
	Panel.SetStatusWord(word)
	Panel.SetStatusLine(line)

	local live = signal == "Live" or signal == "Work"
	Panel.SetConnectEnabled(not live)
	Panel.SetDisconnectEnabled(live)
end)

local function connect()
	if not token or token == "" then
		Panel.SetSignal("Fault")
		Panel.SetStatusWord("no token")
		Panel.SetStatusLine("Paste the auth token from `npm run token` first.")
		Panel.SetTokenOpen(true)
		return
	end
	-- Left where a playtest DataModel can find it. Two Studio windows share plugin settings, so
	-- the last one to connect owns the playtests; one test per Studio instance anyway.
	plugin:SetSetting("linkId", Bridge.Connection().sessionId)
	Bridge.Connect(port, token)
end

Panel.PortChanged:Connect(function(new: string)
	port = if new ~= "" then new else DEFAULT_PORT
	plugin:SetSetting("port", port)
end)

Panel.TokenChanged:Connect(function(new: string)
	token = new
	plugin:SetSetting("token", new)
end)

Panel.ConnectRequested:Connect(connect)
Panel.DisconnectRequested:Connect(Bridge.Disconnect)

button.Click:Connect(function()
	widget.Enabled = not widget.Enabled
end)

plugin.Unloading:Connect(Bridge.Disconnect)

if token and token ~= "" then
	connect()
end
]]></string>
    </Properties>
    <Item class="ModuleScript" referent="1">
      <Properties>
        <string name="Name">Bridge</string>
        <string name="Source"><![CDATA[--!strict
--!optimize 2

-- The socket. Opens one WebStreamClient, handshakes, keeps it alive, and hands tool/call
-- messages to Dispatch.
--
-- Bridge.Init(toolFolder, settings)   settings: { GetPlaceGuid: () -> string }
-- Bridge.Connect(port, token, as)     as: { role, linkId, alsoClient } -- the edit session omits it
-- Bridge.Disconnect()                 deliberate; stops retrying
-- Bridge.OnStatus(fn)                 fn(signal, word, line) -- drives the Panel
-- Bridge.Invoke(name, arguments)      call another tool, in any context, through the server
-- Bridge.Ctx*                         the timeline's shared context, which the server holds
--
-- One Studio window runs several of these. The plugin loads into the edit DataModel and, while a
-- playtest is on, into the test server and every test client as well -- same code, different role
-- in the handshake. That is how a call for a live context reaches a real running game.
--
-- The reconnect rule is not the one in docs/protocol.md. That table says to skip retrying on
-- close codes 1008 and 4000, but WebStreamClient's Closed event carries no arguments at all, so
-- the plugin never sees a code. What it can see is whether the handshake ever succeeded: 1008
-- (bad token, bad version, non-JSON) always closes before the hello reply, so a close that
-- happened after the socket opened but before the reply is a configuration problem and retrying
-- it forever is pointless noise. A close with no Opened behind it is just a server that isn't
-- listening yet, which is exactly what a restart looks like, so that one keeps retrying.

local HttpService = game:GetService("HttpService")

local Dispatch = require(script.Dispatch)
local Registry = require(script.Registry)

local PROTOCOL_VERSION = 3
local BACKOFF_START = 1
local BACKOFF_MAX = 30
-- A supersede (close 4000) also lands after a good handshake, so two Studio windows sharing a
-- sessionId would retry each other forever. Dropping out after a few near-instant closes ends
-- that without needing the close code we can't read.
local FLAP_WINDOW = 10
local FLAP_LIMIT = 4

local Bridge = {}

local state = {
	socket = nil :: any,
	sessionId = HttpService:GenerateGUID(false),
	port = nil :: string?,
	token = nil :: string?,
	-- The reconnect decision hangs off this pair: opened means the socket reached the server at
	-- all, handshakeOk means the server accepted the session.
	opened = false,
	handshakeOk = false,
	helloId = 0,
	nextId = 1,
	wantConnected = false,
	backoff = BACKOFF_START,
	connectedAt = 0,
	flaps = 0,
	role = "plugin",
	linkId = nil :: string?,
	alsoClient = false,
	-- Assigned by the server: 0 for a test server, 1+ for each test client.
	peerIndex = nil :: number?,
	toolFolder = nil :: Instance?,
	getPlaceGuid = nil :: (() -> string)?,
	onStatus = nil :: ((signal: string, word: string, line: string) -> ())?,
}

-- Replies we're still waiting on, keyed by the id we sent. Only Bridge.Request puts anything in
-- here; tool/call goes the other direction.
local pending: { [number]: (ok: boolean, payload: any) -> () } = {}

local function report(signal: string, word: string, line: string)
	if state.onStatus then
		state.onStatus(signal, word, line)
	end
end

-- Encoding is the only way this fails, and a silent failure means Claude waits out the whole
-- timeout for a reply that never comes, so the reason goes back to the caller.
local function send(message: { [string]: any }): (boolean, string?)
	local socket = state.socket
	if not socket then
		return false, "socket is closed"
	end

	local ok, encoded = pcall(HttpService.JSONEncode, HttpService, message)
	if not ok then
		return false, tostring(encoded)
	end

	socket:Send(encoded)
	return true, nil
end

-- An unsaved place has a PlaceId of 0, which the server refuses, so those fall back to a GUID
-- stored in plugin settings -- stable across sessions the way a real PlaceId would be.
local function placeIdentity(): (string, string)
	local id = game.PlaceId
	if id ~= 0 then
		return tostring(id), if game.Name ~= "" then game.Name else "Unsaved Place"
	end
	local getGuid = state.getPlaceGuid
	return (if getGuid then getGuid() else "0"), "Unsaved Place"
end

local function closeSocket()
	local socket = state.socket
	if not socket then
		return
	end
	state.socket = nil
	-- Six live stream clients per session, so the old one goes before a new one opens.
	pcall(function()
		socket:Close()
	end)
end

local scheduleRetry: () -> ()

local function openSocket()
	closeSocket()
	state.opened = false
	state.handshakeOk = false

	local port = state.port
	local token = state.token
	if not port or not token then
		report("Fault", "no token", "Set a port and paste the auth token first.")
		return
	end

	report("Work", "connecting", `Connecting to ws://127.0.0.1:{port}`)

	-- No Origin header: the server refuses any connection carrying one, because a webpage can
	-- reach localhost and a plugin never sends it.
	local ok, socket = pcall(function()
		return HttpService:CreateWebStreamClient(Enum.WebStreamClientType.WebSocket, {
			Url = `ws://127.0.0.1:{port}`,
		})
	end)
	if not ok then
		report("Fault", "failed", `Could not open a socket: {socket}`)
		return
	end

	state.socket = socket
	state.connectedAt = os.clock()

	-- Every handler below ignores a socket that is no longer the current one. Replacing a socket
	-- fires Closed on the old one, and without this that stale event would schedule a retry
	-- alongside the connection that just replaced it.
	socket.Opened:Connect(function()
		if socket ~= state.socket then
			return
		end
		state.opened = true

		local folder = state.toolFolder
		if not folder then
			report("Fault", "not set up", "Bridge.Init was never called with a tool folder.")
			return
		end
		Registry.Collect(folder)
		local placeId, placeName = placeIdentity()

		state.helloId = state.nextId
		state.nextId += 1
		send({
			jsonrpc = "2.0",
			id = state.helloId,
			method = "session/hello",
			params = {
				token = token,
				protocolVersion = PROTOCOL_VERSION,
				sessionId = state.sessionId,
				placeId = placeId,
				placeName = placeName,
				tools = Registry.definitions,
				role = state.role,
				linkId = state.linkId,
				alsoClient = state.alsoClient,
			},
		})
	end)

	socket.MessageReceived:Connect(function(raw: string)
		if socket ~= state.socket then
			return
		end

		local decoded, message = pcall(HttpService.JSONDecode, HttpService, raw)
		if not decoded then
			warn(`[VMCP] server sent something that wasn't JSON: {message}`)
			return
		end

		local waiter = if message.method == nil then pending[message.id] else nil
		if waiter then
			if message.error then
				waiter(false, message.error.message)
			else
				waiter(true, message.result)
			end
			return
		end

		if message.id == state.helloId and not state.handshakeOk then
			if message.error then
				-- Wrong token or wrong protocol version. Retrying can't fix either.
				report("Fault", "refused", message.error.message)
				state.wantConnected = false
				closeSocket()
				return
			end
			state.handshakeOk = true
			state.backoff = BACKOFF_START
			state.flaps = 0
			state.peerIndex = if message.result then message.result.peerIndex else nil
			local count = #Registry.definitions
			report("Live", "connected", `{count} tool{if count == 1 then "" else "s"} registered.`)
			return
		end

		Dispatch.Handle(send, message)
	end)

	socket.Error:Connect(function(status: number, reason: string)
		if socket ~= state.socket then
			return
		end
		warn(`[VMCP] socket error {status}: {reason}`)
	end)

	socket.Closed:Connect(function()
		-- No close code here -- see the note at the top of the file.
		if socket ~= state.socket then
			return
		end

		local wasOpen, wasLive = state.opened, state.handshakeOk
		state.socket = nil
		for _, waiting in pending do
			waiting(false, "the connection to the VMCP server dropped")
		end
		state.opened = false
		state.handshakeOk = false

		if not state.wantConnected then
			report("Idle", "not connected", "Disconnected.")
			return
		end
		-- Never opened: nothing was listening. Common and temporary -- Node restarts constantly
		-- during development -- so back off and keep trying.
		if not wasOpen then
			scheduleRetry()
			return
		end
		if not wasLive then
			report("Fault", "refused", "Server closed before the handshake. Check the port and token.")
			state.wantConnected = false
			return
		end

		if os.clock() - state.connectedAt < FLAP_WINDOW then
			state.flaps += 1
		else
			state.flaps = 0
		end
		if state.flaps >= FLAP_LIMIT then
			report("Fault", "superseded", "Kept getting dropped -- another Studio window may hold this session.")
			state.wantConnected = false
			return
		end

		scheduleRetry()
	end)
end

function scheduleRetry()
	local delay = state.backoff
	state.backoff = math.min(delay * 2, BACKOFF_MAX)
	report("Work", "reconnecting", `Lost the server. Retrying in {delay}s.`)

	task.delay(delay, function()
		if state.wantConnected and not state.socket then
			openSocket()
		end
	end)
end

-- Asks the server a question and waits for the answer. The server can reach the filesystem and
-- the plugin can't, which is the only reason this direction exists.
--
-- Yields, so it can only be called from a tool's own thread -- Dispatch spawns one per call, so
-- blocking here holds up that call and nothing else on the socket.
function Bridge.Request(method: string, params: { [string]: any }, timeout: number?): (boolean, any)
	if not state.handshakeOk then
		return false, "not connected to the VMCP server"
	end

	local id = state.nextId
	state.nextId += 1
	local thread = coroutine.running()

	pending[id] = function(ok: boolean, payload: any)
		pending[id] = nil
		task.spawn(thread, ok, payload)
	end

	local sent, failure = send({ jsonrpc = "2.0", id = id, method = method, params = params })
	if not sent then
		pending[id] = nil
		return false, failure :: any
	end

	task.delay(timeout or 15, function()
		local waiting = pending[id]
		if waiting then
			waiting(false, `the server didn't answer {method} in time`)
		end
	end)

	return coroutine.yield()
end

function Bridge.Init(toolFolder: Instance, settings: { GetPlaceGuid: () -> string })
	state.toolFolder = toolFolder
	state.getPlaceGuid = settings.GetPlaceGuid
end

function Bridge.OnStatus(fn: (signal: string, word: string, line: string) -> ())
	state.onStatus = fn
end

-- `as` is how a playtest DataModel says which one it is. The edit session leaves it out.
function Bridge.Connect(port: string, token: string, as: { role: string, linkId: string, alsoClient: boolean? }?)
	state.port = port
	state.token = token
	if as then
		state.role = as.role
		state.linkId = as.linkId
		state.alsoClient = as.alsoClient == true
	end
	state.wantConnected = true
	state.backoff = BACKOFF_START
	state.flaps = 0
	openSocket()
end

function Bridge.Disconnect()
	state.wantConnected = false
	closeSocket()
	report("Idle", "not connected", "Disconnected.")
end

function Bridge.Connection(): { port: string?, token: string?, sessionId: string, role: string, peerIndex: number? }
	return {
		port = state.port,
		token = state.token,
		sessionId = state.sessionId,
		role = state.role,
		peerIndex = state.peerIndex,
	}
end

-- Calls another tool, in whatever context `arguments.context` names, through the server. This is
-- what lets a timeline event in a test client ask the edit session for a tree dump, or push work
-- onto the server and read the answer in the same snippet.
function Bridge.Invoke(name: string, arguments: { [string]: any }?, timeout: number?): (boolean, any)
	local ok, payload = Bridge.Request("tool/invoke", {
		name = name,
		arguments = arguments or {},
		depth = Dispatch.CurrentDepth(),
	}, timeout)
	if not ok then
		return false, payload
	end
	return true, payload.result
end

-- The timeline's shared context. It lives on the server because the edit DataModel, the test
-- server and each test client are separate processes -- this socket is the only thing they share.
-- Asks the VMCP server to finish something this side can't: writing a Canvas recording out as a
-- PNG. A tool result can carry the same directive back, but a timeline event isn't a tool result.
function Bridge.Post(directive: { [string]: any }): (boolean, string)
	local ok, payload = Bridge.Request("post/process", directive, 30)
	if not ok then
		return false, tostring(payload)
	end
	return true, tostring(if type(payload) == "table" then payload.outcome else payload)
end

function Bridge.CtxSet(key: string, value: any, from: string): boolean
	-- No timestamp: every write blocks until the server has it, so arrival order is write order
	-- and the server is the only clock all three DataModels agree on.
	return (Bridge.Request("ctx/set", { key = key, value = value, from = from }, 5))
end

function Bridge.CtxGet(key: string): any
	local ok, payload = Bridge.Request("ctx/get", { key = key }, 5)
	return if ok then payload.value else nil
end

function Bridge.CtxNote(text: string): boolean
	return (Bridge.Request("ctx/note", { text = text }, 5))
end

function Bridge.CtxClear(): boolean
	return (Bridge.Request("ctx/clear", {}, 5))
end

function Bridge.CtxSnapshot(): any
	local ok, payload = Bridge.Request("ctx/snapshot", {}, 10)
	return if ok then payload else nil
end

function Bridge.IsConnected(): boolean
	return state.handshakeOk
end

return Bridge
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">Dispatch</string>
          <string name="Source"><![CDATA[--!strict
--!optimize 2

-- Routes one decoded message from the server. Everything here is guarded: an error thrown out
-- of the socket's MessageReceived callback kills the callback, not the socket, and the server
-- then sits waiting until the call times out. A crash has to become an isError reply instead.

local Registry = require(script.Parent.Registry)

local Dispatch = {}

-- Returns false plus the reason when the message could not be encoded, which is the only way
-- sending fails and would otherwise be silent.
type Send = (message: { [string]: any }) -> (boolean, string?)

local function textResult(text: string, isError: boolean?): { [string]: any }
	local result: { [string]: any } = { content = { { type = "text", text = text } } }
	if isError then
		result.isError = true
	end
	return result
end

-- How deep the tool on this thread already is. A tool calling another tool passes the count on so
-- the server can tell a chain from a loop. Weak keys so a finished call isn't held alive.
local depthByThread: { [thread]: number } = setmetatable({}, { __mode = "k" }) :: any

function Dispatch.CurrentDepth(): number
	return depthByThread[coroutine.running()] or 0
end

local function runTool(send: Send, id: any, name: string, arguments: any)
	depthByThread[coroutine.running()] = if type(arguments) == "table" and type(arguments.__depth) == "number"
		then arguments.__depth
		else 0

	local tool = Registry.byName[name]
	if not tool then
		send({ jsonrpc = "2.0", id = id, result = textResult(`no tool named "{name}"`, true) })
		return
	end

	local ok, returned = pcall(tool.Run, arguments or {})
	if not ok then
		send({ jsonrpc = "2.0", id = id, result = textResult(`{name} errored: {returned}`, true) })
		return
	end

	-- A non-table result rides the server's documented shorthand; a table goes through untouched
	-- and the server coerces it. Encoding can still fail -- a tool returning an Instance, say --
	-- and Claude would otherwise just see the call time out.
	local result = if type(returned) == "table" then returned else textResult(tostring(returned or "done"))
	local encoded, failure = send({ jsonrpc = "2.0", id = id, result = result })
	if not encoded then
		send({ jsonrpc = "2.0", id = id, result = textResult(`{name} returned something unencodable: {failure}`, true) })
	end
end

function Dispatch.Handle(send: Send, message: { [string]: any })
	if message.method == "tool/call" then
		local params = message.params or {}
		-- Spawned: a yielding tool would otherwise block every later message on this socket.
		task.spawn(runTool, send, message.id, params.name, params.arguments)
		return
	end

	if message.error then
		warn(`[VMCP] server refused request {message.id}: {message.error.message}`)
	end
end

return Dispatch
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Registry</string>
          <string name="Source"><![CDATA[--!strict
--!optimize 2

-- Collects the tool modules and turns them into the `tools` array for session/hello.
--
-- The server validates definitions too, but it rejects the *whole* list when one entry is
-- malformed, and its error arrives as a closed socket. Checking here instead means a bad tool
-- names itself in the Output window and the other tools still register.

export type Definition = {
	name: string,
	description: string,
	inputSchema: { [string]: any },
	outputSchema: { [string]: any }?,
	tags: { [string]: any }?,
	timeoutMs: number?,
}

export type Tool = {
	Definition: Definition,
	Run: (arguments: any) -> any,
}

local Registry = {
	definitions = {} :: { Definition },
	byName = {} :: { [string]: Tool },
}

-- Mirrors the server's NAME_PATTERN; anything else is refused at registration.
local function validate(definition: any): string?
	if type(definition) ~= "table" then
		return "Definition must be a table"
	end
	local name = definition.name
	if type(name) ~= "string" or #name > 64 or not string.match(name, "^[%w_%-]+$") then
		return "name must be 1-64 chars of letters, digits, underscore or hyphen"
	end
	if type(definition.description) ~= "string" or definition.description == "" then
		return "description must be a non-empty string"
	end

	local input = definition.inputSchema
	if type(input) ~= "table" then
		return "inputSchema must be a table"
	end
	-- An empty table encodes as [] and the server turns that back into { type = "object" }.
	if next(input) ~= nil and input.type ~= "object" then
		return `inputSchema needs type = "object" at its root (MCP requires it)`
	end
	if definition.timeoutMs ~= nil and (type(definition.timeoutMs) ~= "number" or definition.timeoutMs <= 0) then
		return "timeoutMs must be a positive number"
	end
	return nil
end

-- Requires every ModuleScript in `folder` and keeps the ones that look like tools.
function Registry.Collect(folder: Instance)
	table.clear(Registry.definitions)
	table.clear(Registry.byName)

	for _, child in folder:GetChildren() do
		if not child:IsA("ModuleScript") then
			continue
		end

		local ok, tool = pcall(require, child)
		if not ok then
			warn(`[VMCP] tool "{child.Name}" failed to load: {tool}`)
			continue
		end
		if type(tool) ~= "table" or type(tool.Run) ~= "function" then
			warn(`[VMCP] tool "{child.Name}" has no Run function`)
			continue
		end

		local problem = validate(tool.Definition)
		if problem then
			warn(`[VMCP] tool "{child.Name}" rejected: {problem}`)
			continue
		end

		local name = tool.Definition.name
		if Registry.byName[name] then
			warn(`[VMCP] duplicate tool name "{name}" in "{child.Name}"`)
			continue
		end

		Registry.byName[name] = tool
		table.insert(Registry.definitions, tool.Definition)
	end
end

return Registry
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="ModuleScript" referent="4">
      <Properties>
        <string name="Name">Env</string>
        <string name="Source"><![CDATA[--!strict

-- What a snippet sees as `vmcp`. Built once and handed to every snippet and every timeline event,
-- so they all have the same vocabulary whichever DataModel they happen to be running in.

local Bridge = require(script.Parent.Bridge)

local Env = {
	Anim = require(script.Parent.Lib.Anim),
	Audit = require(script.Parent.Lib.Audit),
	Bench = require(script.Parent.Lib.Bench),
	Build = require(script.Parent.Lib.Build),
	Canvas = require(script.Parent.Lib.Canvas),
	Equiv = require(script.Parent.Lib.Equiv),
	Exploit = require(script.Parent.Lib.Exploit),
	Instrument = require(script.Parent.Lib.Instrument),
	Lint = require(script.Parent.Lib.Lint),
	Load = require(script.Parent.Lib.Load),
	Profile = require(script.Parent.Lib.Profile),
	Remotes = require(script.Parent.Lib.Remotes),
	Rig = require(script.Parent.Lib.Rig),
	Style = require(script.Parent.Lib.Style),
	Serialize = require(script.Parent.Exec.Serialize),
	-- Eval and Require, against the running game's own script VM rather than the plugin's.
	Game = require(script.Parent.Exec.GameVm),
}

-- Calls another VMCP tool and gives back its text. `arguments.context` picks the DataModel, so a
-- client event can ask the server a question, or ask the edit session for a tree dump, without
-- the payload having to be split into three separate calls first.
--
-- Returns ok plus the text; a tool that reported an error comes back as false with its own words.
-- Writes a Canvas out as a PNG on the VMCP server, which is the only side with a filesystem.
-- Works from any context and from inside a timeline event, where returning a directive isn't an
-- option. `name` becomes the file name; leave it out and it gets a timestamped one.
-- `options.upload` publishes it as an Image asset too, and the reply carries the rbxassetid so
-- scripts can use the picture without EditableImage at runtime. `options.groupId` makes a group
-- the owner instead of the Studio user. The upload_image tool does the same for a finished PNG.
function Env.Render(canvas: any, name: string?, options: { upload: boolean?, groupId: number? }?): (boolean, string)
	local serverUpload = false
	if options and options.upload then
		if type(canvas) ~= "table" or not canvas.Upload then
			return false, "upload needs a Canvas, not a recording"
		end
		-- Studio's own upload when it's enabled and the user owns it; otherwise the server does
		-- it over Open Cloud.
		serverUpload = options.groupId ~= nil or canvas:Upload(name or "vmcp-canvas") == nil
	end
	local recording = if type(canvas) == "table" and canvas.Recording then canvas:Recording() else canvas
	if type(recording) ~= "table" then
		return false, "Render wants a Canvas, or the table its Recording() gave you"
	end
	recording.name = name
	if serverUpload then
		recording.upload = true
		recording.groupId = options and options.groupId
		local ok, userId = pcall(function()
			return game:GetService("StudioService"):GetUserId()
		end)
		recording.userId = if ok then userId else nil
	end
	return Bridge.Post(recording)
end

function Env.Tool(name: string, arguments: { [string]: any }?): (boolean, string)
	local reached, result = Bridge.Invoke(name, arguments, 120)
	if not reached then
		return false, tostring(result)
	end

	local parts = {}
	for _, item in result.content or {} do
		if type(item.text) == "string" then
			table.insert(parts, item.text)
		end
	end
	return result.isError ~= true, table.concat(parts, "\n")
end

return Env
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="5">
      <Properties>
        <string name="Name">Exec</string>
      </Properties>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">GameVm</string>
          <string name="Source"><![CDATA[--!strict

-- Runs code inside the running game's own script VM, rather than the plugin's.
--
-- The plugin can already create a ModuleScript and require it anywhere it's loaded (see
-- Inject.luau). What it can't do that way is share the require cache: `require(SomeModule)` from
-- the plugin builds a *fresh* copy of that module, so whatever state the running game accumulated
-- in it is invisible. That makes the plugin VM useless for the thing you most want during a
-- playtest -- looking at what a module actually holds right now.
--
-- The fix is a short-lived Script living in the game, exposing a BindableFunction. The plugin
-- hands it a ModuleScript and the `require` happens on the game's side of the fence, against the
-- game's cache. Only strings come back: a BindableFunction copies tables and chokes on functions,
-- and a module table is usually full of functions, so it's rendered to text before it crosses.
--
-- Everything here is created at runtime inside a playtest DataModel, so it disappears when the
-- playtest stops. Nothing touches the saved place.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

local Inject = require(script.Parent.Inject)
local Serialize = require(script.Parent.Serialize)

local BRIDGE_NAME = "__VMCP_GameBridge"
local INVOKE_NAME = "__VMCP_GameInvoke"
local SERIALIZE_NAME = "__VMCP_Serialize"
-- Also copied in: an equivalence checker that game-VM snippets can require to compare two live
-- functions. See Lib/Equiv.
local EQUIV_NAME = "__VMCP_Equiv"
local READY_TIMEOUT = 5

local GameVm = {}

local BRIDGE_SOURCE = string.format(
	[[
local here = script.Parent
local Serialize = require(here:WaitForChild("%s"))

local previous = here:FindFirstChild("%s")
if previous then
	previous:Destroy()
end

local bindable = Instance.new("BindableFunction")
bindable.Name = "%s"
bindable.Archivable = false
bindable.Parent = here

bindable.OnInvoke = function(payload)
	if typeof(payload) ~= "Instance" or not payload:IsA("ModuleScript") then
		return { ok = false, text = "payload must be a ModuleScript" }
	end
	local ok, value = pcall(require, payload)
	return { ok = ok, text = if ok then Serialize.Render(value) else tostring(value) }
end
]],
	SERIALIZE_NAME,
	INVOKE_NAME,
	INVOKE_NAME
)

-- Server code goes in ServerScriptService; client code goes in this player's PlayerScripts, which
-- is the only container on a client where a LocalScript created at runtime will actually run.
local function container(): (Instance?, string?)
	if RunService:IsServer() then
		return ServerScriptService, nil
	end
	local player = Players.LocalPlayer
	if not player then
		return nil, "no LocalPlayer, so this isn't a client DataModel"
	end
	local scripts = player:FindFirstChild("PlayerScripts")
	return scripts, if scripts then nil else "this client has no PlayerScripts yet"
end

local function ensure(): (BindableFunction?, string?)
	if RunService:IsEdit() then
		return nil,
			"there's no game VM in edit mode -- this needs a playtest. Start one with the playtest "
				.. "tool, or use the plugin context, which runs in Studio itself."
	end

	local parent, problem = container()
	if not parent then
		return nil, problem
	end

	local existing = parent:FindFirstChild(INVOKE_NAME)
	if existing and existing:IsA("BindableFunction") then
		return existing, nil
	end

	local ok, failure = pcall(function()
		local previous = parent:FindFirstChild(BRIDGE_NAME)
		if previous then
			previous:Destroy()
		end

		local serializer = Instance.new("ModuleScript")
		serializer.Name = SERIALIZE_NAME
		serializer.Source = (script.Parent.Serialize :: ModuleScript).Source
		serializer.Archivable = false
		serializer.Parent = parent

		local equiv = Instance.new("ModuleScript")
		equiv.Name = EQUIV_NAME
		equiv.Source = (script.Parent.Parent.Lib.Equiv :: ModuleScript).Source
		equiv.Archivable = false
		equiv.Parent = parent

		local bridge: any = Instance.new(if RunService:IsServer() then "Script" else "LocalScript")
		bridge.Name = BRIDGE_NAME
		bridge.Source = BRIDGE_SOURCE
		bridge.Archivable = false
		bridge.Parent = parent
	end)
	if not ok then
		return nil, `couldn't install the game bridge: {failure}`
	end

	-- The bridge is an ordinary game script, so it starts on its own schedule, not ours.
	local deadline = os.clock() + READY_TIMEOUT
	repeat
		local bindable = parent:FindFirstChild(INVOKE_NAME)
		if bindable and bindable:IsA("BindableFunction") then
			return bindable, nil
		end
		task.wait()
	until os.clock() >= deadline

	return nil, "the game bridge script never started -- is the playtest actually running?"
end

-- Returns ok plus the rendered result. The snippet runs as a function body, so `return` works.
function GameVm.Run(source: string): (boolean, string)
	local bindable, problem = ensure()
	if not bindable then
		return false, problem :: string
	end

	local module, refusal = Inject.Module(`return (function() {source}\nend)()`)
	if not module then
		return false, refusal :: string
	end

	local ok, reply = pcall(function()
		return bindable:Invoke(module)
	end)
	pcall(function()
		module:Destroy()
	end)

	if not ok then
		return false, `the game bridge refused the call: {reply}`
	end
	if type(reply) ~= "table" then
		return false, "the game bridge answered with something unreadable"
	end
	return reply.ok == true, tostring(reply.text)
end

-- The reason this module exists: requires the module the *game* holds, with whatever state it has
-- built up by now, and renders it. `path` is a dotted DataModel path.
function GameVm.Require(path: string): (boolean, string)
	if type(path) ~= "string" or path == "" then
		return false, 'Require takes a dotted path, like "ReplicatedStorage.Modules.Combat"'
	end

	-- Resolved on the game's side rather than here, so a path pointing at something only the
	-- server can see still works.
	return GameVm.Run(table.concat({
		`local path = {string.format("%q", path)}`,
		"local current = game",
		'for segment in string.gmatch(path, "[^%.]+") do',
		"	local found = current:FindFirstChild(segment)",
		"	if not found and current == game then",
		"		found = (pcall(game.GetService, game, segment)) and game:GetService(segment) or nil",
		"	end",
		'	if not found then error("nothing at " .. path) end',
		"	current = found",
		"end",
		"return require(current)",
	}, "\n"))
end

-- Where a game-VM snippet finds the equivalence checker: `require(vmcp.Game.EquivPath())` isn't
-- possible across VMs, so it's a path string to splice into the snippet.
function GameVm.EquivPath(): string
	local parent = container()
	return if parent then `{parent:GetFullName()}.{EQUIV_NAME}` else EQUIV_NAME
end

-- Serialize is handed to snippets alongside this, so a caller that wants the plugin-side renderer
-- rather than the game-side one has it.
GameVm.Serialize = Serialize

return GameVm
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Inject</string>
          <string name="Source"><![CDATA[--!strict
--!optimize 2

-- Compiles and runs a chunk of Luau in the plugin's own context.
--
-- `loadstring` isn't involved and doesn't need to be: a plugin has PluginSecurity in whatever
-- DataModel it's loaded into, so it can write a ModuleScript's Source and require it. That works
-- in the edit DataModel and in a playtest alike, with LoadStringEnabled off.
--
-- Fresh every call is the whole trick: `require` caches by instance, so reusing one would hand
-- back the first run's result forever no matter what the source says now.
--
-- The scratch folder lives in CoreGui, not the place. CoreGui isn't saved, so a crash mid-run
-- leaves nothing behind to commit and nothing for Rojo to fight with.

local CoreGui = game:GetService("CoreGui")

local FOLDER_NAME = "VMCP_Exec"
local DEFAULT_TIMEOUT = 10

local Inject = {}

local scratch: Folder? = nil
local counter = 0

local function folder(): Folder
	local existing = scratch
	if existing and existing.Parent then
		return existing
	end

	-- First call of the session also sweeps: anything already here is an orphan from a plugin
	-- reload or a Studio crash, and nothing in it was worth keeping.
	local stale = CoreGui:FindFirstChild(FOLDER_NAME)
	if stale then
		stale:Destroy()
	end

	local created = Instance.new("Folder")
	created.Name = FOLDER_NAME
	created.Parent = CoreGui
	scratch = created
	return created
end

local INJECTION_DENIED = "Studio won't let VMCP create scripts, so run_luau can't work. Open the "
	.. "Plugins ribbon, click Plugin Management, and allow script injection for VMCP."

-- Returns a ModuleScript holding `source`, parented into the scratch folder.
function Inject.Module(source: string): (ModuleScript?, string?)
	counter += 1
	local ok, created = pcall(function()
		local module = Instance.new("ModuleScript")
		module.Name = `chunk{counter}`
		module.Source = source
		return module
	end)
	if not ok then
		return nil, `{INJECTION_DENIED} ({created})`
	end

	local module = created :: ModuleScript
	module.Parent = folder()
	return module, nil
end

-- Wrapping in a function is what lets a snippet with no `return` work at all -- a ModuleScript
-- body that returns nothing is a hard require error. The wrapper stays on line 1 so a syntax
-- error still reports the snippet's own line numbers.
local function wrap(source: string, parameters: string): string
	return `return function({parameters}) {source}\nend`
end

-- Compiles without running past the top level, and hands back the callable. Separating this from
-- running is what lets a timeline check its whole payload before the playtest starts, and compile
-- each event once instead of once per firing.
function Inject.Compile(source: string, parameters: string?): (((...any) -> ...any)?, string?)
	local module, refusal = Inject.Module(wrap(source, parameters or "vmcp"))
	if not module then
		return nil, refusal
	end

	local ok, chunk = pcall(require, module)
	pcall(function()
		module:Destroy()
	end)
	if not ok then
		return nil, tostring(chunk)
	end
	return chunk :: any, nil
end

-- Returns ok plus either the snippet's return value or the failure text. `env` is handed to the
-- snippet as its `vmcp` argument.
function Inject.Run(source: string, env: { [string]: any }?, timeout: number?): (boolean, any)
	local chunk, refusal = Inject.Compile(source)
	if not chunk then
		return false, refusal
	end

	local ok, produced = false, nil :: any
	local done = false
	local thread = task.spawn(function()
		ok, produced = pcall(chunk, env or {})
		done = true
	end)

	-- A snippet that yields forever would otherwise wedge the plugin until Studio restarts. A
	-- tight loop with no yield still hangs everything, and nothing in Luau can preempt that.
	local limit = timeout or DEFAULT_TIMEOUT
	local deadline = os.clock() + limit
	while not done and os.clock() < deadline do
		task.wait()
	end
	if not done then
		pcall(task.cancel, thread)
		return false, `the snippet was still running after {limit}s and was cancelled`
	end

	return ok, produced
end

return Inject
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Portable</string>
          <string name="Source"><![CDATA[--!strict

-- Turns arbitrary Luau values into something that survives a trip through JSON, and back again.
--
-- This exists because the interesting values in VMCP are captured in one DataModel and used in
-- another: the server sees what a client really sent to a remote, and the client is where you
-- replay it. Serialize.Render is for reading; this is for round-tripping.
--
-- Instances cross as their path and are resolved again on the far side, so a captured argument
-- naming the local player's character comes back as *that* DataModel's copy of it.

local Path = require(script.Parent.Parent.Path)

local Portable = {}

local MAX_DEPTH = 4
local MAX_ELEMENTS = 40
local MAX_STRING = 2000

-- A hole in an array can't be expressed in JSON, and remote arguments are full of them.
local NIL = { __t = "nil" }

local function capture(value: any, depth: number): any
	local kind = typeof(value)
	if kind == "nil" then
		return NIL
	end
	if kind == "boolean" or kind == "number" then
		return value
	end
	if kind == "string" then
		return if #value > MAX_STRING then string.sub(value, 1, MAX_STRING) else value
	end
	if kind == "Instance" then
		return { __t = "Instance", path = value:GetFullName(), class = value.ClassName }
	end
	if kind == "Vector3" then
		return { __t = "Vector3", x = value.X, y = value.Y, z = value.Z }
	end
	if kind == "Vector2" then
		return { __t = "Vector2", x = value.X, y = value.Y }
	end
	if kind == "CFrame" then
		return { __t = "CFrame", components = { value:GetComponents() } }
	end
	if kind == "Color3" then
		return { __t = "Color3", r = value.R, g = value.G, b = value.B }
	end
	if kind == "UDim2" then
		return { __t = "UDim2", xs = value.X.Scale, xo = value.X.Offset, ys = value.Y.Scale, yo = value.Y.Offset }
	end
	if kind == "EnumItem" then
		return { __t = "EnumItem", enum = tostring(value.EnumType), name = value.Name }
	end
	if kind ~= "table" then
		return { __t = "opaque", kind = kind, text = tostring(value) }
	end

	if depth >= MAX_DEPTH then
		return { __t = "opaque", kind = "table", text = "too deep" }
	end

	local out: { [any]: any } = {}
	local count = 0
	for key, item in value do
		count += 1
		if count > MAX_ELEMENTS then
			break
		end
		local name = if type(key) == "string" or type(key) == "number" then key else tostring(key)
		out[name] = capture(item, depth + 1)
	end
	return out
end

local RESTORERS: { [string]: (any) -> any } = {
	["nil"] = function(): any
		return nil
	end,
	Instance = function(entry): any
		local found = Path.Resolve(entry.path)
		return found
	end,
	Vector3 = function(entry): any
		return Vector3.new(entry.x, entry.y, entry.z)
	end,
	Vector2 = function(entry): any
		return Vector2.new(entry.x, entry.y)
	end,
	CFrame = function(entry): any
		return CFrame.new(table.unpack(entry.components))
	end,
	Color3 = function(entry): any
		return Color3.new(entry.r, entry.g, entry.b)
	end,
	UDim2 = function(entry): any
		return UDim2.new(entry.xs, entry.xo, entry.ys, entry.yo)
	end,
	EnumItem = function(entry): any
		local enum = (Enum :: any)[entry.enum]
		return if enum then enum[entry.name] else nil
	end,
	opaque = function(): any
		return nil
	end,
}

local function restore(entry: any): any
	if type(entry) ~= "table" then
		return entry
	end

	local tag = entry.__t
	if type(tag) == "string" then
		local restorer = RESTORERS[tag]
		return if restorer then restorer(entry) else nil
	end

	local out: { [any]: any } = {}
	for key, item in entry do
		out[key] = restore(item)
	end
	return out
end

-- A packed argument list (table.pack, so `n` is the real length holes and all) in, a JSON-safe
-- array out. The length is kept separately for the same reason table.pack keeps it.
function Portable.CaptureArgs(packed: { any }): { any }
	local out = {}
	for index = 1, (packed :: any).n or #packed do
		out[index] = capture(packed[index], 0)
	end
	out.n = (packed :: any).n or #packed
	return out
end

function Portable.RestoreArgs(captured: { any }): ({ any }, number)
	local out = {}
	local count = (captured :: any).n or #captured
	for index = 1, count do
		out[index] = restore(captured[index])
	end
	return out, count
end

Portable.Capture = function(value: any): any
	return capture(value, 0)
end

Portable.Restore = restore

-- What an argument *is*, in one word, for a report. Reads off the captured form so it works on
-- arguments that came from another DataModel.
function Portable.Describe(entry: any): string
	if type(entry) ~= "table" then
		return typeof(entry)
	end
	local tag = entry.__t
	if type(tag) == "string" then
		if tag == "Instance" then
			return `{entry.class} {entry.path}`
		end
		return tag
	end
	return "table"
end

return Portable
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Serialize</string>
          <string name="Source"><![CDATA[--!strict
--!optimize 2

-- Renders an arbitrary Luau value as readable text, so a snippet can `return` anything and the
-- other end sees it instead of "table: 0x55f1c0". Roblox datatypes come back as the constructor
-- you would type to rebuild them; Instances as their class and full path.
--
-- The caps are the point as much as the formatting: `return workspace` should cost a few lines,
-- not the whole place over the socket.

local MAX_DEPTH = 5
local MAX_ELEMENTS = 60
local MAX_STRING = 400
local INDENT = "  "

local Serialize = {}

local function num(value: number): string
	if value % 1 == 0 and math.abs(value) < 1e15 then
		return string.format("%d", value)
	end
	return string.format("%.4g", value)
end

local function quote(text: string): string
	local clipped = text
	if #text > MAX_STRING then
		clipped = `{string.sub(text, 1, MAX_STRING)}... (+{#text - MAX_STRING} more)`
	end
	-- %q escapes a newline as backslash-newline, which is valid Luau but wraps the output.
	return (string.format("%q", clipped):gsub("\\n", "\n"))
end

local RENDERERS: { [string]: (any) -> string } = {
	Vector3 = function(v): string
		return `Vector3.new({num(v.X)}, {num(v.Y)}, {num(v.Z)})`
	end,
	Vector2 = function(v): string
		return `Vector2.new({num(v.X)}, {num(v.Y)})`
	end,
	Color3 = function(c): string
		return `Color3.new({num(c.R)}, {num(c.G)}, {num(c.B)})`
	end,
	UDim = function(u): string
		return `UDim.new({num(u.Scale)}, {num(u.Offset)})`
	end,
	UDim2 = function(u): string
		return `UDim2.new({num(u.X.Scale)}, {num(u.X.Offset)}, {num(u.Y.Scale)}, {num(u.Y.Offset)})`
	end,
	Rect = function(r): string
		return `Rect.new({num(r.Min.X)}, {num(r.Min.Y)}, {num(r.Max.X)}, {num(r.Max.Y)})`
	end,
	NumberRange = function(r): string
		return `NumberRange.new({num(r.Min)}, {num(r.Max)})`
	end,
	BrickColor = function(b): string
		return `BrickColor.new("{b.Name}")`
	end,
	CFrame = function(c): string
		local position = c.Position
		local rx, ry, rz = c:ToEulerAnglesXYZ()
		local origin = `CFrame.new({num(position.X)}, {num(position.Y)}, {num(position.Z)})`
		if rx == 0 and ry == 0 and rz == 0 then
			return origin
		end
		return `{origin} * CFrame.Angles({num(rx)}, {num(ry)}, {num(rz)})`
	end,
	Instance = function(instance): string
		return `<{instance.ClassName} {instance:GetFullName()}>`
	end,
	EnumItem = function(item): string
		return tostring(item)
	end,
	Enum = function(enum): string
		return `Enum.{tostring(enum)}`
	end,
	buffer = function(b): string
		return `<buffer, {buffer.len(b)} bytes>`
	end,
}

local function isIdentifier(key: any): boolean
	return type(key) == "string" and string.match(key, "^[%a_][%w_]*$") ~= nil
end

local function render(value: any, depth: number, open: { [any]: boolean }): string
	local kind = typeof(value)
	if kind == "string" then
		return quote(value)
	end
	if kind == "number" then
		return num(value)
	end
	if kind == "boolean" or kind == "nil" then
		return tostring(value)
	end
	if kind ~= "table" then
		local renderer = RENDERERS[kind]
		return if renderer then renderer(value) else `<{kind} {tostring(value)}>`
	end

	-- `open` holds the tables on the path to here, not every table already seen -- the same table
	-- twice in a list is fine to print twice, only a loop is a problem.
	if open[value] then
		return "<cycle>"
	end
	if depth >= MAX_DEPTH then
		return "<table, too deep>"
	end
	open[value] = true

	local lines = {}
	local pad = string.rep(INDENT, depth + 1)
	local arrayLength = #value
	local truncated = false

	for index = 1, arrayLength do
		if #lines >= MAX_ELEMENTS then
			truncated = true
			break
		end
		table.insert(lines, `{pad}{render(value[index], depth + 1, open)},`)
	end
	for key, item in value do
		if type(key) == "number" and key % 1 == 0 and key >= 1 and key <= arrayLength then
			continue
		end
		if #lines >= MAX_ELEMENTS then
			truncated = true
			break
		end
		local name = if isIdentifier(key) then key else `[{render(key, depth + 1, open)}]`
		table.insert(lines, `{pad}{name} = {render(item, depth + 1, open)},`)
	end
	open[value] = nil

	if #lines == 0 then
		return "{}"
	end
	if truncated then
		table.insert(lines, `{pad}-- more entries not shown`)
	end
	return "{\n" .. table.concat(lines, "\n") .. "\n" .. string.rep(INDENT, depth) .. "}"
end

function Serialize.Render(value: any): string
	return render(value, 0, {})
end

return Serialize
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="10">
      <Properties>
        <string name="Name">Lib</string>
      </Properties>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Anim</string>
          <string name="Source"><![CDATA[--!strict

-- Compiles per-joint tracks into the Keyframe/Pose trees the engine wants, and reads them back.
--
-- The authoring model is "the right arm does this over time". The engine's format is "at t=0.3,
-- here is every joint in the body". The first is how animation is thought about and the second is
-- what has to be written, so the whole job here is the translation between them: union every
-- track's timestamps, fill each keyframe's pose tree from the rig, and interpolate the joints
-- that have no key at that moment.
--
-- Easing is written on the key it leaves *from*, because Pose.EasingStyle describes how to reach
-- the next keyframe's value, not this one's.

local KeyframeSequenceProvider = game:GetService("KeyframeSequenceProvider")

local Rig = require(script.Parent.Rig)

local Anim = {}

export type Key = {
	time: number,
	-- Degrees, XYZ. Shorthand for the common case; `cframe` wins if both are given.
	angles: { number }?,
	cframe: (CFrame | { number })?,
	-- "Cubic/Out", "Quad/InOut", "Linear". Applies from this key toward the next.
	easing: string?,
	weight: number?,
}

export type Tracks = { [string]: { Key } }

export type Compiled = {
	id: string,
	length: number,
	joints: { string },
	keyframes: number,
}

local function cframeOf(key: Key): CFrame
	local cframe = key.cframe
	if typeof(cframe) == "CFrame" then
		return cframe
	end
	-- Over JSON a CFrame arrives as its 12 components.
	if type(cframe) == "table" and #cframe == 12 then
		return CFrame.new(table.unpack(cframe))
	end
	local angles = key.angles or { 0, 0, 0 }
	return CFrame.Angles(math.rad(angles[1] or 0), math.rad(angles[2] or 0), math.rad(angles[3] or 0))
end

local function easingOf(key: Key): (Enum.PoseEasingStyle, Enum.PoseEasingDirection)
	local style, direction = string.match(key.easing or "Linear", "^(%a+)/?(%a*)$")
	local resolved = (Enum.PoseEasingStyle :: any)[style or "Linear"] or Enum.PoseEasingStyle.Linear
	local towards = (Enum.PoseEasingDirection :: any)[direction ~= "" and direction or "Out"]
	return resolved, towards or Enum.PoseEasingDirection.Out
end

-- The value of one joint at an arbitrary time. Before the first key it holds the first value,
-- after the last it holds the last, and between two it lerps -- so a joint keyed only at the ends
-- still has a sensible pose in every keyframe the other joints introduced.
function Anim.Sample(keys: { Key }, at: number): CFrame
	if #keys == 0 then
		return CFrame.identity
	end
	if at <= keys[1].time then
		return cframeOf(keys[1])
	end

	for index = 1, #keys - 1 do
		local from, to = keys[index], keys[index + 1]
		if at >= from.time and at <= to.time then
			local span = to.time - from.time
			local alpha = if span > 0 then (at - from.time) / span else 1
			return cframeOf(from):Lerp(cframeOf(to), alpha)
		end
	end
	return cframeOf(keys[#keys])
end

local function keyAt(keys: { Key }, at: number): Key?
	for _, key in keys do
		if math.abs(key.time - at) < 1e-4 then
			return key
		end
	end
	return nil
end

-- Also returns the union of every track's timestamps, which is the keyframe list: a keyframe
-- holds the whole body, so any joint moving at time t forces a pose for every joint at time t.
local function validate(rig: Rig.Rig, tracks: Tracks): ({ number }, { string }, string?)
	local times: { number } = {}
	local touched: { string } = {}

	for joint, keys in tracks do
		if not rig.byName[joint] then
			return {}, {}, `this rig has no joint named "{joint}". It has:\n{Rig.Describe(rig)}`
		end
		if type(keys) ~= "table" or #keys == 0 then
			return {}, {}, `track "{joint}" has no keys`
		end
		table.insert(touched, joint)

		table.sort(keys, function(a, b)
			return a.time < b.time
		end)
		for _, key in keys do
			if type(key.time) ~= "number" or key.time < 0 then
				return {}, {}, `a key on "{joint}" has no usable time`
			end
			if not table.find(times, key.time) then
				table.insert(times, key.time)
			end
		end
	end

	if #times == 0 then
		return {}, {}, "no tracks, so there's nothing to compile"
	end
	table.sort(times)
	return times, touched, nil
end

-- Returns a temporary hash id usable straight away as Animation.AnimationId. Studio only, and
-- nothing is uploaded -- which is what makes previewing an animation a one-call loop.
function Anim.Compile(
	model: Instance,
	tracks: Tracks,
	options: { priority: string?, loop: boolean? }?
): (Compiled?, string?)
	local rig, problem = Rig.Build(model)
	if not rig then
		return nil, problem
	end

	local times, joints, bad = validate(rig, tracks)
	if bad then
		return nil, bad
	end

	local sequence = Instance.new("KeyframeSequence")
	sequence.Name = model.Name
	local settings = options or ({} :: { priority: string?, loop: boolean? })
	sequence.Loop = settings.loop ~= false
	local priority = (Enum.AnimationPriority :: any)[settings.priority or "Action"]
	if priority then
		sequence.Priority = priority
	end

	for _, at in times do
		local keyframe = Instance.new("Keyframe")
		keyframe.Time = at

		local pose = Rig.PoseTree(rig, function(joint: string): CFrame?
			local keys = tracks[joint]
			return if keys then Anim.Sample(keys, at) else nil
		end)

		-- Easing and weight are per-pose and only meaningful where the author actually put a key.
		for _, descendant in pose:GetDescendants() do
			local keys = tracks[descendant.Name]
			local key = if keys then keyAt(keys, at) else nil
			if key and descendant:IsA("Pose") then
				descendant.EasingStyle, descendant.EasingDirection = easingOf(key)
				if key.weight then
					descendant.Weight = key.weight
				end
			end
		end

		pose.Parent = keyframe
		keyframe.Parent = sequence
	end

	-- KeyframeSequence.Length reads 0 until the sequence is loaded, so the length is the last
	-- keyframe time and nothing else.
	local length = times[#times]
	local ok, id = pcall(function()
		return KeyframeSequenceProvider:RegisterKeyframeSequence(sequence)
	end)
	sequence:Destroy()
	if not ok then
		return nil, `couldn't register the sequence: {id}`
	end

	return { id = id, length = length, joints = joints, keyframes = #times }, nil
end

-- The other direction, so an uploaded animation can be pulled down with
-- AnimationClipProvider:GetAnimationClipAsync, edited as tracks, and recompiled for preview
-- without ever going back through the website.
function Anim.Decompile(sequence: KeyframeSequence): Tracks
	local tracks: Tracks = {}
	local keyframes = sequence:GetKeyframes()
	table.sort(keyframes, function(a, b)
		return (a :: Keyframe).Time < (b :: Keyframe).Time
	end)

	for _, item in keyframes do
		local keyframe = item :: Keyframe
		for _, descendant in keyframe:GetDescendants() do
			if not descendant:IsA("Pose") then
				continue
			end
			-- An identity pose is the rest position, which is the same thing as having no key.
			if descendant.CFrame == CFrame.identity then
				continue
			end
			local keys = tracks[descendant.Name] or {}
			tracks[descendant.Name] = keys
			table.insert(keys, {
				time = keyframe.Time,
				cframe = descendant.CFrame,
				easing = `{descendant.EasingStyle.Name}/{descendant.EasingDirection.Name}`,
				weight = if descendant.Weight ~= 1 then descendant.Weight else nil,
			})
		end
	end
	return tracks
end

return Anim
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Audit</string>
          <string name="Source"><![CDATA[--!strict

-- Collects the code a model needs to review the game's remotes for real.
--
-- The hard part of a security pass isn't the reasoning -- a model can spot a missing ownership
-- check or a client-authoritative grant on sight. The hard part is putting the *right* code in
-- front of it: out of a whole game, which scripts actually handle remotes, and which remote does
-- each one serve. That's what this does. It finds every server-side remote binding, traces the
-- variable back to the remote it belongs to, and returns the full source of each handling script
-- so the model reads the real thing -- requires, validation helpers, the lot -- not a sliced window.
--
-- It reads Script.Source, so it only works on the plugin/server side of a Studio session. It does
-- no grading of its own on purpose: the point is that the model reviews the code, decides which
-- remotes are exploitable, and hands those to Exploit to abuse. This just gathers.

local Audit = {}

export type Handler = {
	script: string,
	remotes: { string }, -- remote names this script binds a server handler for
	source: string,
}

export type Surface = {
	handlers: { Handler },
	remotes: { { name: string, path: string, class: string } },
	-- Remotes with no server-side binding found in any readable script: client-only, or dispatched
	-- through a table the tracer can't follow. Worth a manual look.
	orphans: { string },
}

local MAX_SOURCE = 24000

-- The remote a handler serves, read back from the code. Handlers bind through a variable
-- (`combat.OnServerEvent:Connect`), so find the variable, then find where it was assigned from a
-- remote by name. Returns nil when the source doesn't say plainly enough to trust.
local function remoteName(source: string, var: string): string?
	for _, pattern in
		{
			`local%s+${var}%s*=%s*[^\n]-[:.]WaitForChild%s*%(%s*["'](.-)["']`,
			`${var}%s*=%s*[^\n]-[:.]WaitForChild%s*%(%s*["'](.-)["']`,
			`local%s+${var}%s*=%s*[%w%.%[%]"']-%.([%w_]+)%s*[\n;]`,
			`${var}%s*=%s*[%w%.%[%]"']-%.([%w_]+)%s*[\n;]`,
		}
	do
		local name = string.match(source, pattern)
		if name then
			return name
		end
	end
	return nil
end

-- Gather every RemoteEvent/RemoteFunction and every script that binds a server handler, with the
-- handler's full source, so a model can review the real code.
function Audit.Surface(root: Instance?): Surface
	local scope = root or game

	local remotes: { { name: string, path: string, class: string } } = {}
	local bound: { [string]: boolean } = {}
	for _, instance in scope:GetDescendants() do
		if instance:IsA("RemoteEvent") or instance:IsA("UnreliableRemoteEvent") or instance:IsA("RemoteFunction") then
			table.insert(remotes, { name = instance.Name, path = instance:GetFullName(), class = instance.ClassName })
		end
	end

	local handlers: { Handler } = {}
	for _, instance in scope:GetDescendants() do
		if not instance:IsA("LuaSourceContainer") then
			continue
		end
		local ok, source = pcall(function()
			return (instance :: any).Source
		end)
		if not ok or type(source) ~= "string" or not string.find(source, "OnServer", 1, true) then
			continue
		end

		local names: { string } = {}
		local seen: { [string]: boolean } = {}
		for var in source:gmatch("([%w_]+)%.OnServer[EI]") do
			local name = remoteName(source, var) or var
			if not seen[name] then
				seen[name] = true
				bound[name] = true
				table.insert(names, name)
			end
		end

		if #names > 0 then
			table.insert(handlers, {
				script = instance:GetFullName(),
				remotes = names,
				source = if #source > MAX_SOURCE
					then source:sub(1, MAX_SOURCE) .. "\n-- ...(truncated, read the script directly for the rest)"
					else source,
			})
		end
	end

	local orphans: { string } = {}
	for _, remote in remotes do
		if not bound[remote.name] then
			table.insert(orphans, remote.path)
		end
	end

	return { handlers = handlers, remotes = remotes, orphans = orphans }
end

-- The surface as text, for a model to read and review. No verdicts -- that's the reader's job.
function Audit.Render(surface: Surface): string
	local lines = {
		`{#surface.remotes} remote(s), {#surface.handlers} handling script(s). Review each handler `
			.. "below for exploitable remotes -- missing type/ownership/rate checks, client-authoritative "
			.. "state, anything a client could abuse -- then hand the ones you flag to Exploit.AbuseAll.",
		"",
	}
	for _, handler in surface.handlers do
		table.insert(lines, `=== {handler.script}  (binds: {table.concat(handler.remotes, ", ")}) ===`)
		table.insert(lines, handler.source)
		table.insert(lines, "")
	end
	if #surface.orphans > 0 then
		table.insert(lines, `no server handler found for (client-only or dynamically dispatched -- look manually):`)
		for _, path in surface.orphans do
			table.insert(lines, `  {path}`)
		end
	end
	return table.concat(lines, "\n")
end

return Audit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Bench</string>
          <string name="Source"><![CDATA[--!strict
--!optimize 2

-- Runs a function a lot of times and says how long it took.
--
-- The point isn't the total -- that you could time yourself. It's the distribution: a function
-- whose mean is fine and whose p99 is forty times the median is the one causing the hitch, and an
-- average hides that completely. Pair it with `perFrame` to reproduce the shape of real load
-- instead of a tight loop the scheduler never sees.

local RunService = game:GetService("RunService")

local Bench = {}

export type Options = {
	-- Total calls. Defaults to 1000, or unlimited when `seconds` is set.
	times: number?,
	-- Stop after this long however many calls that took.
	seconds: number?,
	-- Calls per frame. Without it the calls run back to back with no yielding at all.
	perFrame: number?,
	-- Passed to the function on every call.
	args: { any }?,
	-- Calls to make and throw away first, so JIT warmup and lazy init don't skew the numbers.
	warmup: number?,
}

export type Report = {
	calls: number,
	errors: number,
	firstError: string?,
	totalMs: number,
	meanMs: number,
	minMs: number,
	maxMs: number,
	p50Ms: number,
	p95Ms: number,
	p99Ms: number,
	elapsedSeconds: number,
}

local DEFAULT_TIMES = 1000
local MAX_SAMPLES = 20000

local function percentile(sorted: { number }, fraction: number): number
	if #sorted == 0 then
		return 0
	end
	local index = math.clamp(math.ceil(fraction * #sorted), 1, #sorted)
	return sorted[index]
end

function Bench.Run(fn: (...any) -> ...any, options: Options?): Report
	local settings = options or ({} :: Options)
	local args = settings.args or {}
	local limit = settings.times or (if settings.seconds then math.huge else DEFAULT_TIMES)
	local perFrame = settings.perFrame
	local deadline = if settings.seconds then os.clock() + settings.seconds else math.huge

	for _ = 1, settings.warmup or 0 do
		pcall(fn, table.unpack(args))
	end

	local samples: { number } = {}
	local errors = 0
	local firstError: string? = nil
	local calls = 0
	local started = os.clock()
	local thisFrame = 0

	while calls < limit and os.clock() < deadline do
		local before = os.clock()
		local ok, failure = pcall(fn, table.unpack(args))
		local took = (os.clock() - before) * 1000

		calls += 1
		if #samples < MAX_SAMPLES then
			table.insert(samples, took)
		end
		if not ok then
			errors += 1
			firstError = firstError or tostring(failure)
		end

		if perFrame then
			thisFrame += 1
			if thisFrame >= perFrame then
				thisFrame = 0
				RunService.Heartbeat:Wait()
			end
		end
	end

	local elapsed = os.clock() - started
	table.sort(samples)

	local total = 0
	for _, sample in samples do
		total += sample
	end

	return {
		calls = calls,
		errors = errors,
		firstError = firstError,
		totalMs = total,
		meanMs = if #samples > 0 then total / #samples else 0,
		minMs = if #samples > 0 then samples[1] else 0,
		maxMs = if #samples > 0 then samples[#samples] else 0,
		p50Ms = percentile(samples, 0.5),
		p95Ms = percentile(samples, 0.95),
		p99Ms = percentile(samples, 0.99),
		elapsedSeconds = elapsed,
	}
end

-- One line, because the full report in a timeline note is unreadable.
function Bench.Summarise(report: Report): string
	local shape = string.format(
		"mean %.3fms, p50 %.3f, p95 %.3f, p99 %.3f, max %.3f",
		report.meanMs,
		report.p50Ms,
		report.p95Ms,
		report.p99Ms,
		report.maxMs
	)
	local failures = if report.errors > 0 then `, {report.errors} errored ({report.firstError})` else ""
	return `{report.calls} calls in {string.format("%.2f", report.elapsedSeconds)}s -- {shape}{failures}`
end

return Bench
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Build</string>
          <string name="Source"><![CDATA[--!strict

-- Turns a region of the DataModel into Luau that rebuilds it, and back again.
--
-- The reason is cost, not elegance. Reading a build as a tree dump tells you what's there but
-- nothing you can change; reading it as code means an edit is a diff on a few lines instead of a
-- description of every part in the area. One region comes back as code, the change happens in the
-- code, the code goes back.
--
-- The generated source is idempotent on purpose: it looks for a child by name before creating one,
-- so running it twice updates rather than duplicating, and running an edited version only moves
-- what actually changed. That's what makes "re-apply" safe without a differ.

local CollectionService = game:GetService("CollectionService")

local Path = require(script.Parent.Parent.Path)

local Build = {}

-- Properties worth capturing, by the class that owns them. An instance takes every entry it IsA,
-- so a MeshPart picks up the BasePart set and its own. There's no way to enumerate an instance's
-- properties from Luau, so this is a curated list and knows nothing about anything not on it.
local PROPERTIES: { { class: string, names: { string } } } = {
	{
		class = "BasePart",
		names = {
			"Size",
			"CFrame",
			"Anchored",
			"CanCollide",
			"CanTouch",
			"CanQuery",
			"Color",
			"Material",
			"Transparency",
			"Reflectance",
			"CastShadow",
			"CollisionGroup",
		},
	},
	{ class = "MeshPart", names = { "MeshId", "TextureID", "DoubleSided" } },
	{ class = "SpecialMesh", names = { "MeshId", "TextureId", "Scale", "Offset", "MeshType" } },
	{ class = "Decal", names = { "Texture", "Face", "Color3", "Transparency", "ZIndex" } },
	{ class = "Texture", names = { "StudsPerTileU", "StudsPerTileV" } },
	{ class = "Attachment", names = { "CFrame", "Visible" } },
	{ class = "Light", names = { "Brightness", "Color", "Enabled", "Shadows" } },
	{ class = "PointLight", names = { "Range" } },
	{ class = "SpotLight", names = { "Range", "Angle", "Face" } },
	{ class = "SurfaceLight", names = { "Range", "Angle", "Face" } },
	{
		class = "ParticleEmitter",
		names = { "Rate", "Lifetime", "Speed", "Texture", "Color", "Enabled", "SpreadAngle" },
	},
	{ class = "Beam", names = { "Texture", "Width0", "Width1", "Color", "Enabled" } },
	{ class = "SurfaceAppearance", names = { "ColorMap", "NormalMap", "MetalnessMap", "RoughnessMap" } },
	{
		class = "GuiObject",
		names = {
			"Size",
			"Position",
			"AnchorPoint",
			"BackgroundColor3",
			"BackgroundTransparency",
			"BorderSizePixel",
			"ZIndex",
			"Visible",
		},
	},
	{ class = "TextLabel", names = { "Text", "TextColor3", "TextSize", "Font", "TextWrapped", "TextXAlignment" } },
	{ class = "ImageLabel", names = { "Image", "ImageColor3", "ImageTransparency", "ScaleType" } },
	{ class = "UICorner", names = { "CornerRadius" } },
	{ class = "UIStroke", names = { "Thickness", "Color", "Transparency", "ApplyStrokeMode" } },
	{
		class = "UIListLayout",
		names = { "Padding", "FillDirection", "SortOrder", "HorizontalAlignment", "VerticalAlignment" },
	},
}

local MAX_DEPTH = 12
local MAX_NODES = 800

local function num(value: number): string
	if value ~= value then
		return "0 / 0"
	end
	if value == math.huge or value == -math.huge then
		return if value > 0 then "math.huge" else "-math.huge"
	end
	if value % 1 == 0 and math.abs(value) < 1e15 then
		return string.format("%d", value)
	end
	return string.format("%.4g", value)
end

local function rgb(channel: number): string
	return string.format("%d", math.floor(channel * 255 + 0.5))
end

-- Radians are five digits nobody typed; a whole number of degrees is what the source said.
local function angle(radians: number): string
	if radians == 0 then
		return "0"
	end
	local degrees = math.deg(radians)
	local whole = math.floor(degrees + 0.5)
	if math.abs(degrees - whole) < 0.01 then
		return `math.rad({whole})`
	end
	return num(radians)
end

-- Every value that can appear in the generated source, written the way you'd type it. Anything
-- not here is skipped rather than guessed at, which is why the property list above is curated.
local function literal(value: any): string?
	local kind = typeof(value)
	if kind == "string" then
		return string.format("%q", value)
	end
	if kind == "number" then
		return num(value)
	end
	if kind == "boolean" then
		return tostring(value)
	end
	if kind == "Vector3" then
		return `Vector3.new({num(value.X)}, {num(value.Y)}, {num(value.Z)})`
	end
	if kind == "Vector2" then
		return `Vector2.new({num(value.X)}, {num(value.Y)})`
	end
	if kind == "Color3" then
		return `Color3.fromRGB({rgb(value.R)}, {rgb(value.G)}, {rgb(value.B)})`
	end
	if kind == "UDim" then
		return `UDim.new({num(value.Scale)}, {num(value.Offset)})`
	end
	if kind == "UDim2" then
		return `UDim2.new({num(value.X.Scale)}, {num(value.X.Offset)}, {num(value.Y.Scale)}, {num(value.Y.Offset)})`
	end
	if kind == "NumberRange" then
		return `NumberRange.new({num(value.Min)}, {num(value.Max)})`
	end
	if kind == "EnumItem" then
		return tostring(value)
	end
	if kind == "BrickColor" then
		return `BrickColor.new("{value.Name}")`
	end
	if kind == "CFrame" then
		local position = value.Position
		local rx, ry, rz = value:ToEulerAnglesXYZ()
		local origin = `CFrame.new({num(position.X)}, {num(position.Y)}, {num(position.Z)})`
		if rx == 0 and ry == 0 and rz == 0 then
			return origin
		end
		return `{origin} * CFrame.Angles({angle(rx)}, {angle(ry)}, {angle(rz)})`
	end
	return nil
end

local function propertiesFor(instance: Instance): { string }
	local names: { string } = {}
	for _, entry in PROPERTIES do
		if not instance:IsA(entry.class) then
			continue
		end
		for _, name in entry.names do
			if not table.find(names, name) then
				table.insert(names, name)
			end
		end
	end
	return names
end

-- Only what differs from a fresh instance of the same class. A part dump that spells out every
-- default is mostly noise, and noise is the thing this module exists to remove.
local function defaults(className: string): Instance?
	local ok, fresh = pcall(Instance.new, className)
	return if ok then fresh else nil
end

local HEADER = [[
-- Generated by VMCP. Edit freely and run it again: `ensure` updates what's already there rather
-- than making a second copy, so only what you changed moves.

local function ensure(parent, name, class)
	local found = parent:FindFirstChild(name)
	if found and found.ClassName ~= class then
		found:Destroy()
		found = nil
	end
	if not found then
		found = Instance.new(class)
		found.Name = name
		found.Parent = parent
	end
	return found
end

-- An anchored part with nothing unusual about it, on one line.
local function part(parent, name, class, size, cframe, material, color)
	local found = ensure(parent, name, class)
	found.Size, found.CFrame, found.Anchored = size, cframe, true
	if material then found.Material = Enum.Material[material] end
	if color then found.Color = color end
	return found
end

return function(root)
]]

-- A part whose only non-default properties are these collapses to one `part(...)` line.
local PLAIN_PART: { [string]: boolean } = { Size = true, CFrame = true, Anchored = true, Material = true, Color = true }

export type Options = {
	depth: number?,
	maxNodes: number?,
	-- Include attributes and CollectionService tags. On by default; they're usually the part that
	-- actually drives behaviour.
	tags: boolean?,
}

-- Returns the source, plus how many instances it covered.
function Build.Dump(root: Instance, options: Options?): (string, number)
	local settings = options or ({} :: Options)
	local depthLimit = math.clamp(settings.depth or MAX_DEPTH, 1, MAX_DEPTH)
	local nodeLimit = math.clamp(settings.maxNodes or MAX_NODES, 1, MAX_NODES)
	local wantTags = settings.tags ~= false

	local lines = { HEADER }
	local count = 0
	local truncated = false

	local function emit(instance: Instance, parentVar: string, depth: number)
		if count >= nodeLimit then
			truncated = true
			return
		end
		count += 1
		local variable = `n{count}`
		local nameAndClass =
			`{parentVar}, {string.format("%q", instance.Name)}, {string.format("%q", instance.ClassName)}`
		local tags: { string } = if wantTags then CollectionService:GetTags(instance) else {}
		local attributes: { [string]: any } = if wantTags then instance:GetAttributes() else {}

		local fresh = defaults(instance.ClassName)
		local changed: { { name: string, value: any } } = {}
		local plain = fresh ~= nil and instance:IsA("BasePart") and (instance :: BasePart).Anchored
		for _, name in propertiesFor(instance) do
			local ok, value = pcall(function()
				return (instance :: any)[name]
			end)
			if not ok then
				continue
			end
			if fresh then
				local sameOk, same = pcall(function()
					return (fresh :: any)[name] == value
				end)
				if sameOk and same then
					continue
				end
			end
			if not PLAIN_PART[name] then
				plain = false
			end
			table.insert(changed, { name = name, value = value })
		end

		-- The local only exists if a later line refers to it: children, a property line, a tag.
		local referenced = (depth < depthLimit and #instance:GetChildren() > 0)
			or not plain
			or #tags > 0
			or next(attributes) ~= nil
		local declare = if referenced then `local {variable} = ` else ""

		if plain then
			local basePart = instance :: BasePart
			local material = basePart.Material
			local materialName = if material == Enum.Material.Plastic then "nil" else string.format("%q", material.Name)
			local color = if basePart.Color == (fresh :: BasePart).Color then "nil" else literal(basePart.Color)
			table.insert(
				lines,
				`\t{declare}part({nameAndClass}, {literal(basePart.Size)}, {literal(basePart.CFrame)}, {materialName}, {color})`
			)
		else
			table.insert(lines, `\t{declare}ensure({nameAndClass})`)
			for _, entry in changed do
				local written = literal(entry.value)
				if written then
					table.insert(lines, `\t{variable}.{entry.name} = {written}`)
				end
			end
		end

		for name, value in attributes do
			local written = literal(value)
			if written then
				table.insert(lines, `\t{variable}:SetAttribute({string.format("%q", name)}, {written})`)
			end
		end
		for _, tag in tags do
			table.insert(lines, `\tgame:GetService("CollectionService"):AddTag({variable}, {string.format("%q", tag)})`)
		end

		if fresh then
			fresh:Destroy()
		end
		if depth >= depthLimit then
			return
		end
		for _, child in instance:GetChildren() do
			emit(child, variable, depth + 1)
		end
	end

	for _, child in root:GetChildren() do
		emit(child, "root", 1)
	end

	if truncated then
		table.insert(lines, `\t-- stopped at {nodeLimit} instances; narrow the root or raise maxNodes`)
	end
	table.insert(lines, "\treturn root")
	table.insert(lines, "end")
	return table.concat(lines, "\n"), count
end

-- Runs a dump against a root. The source returns a function taking the root, so applying it
-- somewhere else is how you copy a region -- same code, different parent.
function Build.Apply(source: string, root: Instance): (boolean, string?)
	local Inject = require(script.Parent.Parent.Exec.Inject)
	local chunk, problem = Inject.Compile(source, "")
	if not chunk then
		return false, problem
	end

	local ok, produced = pcall(chunk)
	if not ok then
		return false, tostring(produced)
	end
	if type(produced) ~= "function" then
		return false, "that source didn't return a function -- a Build dump ends with `return function(root)`"
	end

	local ran, failure = pcall(produced, root)
	return ran, if ran then nil else tostring(failure)
end

-- Every part in a region as plain numbers, for the VMCP server to draw.
--
-- Studio can't hand out a picture -- a viewport screenshot needs a real camera, a real frame and a
-- place saved somewhere -- but it can hand out the geometry, and the geometry is tiny. What comes
-- back is roughly forty bytes per part, and the server renders it into something you can look at.
--
-- Shape names here are the four the renderer knows. Everything with a mesh or a union becomes its
-- bounding box, which is right for a blockout and honest about what it is.
local SHAPES: { [Enum.PartType]: string } = {
	[Enum.PartType.Block] = "box",
	[Enum.PartType.Ball] = "ball",
	[Enum.PartType.Cylinder] = "cylinder",
	[Enum.PartType.Wedge] = "wedge",
	[Enum.PartType.CornerWedge] = "wedge",
}

local function shapeOf(part: BasePart): string
	if part:IsA("WedgePart") or part:IsA("CornerWedgePart") then
		return "wedge"
	end
	if part:IsA("Part") then
		return SHAPES[part.Shape] or "box"
	end
	return "box"
end

local function round(value: number): number
	return math.floor(value * 1000 + 0.5) / 1000
end

export type Geometry = { { [string]: any } }

-- `cframe` overrides where the part is drawn, for posing a rig without moving it.
function Build.Describe(part: BasePart, index: number, cframe: CFrame?): { [string]: any }
	local components = { (cframe or part.CFrame):GetComponents() }
	for at, value in components do
		components[at] = round(value)
	end

	local size = part.Size
	local color = part.Color
	local material = part.Material
	return {
		i = index,
		n = part.Name,
		s = shapeOf(part),
		m = components,
		d = { round(size.X), round(size.Y), round(size.Z) },
		c = { round(color.R), round(color.G), round(color.B) },
		t = if part.Transparency > 0 then round(part.Transparency) else nil,
		k = if material == Enum.Material.Plastic or material == Enum.Material.SmoothPlastic then nil else material.Name,
	}
end

-- The parts to draw, and the list that says which drawn part is which. The badge number in the
-- picture is this part's place in `found`, so a thing you can see has a path you can grep for.
function Build.Geometry(root: Instance, maxParts: number?): (Geometry, { BasePart }, boolean)
	local limit = maxParts or 1500
	local parts: Geometry = {}
	local found: { BasePart } = {}
	local skipped = false

	local function take(part: BasePart)
		if #parts >= limit then
			skipped = true
			return
		end
		table.insert(found, part)
		table.insert(parts, Build.Describe(part, #found))
	end

	if root:IsA("BasePart") then
		take(root)
	end
	for _, descendant in root:GetDescendants() do
		-- Terrain is a BasePart the size of the world; on a Workspace root it would swallow the
		-- bounds and the picture.
		if descendant:IsA("BasePart") and not descendant:IsA("Terrain") then
			take(descendant)
		end
	end

	return parts, found, skipped
end

-- What's wrong with a build, in code rather than by eye.
--
-- A picture shows you a part in the wrong place; it can't tell you the rotation is 0.4 degrees off
-- true, and that's the kind of thing build code produces and nobody notices. Each of these is a
-- mistake that comes from generating geometry rather than placing it by hand.

export type Problem = { part: BasePart, kind: string, detail: string }

local NEAR_MISS_DEGREES = 5
local SUPPORTED_GAP = 0.25
local THIN = 0.1
local OUTLIER_STUDS = 250
-- Two parts sharing a face are touching, not sunk in; a build made of flush boxes would otherwise
-- report every wall against its floor.
local FLUSH = 0.05

-- World-space box around a part, rotation and all. Rotated parts get a box bigger than they are,
-- which makes the depth below an estimate -- still a number you can subtract from a position.
local function aabb(part: BasePart): (Vector3, Vector3)
	local cframe = part.CFrame
	local half = part.Size / 2
	local right, up, look = cframe.RightVector, cframe.UpVector, cframe.LookVector
	local extent = Vector3.new(
		math.abs(right.X) * half.X + math.abs(up.X) * half.Y + math.abs(look.X) * half.Z,
		math.abs(right.Y) * half.X + math.abs(up.Y) * half.Y + math.abs(look.Y) * half.Z,
		math.abs(right.Z) * half.X + math.abs(up.Z) * half.Y + math.abs(look.Z) * half.Z
	)
	return cframe.Position - extent, cframe.Position + extent
end

-- How far one box is sunk into another and along which axis the shortest way out is.
local function penetration(a: BasePart, b: BasePart): (number, string)
	local aMin, aMax = aabb(a)
	local bMin, bMax = aabb(b)
	local overlap = aMax:Min(bMax) - aMin:Max(bMin)
	local depth = math.min(overlap.X, overlap.Y, overlap.Z)
	local axis = if depth == overlap.X then "X" elseif depth == overlap.Y then "Y" else "Z"
	return depth, axis
end

local function degreesOffAxis(cframe: CFrame): number
	local worst = 0
	for _, direction in { cframe.RightVector, cframe.UpVector, cframe.LookVector } do
		local nearest = math.max(math.abs(direction.X), math.abs(direction.Y), math.abs(direction.Z))
		worst = math.max(worst, math.deg(math.acos(math.clamp(nearest, -1, 1))))
	end
	return worst
end

-- A view's `at` can be a dotted path as well as {x, y, z}; the renderer only knows numbers, so
-- resolve paths to the instance's pivot here. Returns the views to send and any paths that didn't
-- resolve, so the tool can say so instead of silently drawing the whole build.
function Build.ResolveViews(views: { any }): ({ any }, { string })
	local resolved = {}
	local missing = {}
	for _, view in views do
		if type(view) == "table" and type(view.at) == "string" then
			local found, problem = Path.Resolve(view.at)
			if found and (found:IsA("BasePart") or found:IsA("Model")) then
				local position = if found:IsA("Model") then found:GetPivot().Position else (found :: BasePart).Position
				local copy = table.clone(view)
				copy.at = { position.X, position.Y, position.Z }
				view = copy
			else
				table.insert(missing, problem or `"{view.at}" isn't a part or model`)
			end
		end
		table.insert(resolved, view)
	end
	return resolved, missing
end

-- The parts a set of views can actually show: everything, unless every panel is clipped to a
-- radius, in which case only what's inside one of them. Drives whether badges make sense and
-- which parts the legend bothers listing.
function Build.Shown(parts: { BasePart }, views: { any }): { [BasePart]: boolean }
	local shown: { [BasePart]: boolean } = {}
	local clipped = {}
	for _, view in views do
		if type(view) ~= "table" or view.clip ~= true or type(view.at) ~= "table" or type(view.radius) ~= "number" then
			for _, part in parts do
				shown[part] = true
			end
			return shown
		end
		table.insert(clipped, { at = Vector3.new(view.at[1], view.at[2], view.at[3]), radius = view.radius })
	end
	for _, part in parts do
		for _, view in clipped do
			if (part.Position - view.at).Magnitude <= view.radius then
				shown[part] = true
				break
			end
		end
	end
	return shown
end

function Build.Problems(root: Instance, maxParts: number?, known: { BasePart }?): { Problem }
	local parts: { BasePart } = known or ({} :: { BasePart })
	if not known then
		local _, walked = Build.Geometry(root, maxParts)
		parts = walked
	end
	local problems: { Problem } = {}

	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Include
	overlap.FilterDescendantsInstances = (parts :: any) :: { Instance }
	overlap.MaxParts = 4

	local rays = RaycastParams.new()
	rays.FilterType = Enum.RaycastFilterType.Exclude

	local reportedOverlap: { [BasePart]: boolean } = {}
	local stacked: { [string]: BasePart } = {}
	local centre = Vector3.zero

	for _, part in parts do
		centre += part.Position
	end
	centre = if #parts > 0 then centre / #parts else Vector3.zero

	for _, part in parts do
		local size = part.Size

		if math.min(size.X, size.Y, size.Z) < THIN then
			table.insert(problems, {
				part = part,
				kind = "paper thin",
				detail = `{size.X} x {size.Y} x {size.Z} -- probably a size that was computed to nothing`,
			})
		end

		local tilt = degreesOffAxis(part.CFrame)
		if tilt > 0.02 and tilt < NEAR_MISS_DEGREES then
			table.insert(problems, {
				part = part,
				kind = "off axis",
				detail = `rotated {string.format("%.2f", tilt)} degrees off square -- meant to be flat?`,
			})
		end

		local key = `{part.Name}|{size}|{round(part.Position.X)},{round(part.Position.Y)},{round(part.Position.Z)}`
		local twin = stacked[key]
		if twin then
			table.insert(problems, {
				part = part,
				kind = "duplicate",
				detail = `same name, size and position as {twin:GetFullName()} -- build code run twice?`,
			})
		else
			stacked[key] = part
		end

		local touching = workspace:GetPartsInPart(part, overlap)
		local connected = false
		for _, other in touching do
			if other == part then
				continue
			end
			connected = true
			local depth, axis = penetration(part, other)
			if depth > FLUSH and not reportedOverlap[part] and not reportedOverlap[other] then
				reportedOverlap[part] = true
				table.insert(problems, {
					part = part,
					kind = "overlapping",
					detail = `sunk about {string.format("%.2f", depth)} studs into {other:GetFullName()} along {axis}`,
				})
			end
		end

		-- Only parts that touch nothing at all are worth checking for support: a wall welded to
		-- its neighbour has nothing underneath it either, and that's not a mistake.
		if not connected then
			rays.FilterDescendantsInstances = { part }
			local hit = workspace:Raycast(part.Position, Vector3.new(0, -(size.Y / 2 + 512), 0), rays)
			if not hit then
				table.insert(problems, { part = part, kind = "floating", detail = "nothing under it at all" })
			else
				local gap = hit.Distance - size.Y / 2
				if gap > SUPPORTED_GAP then
					table.insert(problems, {
						part = part,
						kind = "floating",
						detail = `{string.format("%.2f", gap)} studs above {hit.Instance:GetFullName()}`,
					})
				end
			end
		end

		local away = (part.Position - centre).Magnitude
		if away > OUTLIER_STUDS then
			table.insert(problems, {
				part = part,
				kind = "stranded",
				detail = `{math.floor(away)} studs from the middle of the build`,
			})
		end
	end

	return problems
end

-- The build as numbers: where it sits, how big each top-level group is, what's wrong, and which
-- badge is which part. This is the part of a render that survives being read -- a picture can't be
-- held in your head next to the code, a list of extents can.

local function fmt(value: number): string
	return string.format(if value % 1 == 0 then "%d" else "%.1f", value)
end

local function v3(value: Vector3): string
	return `({fmt(value.X)}, {fmt(value.Y)}, {fmt(value.Z)})`
end

local function span(min: Vector3, max: Vector3): string
	local size = max - min
	return `{fmt(size.X)}x{fmt(size.Y)}x{fmt(size.Z)} spanning x {fmt(min.X)}..{fmt(max.X)}, y {fmt(min.Y)}..{fmt(max.Y)}, z {fmt(
		min.Z
	)}..{fmt(max.Z)}`
end

local function shorten(instance: Instance, root: Instance): string
	local full = instance:GetFullName()
	local prefix = `{root:GetFullName()}.`
	if string.sub(full, 1, #prefix) == prefix then
		return string.sub(full, #prefix + 1)
	end
	return full
end

type Extent = { min: Vector3, max: Vector3, count: number }

local function grow(extent: Extent?, min: Vector3, max: Vector3): Extent
	if not extent then
		return { min = min, max = max, count = 1 }
	end
	extent.min = extent.min:Min(min)
	extent.max = extent.max:Max(max)
	extent.count += 1
	return extent
end

-- `legend` is the set of parts that carry a badge in the picture; nil means no badges, and then
-- no per-part list either -- on a big build that list is most of the reply and points at nothing.
function Build.Report(
	root: Instance,
	parts: { BasePart },
	legend: { [BasePart]: boolean }?,
	problems: { Problem }?
): string
	local lines = {}

	local whole: Extent? = nil
	local groups: { [Instance]: Extent } = {}
	local order: { Instance } = {}
	for _, part in parts do
		local min, max = aabb(part)
		whole = grow(whole, min, max)
		-- The group is whichever child of the root this part lives under -- a loose part is its own.
		local top: Instance = part
		while top.Parent ~= root and top.Parent ~= nil do
			top = top.Parent :: Instance
		end
		if not groups[top] then
			table.insert(order, top)
		end
		groups[top] = grow(groups[top], min, max)
	end

	if whole then
		table.insert(lines, `bounds: {span(whole.min, whole.max)}`)
	end
	if #order > 1 then
		table.insert(lines, "groups (direct children of the root):")
		for _, top in order do
			local extent = groups[top]
			local plural = if extent.count == 1 then "part" else "parts"
			table.insert(lines, `  {top.Name}  {extent.count} {plural}, {span(extent.min, extent.max)}`)
		end
	end

	if problems then
		table.insert(lines, "")
		if #problems == 0 then
			table.insert(lines, "no problems found")
		else
			table.insert(lines, `{#problems} thing(s) worth a look:`)
			for _, problem in problems do
				table.insert(lines, `  {shorten(problem.part, root)} -- {problem.kind}: {problem.detail}`)
			end
		end
	end

	if legend then
		table.insert(lines, "")
		table.insert(lines, "legend (the number in the picture):")
		for index, part in parts do
			if legend[part] then
				local size = part.Size
				table.insert(
					lines,
					`  #{index} {shorten(part, root)}  {fmt(size.X)}x{fmt(size.Y)}x{fmt(size.Z)} at {v3(part.Position)}`
				)
			end
		end
	end

	return table.concat(lines, "\n")
end

return Build
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Canvas</string>
          <string name="Source"><![CDATA[--!strict
--!native

-- An EditableImage that writes everything down.
--
-- The drawing itself is the engine's -- DrawRectangle, DrawCircle, DrawLine all exist and are
-- faster than anything written here would be. What earns this module its place is the recording:
-- the same list of operations goes back to Node, which replays it into a PNG. So one snippet
-- gives a live preview in Studio and a file on disk, from one description.
--
-- Render also ships the real pixels (ReadPixelsBuffer, base64) when the image is small enough,
-- so anything drawn straight on `canvas.image` -- DrawImage, WritePixelsBuffer -- lands in the
-- PNG too. The recording stays as the portable description and the fallback for big images.

local AssetService = game:GetService("AssetService")

-- The engine's hard cap. An EditableImage can't be resized either, so a bigger one means a new
-- image and a DrawImageTransformed into it.
local MAX_SIZE = 1024
-- Past this many bytes of RGBA the base64 alone is most of the socket's message budget, so the
-- server replays the recording instead. 512x512 is 1 MB raw, 1.4 MB encoded.
local MAX_PIXEL_BYTES = 512 * 512 * 4

local BLEND = Enum.ImageCombineType.AlphaBlend

local Canvas = {}

export type Op = { [string]: any }

export type Canvas = {
	image: EditableImage,
	width: number,
	height: number,
	ops: { Op },
	assetId: number?,
	Clear: (self: Canvas, color: Color3, alpha: number?) -> Canvas,
	Rect: (self: Canvas, x: number, y: number, w: number, h: number, color: Color3, alpha: number?) -> Canvas,
	Circle: (self: Canvas, x: number, y: number, radius: number, color: Color3, alpha: number?) -> Canvas,
	Line: (self: Canvas, x1: number, y1: number, x2: number, y2: number, color: Color3, thickness: number?) -> Canvas,
	Content: (self: Canvas) -> Content,
	Pixels: (self: Canvas) -> string?,
	Upload: (self: Canvas, name: string, description: string?) -> (number?, string?),
	Recording: (self: Canvas) -> { [string]: any },
}

local Methods = {}
Methods.__index = Methods

local function record(self: any, op: Op): any
	table.insert(self.ops, op)
	return self
end

local function rgb(color: Color3): { number }
	return { color.R, color.G, color.B }
end

function Methods.Clear(self: any, color: Color3, alpha: number?): any
	self.image:DrawRectangle(
		Vector2.zero,
		Vector2.new(self.width, self.height),
		color,
		1 - (alpha or 1),
		Enum.ImageCombineType.Overwrite
	)
	return record(self, { kind = "clear", color = rgb(color), alpha = alpha or 1 })
end

function Methods.Rect(self: any, x: number, y: number, w: number, h: number, color: Color3, alpha: number?): any
	self.image:DrawRectangle(Vector2.new(x, y), Vector2.new(w, h), color, 1 - (alpha or 1), BLEND)
	return record(self, { kind = "rect", x = x, y = y, w = w, h = h, color = rgb(color), alpha = alpha or 1 })
end

function Methods.Circle(self: any, x: number, y: number, radius: number, color: Color3, alpha: number?): any
	self.image:DrawCircle(Vector2.new(x, y), radius, color, 1 - (alpha or 1), BLEND)
	return record(self, { kind = "circle", x = x, y = y, r = radius, color = rgb(color), alpha = alpha or 1 })
end

-- DrawLine is one pixel wide and refuses an endpoint outside the image, so a thick line is a
-- stack of parallel ones, each clamped inside.
function Methods.Line(self: any, x1: number, y1: number, x2: number, y2: number, color: Color3, thickness: number?): any
	local width = math.max(1, math.round(thickness or 1))
	local dx, dy = x2 - x1, y2 - y1
	local length = math.max(1e-3, math.sqrt(dx * dx + dy * dy))
	local nx, ny = -dy / length, dx / length
	local maxX, maxY = self.width - 1, self.height - 1
	for i = 1, width do
		local offset = (i - 1) - (width - 1) / 2
		self.image:DrawLine(
			Vector2.new(math.clamp(x1 + nx * offset, 0, maxX), math.clamp(y1 + ny * offset, 0, maxY)),
			Vector2.new(math.clamp(x2 + nx * offset, 0, maxX), math.clamp(y2 + ny * offset, 0, maxY)),
			color,
			0,
			BLEND
		)
	end
	return record(self, { kind = "line", x1 = x1, y1 = y1, x2 = x2, y2 = y2, color = rgb(color), thickness = width })
end

-- Assign to an ImageLabel's ImageContent to see it. Only one EditableImage refreshes per frame on
-- the display side, so a wall of live previews updates one at a time.
function Methods.Content(self: any): Content
	return Content.fromObject(self.image)
end

local ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local ENCODE = table.create(64)
for i = 1, 64 do
	ENCODE[i - 1] = string.byte(ALPHABET, i)
end

-- JSON has no bytes, so the RGBA buffer goes over as base64. Three input bytes to four output
-- bytes, written straight into a second buffer; no string concatenation on the way.
local function base64(bytes: buffer): string
	local length = buffer.len(bytes)
	local out = buffer.create(math.ceil(length / 3) * 4)
	local o = 0
	local full = length - length % 3
	for i = 0, full - 1, 3 do
		local a, b, c = buffer.readu8(bytes, i), buffer.readu8(bytes, i + 1), buffer.readu8(bytes, i + 2)
		local n = a * 65536 + b * 256 + c
		buffer.writeu8(out, o, ENCODE[n // 262144])
		buffer.writeu8(out, o + 1, ENCODE[n // 4096 % 64])
		buffer.writeu8(out, o + 2, ENCODE[n // 64 % 64])
		buffer.writeu8(out, o + 3, ENCODE[n % 64])
		o += 4
	end
	local rest = length - full
	if rest == 1 then
		local a = buffer.readu8(bytes, full)
		buffer.writeu8(out, o, ENCODE[a // 4])
		buffer.writeu8(out, o + 1, ENCODE[a % 4 * 16])
		buffer.writeu8(out, o + 2, 61)
		buffer.writeu8(out, o + 3, 61)
	elseif rest == 2 then
		local a, b = buffer.readu8(bytes, full), buffer.readu8(bytes, full + 1)
		buffer.writeu8(out, o, ENCODE[a // 4])
		buffer.writeu8(out, o + 1, ENCODE[a % 4 * 16 + b // 16])
		buffer.writeu8(out, o + 2, ENCODE[b % 16 * 4])
		buffer.writeu8(out, o + 3, 61)
	end
	return buffer.tostring(out)
end

-- Any EditableImage's real RGBA as base64, or nil when it's over the size the socket is happy
-- carrying or can't be read (Mesh & Image APIs off).
function Canvas.Base64Pixels(image: EditableImage): string?
	local size = image.Size
	if size.X * size.Y * 4 > MAX_PIXEL_BYTES then
		return nil
	end
	local ok, bytes = pcall(function()
		return image:ReadPixelsBuffer(Vector2.zero, size)
	end)
	if not ok then
		return nil
	end
	return base64(bytes)
end

function Methods.Pixels(self: any): string?
	return Canvas.Base64Pixels(self.image)
end

-- Publishes the image as an Image asset owned by whoever is logged into Studio and remembers the
-- id, so a script can use rbxassetid://id with no EditableImage at runtime. Moderation runs after
-- upload, so the id exists at once and the picture follows a little later.
function Methods.Upload(self: any, name: string, description: string?): (number?, string?)
	local ok, result, id = pcall(function()
		return AssetService:CreateAssetAsync(self.image, Enum.AssetType.Image, {
			Name = name,
			Description = description or "Generated with VMCP Canvas",
		})
	end)
	if not ok then
		return nil, `upload failed: {result}`
	end
	if result ~= Enum.CreateAssetResult.Success then
		return nil, `upload refused: {result}`
	end
	self.assetId = id
	return id, nil
end

-- What vmcp.Render sends to the VMCP server, which writes it as a PNG. Returning it from a
-- run_luau snippet as `postProcess` does the same thing on the way out. Carries the real pixels
-- when they fit, and the op list either way.
function Methods.Recording(self: any): { [string]: any }
	return {
		kind = "png",
		width = self.width,
		height = self.height,
		ops = self.ops,
		pixels = self:Pixels(),
		assetId = self.assetId,
	}
end

function Canvas.new(width: number, height: number): (Canvas?, string?)
	if width < 1 or height < 1 or width > MAX_SIZE or height > MAX_SIZE then
		return nil, `an EditableImage is 1 to {MAX_SIZE} pixels on a side; asked for {width}x{height}`
	end

	local ok, image = pcall(function()
		return AssetService:CreateEditableImage({ Size = Vector2.new(width, height) })
	end)
	if not ok then
		return nil, `couldn't create the image: {image}`
	end

	return setmetatable({ image = image, width = width, height = height, ops = {} }, Methods) :: any, nil
end

return Canvas
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Equiv</string>
          <string name="Source"><![CDATA[--!strict
--!optimize 2

-- Proves two functions behave the same: same inputs in, same returns, same errors, same state
-- left behind. This is what makes "the fix doesn't change behaviour" a measured claim.
--
-- No dependencies on the rest of the plugin, on purpose: GameVm copies this module into the
-- playtest so it can run against functions that live in the game's own VM (where the plugin
-- can't reach them), and it's the same file either side.

local Equiv = {}

export type Mismatch = {
	-- The call index, or a probe label like "arg 2: nil".
	input: string,
	-- returns | error | state | outcome
	kind: string,
	detail: string,
}

export type Options = {
	-- Calls to make. Defaults to 100.
	n: number?,
	-- Snapshot of whatever the functions mutate, taken after each call and compared.
	state: (() -> any)?,
	-- Also feed both functions broken arguments and compare how they fail. Defaults to true.
	probes: boolean?,
	-- Relative tolerance for numbers. Defaults to 1e-9.
	tolerance: number?,
	-- Stop after this many mismatches. Defaults to 10.
	limit: number?,
}

export type Result = {
	passed: boolean,
	checked: number,
	probed: number,
	mismatches: { Mismatch },
	text: string,
}

local DEFAULT_N = 100
local DEFAULT_LIMIT = 10
local DEFAULT_TOLERANCE = 1e-9

local function describe(value: any, depth: number?): string
	local kind = typeof(value)
	if kind == "string" then
		return string.format("%q", if #value > 60 then string.sub(value, 1, 60) .. "…" else value)
	end
	if kind == "table" then
		if (depth or 0) >= 2 then
			return "{…}"
		end
		local parts = {}
		local count = 0
		for key, entry in value do
			count += 1
			if count > 6 then
				table.insert(parts, "…")
				break
			end
			table.insert(parts, `{tostring(key)} = {describe(entry, (depth or 0) + 1)}`)
		end
		return "{ " .. table.concat(parts, ", ") .. " }"
	end
	if kind == "Instance" then
		return `<{value.ClassName} {value:GetFullName()}>`
	end
	return tostring(value)
end

local function deepCopy(value: any, seen: { [any]: any }?): any
	if type(value) ~= "table" then
		return value
	end
	local memo = seen or {}
	if memo[value] then
		return memo[value]
	end
	local out = {}
	memo[value] = out
	for key, entry in value do
		out[deepCopy(key, memo)] = deepCopy(entry, memo)
	end
	return setmetatable(out, getmetatable(value)) :: any
end

-- Returns nil when equal, otherwise a path plus what differed.
local function diff(a: any, b: any, tolerance: number, path: string, seen: { [any]: boolean }): string?
	local ka, kb = typeof(a), typeof(b)
	if ka ~= kb then
		return `{path}: {ka} vs {kb} ({describe(a)} vs {describe(b)})`
	end
	if ka == "number" then
		if a ~= a and b ~= b then
			return nil
		end
		local scale = math.max(math.abs(a), math.abs(b), 1)
		if math.abs(a - b) > tolerance * scale then
			return `{path}: {a} vs {b}`
		end
		return nil
	end
	if ka == "table" then
		if a == b or seen[a] then
			return nil
		end
		seen[a] = true
		for key, entry in a do
			local problem = diff(entry, b[key], tolerance, `{path}.{tostring(key)}`, seen)
			if problem then
				return problem
			end
		end
		for key in b do
			if a[key] == nil then
				return `{path}.{tostring(key)}: nil vs {describe(b[key])}`
			end
		end
		return nil
	end
	if ka == "function" or ka == "thread" then
		return nil
	end
	if a ~= b then
		return `{path}: {describe(a)} vs {describe(b)}`
	end
	return nil
end

-- Script paths and line numbers differ between the original and a candidate module by
-- construction, so they can't be part of "the same error".
local function stripLocation(message: any): string
	local text = tostring(message)
	return (string.gsub(text, "^[%w%._:%- ]-:%d+: ", ""))
end

local function call(fn: (...any) -> ...any, args: { any }, count: number): (boolean, { any })
	local packed = table.pack(pcall(fn, table.unpack(args, 1, count)))
	local ok = packed[1]
	local rest: { any } = table.create(packed.n - 1)
	for index = 2, packed.n do
		rest[index - 1] = packed[index]
	end
	(rest :: any).n = packed.n - 1
	return ok, rest
end

-- What to swap an argument for to see whether both versions refuse it the same way.
type Probe = { label: string, value: any }

local function probesFor(value: any): { Probe }
	local kind = typeof(value)
	local out: { Probe } = { { label = "nil", value = nil } }
	if kind == "number" then
		table.insert(out, { label = "string instead of number", value = tostring(value) })
		table.insert(out, { label = "negative", value = -math.abs(value) - 1 })
		table.insert(out, { label = "nan", value = 0 / 0 })
	elseif kind == "string" then
		table.insert(out, { label = "number instead of string", value = 7 })
		table.insert(out, { label = "empty string", value = "" })
	elseif kind == "table" then
		table.insert(out, { label = "number instead of table", value = 7 })
		table.insert(out, { label = "empty table", value = {} })
	elseif kind == "Instance" then
		table.insert(out, { label = "string instead of instance", value = value:GetFullName() })
	elseif kind == "boolean" then
		table.insert(out, { label = "number instead of boolean", value = 1 })
	else
		table.insert(out, { label = "number instead of " .. kind, value = 7 })
	end
	return out
end

-- Runs one input through both and records how they disagree, if they do.
local function compareOne(
	old: (...any) -> ...any,
	new: (...any) -> ...any,
	args: { any },
	count: number,
	label: string,
	options: Options,
	tolerance: number,
	mismatches: { Mismatch }
)
	local oldOk, oldOut = call(old, deepCopy(args), count)
	local oldState = if options.state then deepCopy((options.state :: () -> any)()) else nil
	local newOk, newOut = call(new, deepCopy(args), count)
	local newState = if options.state then deepCopy((options.state :: () -> any)()) else nil

	if oldOk ~= newOk then
		table.insert(mismatches, {
			input = label,
			kind = "outcome",
			detail = if oldOk
				then `old returned {describe(oldOut[1])}, new errored: {stripLocation(newOut[1])}`
				else `old errored: {stripLocation(oldOut[1])}, new returned {describe(newOut[1])}`,
		})
		return
	end
	if not oldOk then
		local oldMessage, newMessage = stripLocation(oldOut[1]), stripLocation(newOut[1])
		if oldMessage ~= newMessage then
			table.insert(mismatches, { input = label, kind = "error", detail = `"{oldMessage}" vs "{newMessage}"` })
		end
		return
	end

	local problem = diff(oldOut, newOut, tolerance, "return", {})
	if problem then
		table.insert(mismatches, { input = label, kind = "returns", detail = problem })
		return
	end
	if options.state then
		local stateProblem = diff(oldState, newState, tolerance, "state", {})
		if stateProblem then
			table.insert(mismatches, { input = label, kind = "state", detail = stateProblem })
		end
	end
end

-- `generate(i)` returns the argument list for call i; it's called once per call and the
-- arguments are copied before each version sees them, so a function that mutates its input
-- can't leak that into the other version's run.
function Equiv.Check(
	old: (...any) -> ...any,
	new: (...any) -> ...any,
	generate: (index: number) -> { any },
	options: Options?
): Result
	local settings: Options = options or {}
	local n = settings.n or DEFAULT_N
	local limit = settings.limit or DEFAULT_LIMIT
	local tolerance = settings.tolerance or DEFAULT_TOLERANCE
	local mismatches: { Mismatch } = {}
	local checked = 0
	local probed = 0

	for index = 1, n do
		if #mismatches >= limit then
			break
		end
		local args = generate(index)
		local count = if type(args) == "table" then (args :: any).n or #args else 0
		compareOne(old, new, args, count, `call {index}`, settings, tolerance, mismatches)
		checked += 1
	end

	if settings.probes ~= false and #mismatches < limit then
		local base = generate(1)
		local count = (base :: any).n or #base
		for position = 1, count do
			for _, probe in probesFor(base[position]) do
				if #mismatches >= limit then
					break
				end
				local args = deepCopy(base)
				args[position] = probe.value
				compareOne(old, new, args, count, `arg {position}: {probe.label}`, settings, tolerance, mismatches)
				probed += 1
			end
		end
		if #mismatches < limit then
			compareOne(old, new, {}, 0, "no arguments", settings, tolerance, mismatches)
			probed += 1
		end
	end

	local lines = {}
	if #mismatches == 0 then
		table.insert(lines, `identical over {checked} inputs and {probed} broken-argument probes`)
	else
		table.insert(lines, `{#mismatches} mismatch(es) over {checked} inputs and {probed} probes:`)
		for _, mismatch in mismatches do
			table.insert(lines, `  [{mismatch.kind}] {mismatch.input}: {mismatch.detail}`)
		end
	end

	return {
		passed = #mismatches == 0,
		checked = checked,
		probed = probed,
		mismatches = mismatches,
		text = table.concat(lines, "\n"),
	}
end

return Equiv
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Exploit</string>
          <string name="Source"><![CDATA[--!strict

-- Does to your remotes what an exploiter would, from a real client, through the real network path.
--
-- The point is that a remote handler is only as safe as its worst caller, and the worst caller
-- doesn't use your UI. It sends the wrong types, sends nothing, sends a table where you wanted a
-- number, and sends it four hundred times a second. None of that is reachable by calling the
-- handler directly, which is why this lives in a client-context timeline event.
--
-- Blind junk only gets you so far, though: a handler that bails on the first argument never shows
-- you what the fourth one does. So the interesting half of this file works off what the game
-- *really* sends -- captured by Remotes.Shapes() on the server, replayed here, and broken one
-- argument at a time in the ways that matter for the type that argument actually is.
--
-- Nothing here reaches outside the place, and nothing bypasses anything the engine enforces --
-- it's your own remotes called rudely.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Bench = require(script.Parent.Bench)
local Path = require(script.Parent.Parent.Path)
local Portable = require(script.Parent.Parent.Exec.Portable)
local Serialize = require(script.Parent.Parent.Exec.Serialize)

local Exploit = {}

export type Report = Bench.Report

local HUGE_STRING = string.rep("A", 10000)

-- Matches Audit's severity words, so a target's static severity can break ties when two remotes are
-- equally abusable dynamically.
local RANK: { [string]: number } = { high = 3, medium = 2, low = 1 }

-- The values that break handlers with nothing to go on. Ordered roughly by how often they find
-- something: nil and the wrong type first, then the numeric edges, then the ones that only matter
-- if you index blindly.
local JUNK: { any } = {
	nil,
	0,
	-1,
	math.huge,
	-math.huge,
	0 / 0,
	2 ^ 53,
	"",
	"0",
	HUGE_STRING,
	true,
	false,
	{},
	{ 1, 2, 3 },
	Vector3.new(math.huge, 0, 0),
	CFrame.identity,
	workspace,
}

local function junk(): any
	-- JUNK's first slot is nil, so #JUNK stops short of the real length; the count is fixed.
	local index = math.random(1, 17)
	return JUNK[index]
end

-- Instances worth substituting into an argument that wanted one: somebody else's character is what
-- catches a missing ownership check, and a random part is what catches a missing "is this even the
-- right kind of thing". Built from the place at call time, so it's this game's instances.
local function pool(): { Instance }
	local found: { Instance } = {}
	local me = Players.LocalPlayer

	for _, player in Players:GetPlayers() do
		if player ~= me then
			table.insert(found, player)
			if player.Character then
				table.insert(found, player.Character)
			end
		end
	end
	if me and me.Character then
		table.insert(found, me.Character)
		local part = me.Character:FindFirstChild("HumanoidRootPart")
		if part then
			table.insert(found, part)
		end
	end

	for _, child in ReplicatedStorage:GetChildren() do
		table.insert(found, child)
		if #found > 24 then
			break
		end
	end
	for _, child in workspace:GetChildren() do
		if child:IsA("BasePart") or child:IsA("Model") then
			table.insert(found, child)
		end
		if #found > 32 then
			break
		end
	end

	if #found == 0 then
		table.insert(found, workspace)
	end
	return found
end

local function fire(remote: Instance, args: { any }, count: number?): (boolean, any)
	local width = count or #args
	if remote:IsA("RemoteEvent") or remote:IsA("UnreliableRemoteEvent") then
		return pcall(function()
			(remote :: any):FireServer(table.unpack(args, 1, width))
		end)
	end
	if remote:IsA("RemoteFunction") then
		return pcall(function(): any
			return (remote :: any):InvokeServer(table.unpack(args, 1, width))
		end)
	end
	return false, `{remote:GetFullName()} is a {remote.ClassName}, not a remote`
end

local function guard(remote: Instance): string?
	if not RunService:IsClient() then
		return "this only means anything from a client -- put it in a client-context event"
	end
	if not (remote:IsA("RemoteEvent") or remote:IsA("UnreliableRemoteEvent") or remote:IsA("RemoteFunction")) then
		return `{remote:GetFullName()} is a {remote.ClassName}, not a remote`
	end
	return nil
end

-- The same arguments, over and over. What this finds is missing rate limiting: if the handler is
-- happy to run a thousand times a second, it will.
function Exploit.Spam(remote: Instance, args: { any }?, options: Bench.Options?): (Report?, string?)
	local problem = guard(remote)
	if problem then
		return nil, problem
	end

	local payload = args or {}
	return Bench.Run(function()
		fire(remote, payload)
	end, options), nil
end

-- Junk arguments, every call. What this finds is missing validation: the handler that assumed the
-- number was a number, or that the table it indexed had the field.
function Exploit.Fuzz(remote: Instance, arity: number?, options: Bench.Options?): (Report?, string?)
	local problem = guard(remote)
	if problem then
		return nil, problem
	end

	local width = math.clamp(arity or 2, 0, 8)
	return Bench.Run(function()
		local args = table.create(width)
		for index = 1, width do
			args[index] = junk()
		end
		fire(remote, args, width)
	end, options),
		nil
end

-- Fires every remote it can find once, with junk. A sweep to see what falls over before writing a
-- targeted payload for whatever did.
function Exploit.FuzzAll(root: Instance, arity: number?): (string, number)
	local lines = {}
	local touched = 0
	for _, descendant in root:GetDescendants() do
		if guard(descendant) then
			continue
		end
		touched += 1
		local report = Exploit.Fuzz(descendant, arity, { times = 1 })
		local failed = report and report.errors > 0
		if failed then
			table.insert(lines, `  {descendant:GetFullName()} threw: {(report :: Report).firstError}`)
		end
	end

	if #lines == 0 then
		return `fired junk at {touched} remote(s); none of them threw`, touched
	end
	return `fired junk at {touched} remote(s):\n{table.concat(lines, "\n")}`, touched
end

-- `suspicious` marks a variant the server *ought* to reject -- a wrong type, a missing argument,
-- somebody else's Instance. The unchanged real call isn't suspicious, so it's the baseline that
-- tells you the handler works at all before you read anything into what the broken ones did.
export type Variant = { label: string, args: { any }, count: number, suspicious: boolean }

local function copy(args: { any }, count: number): { any }
	local out = table.create(count)
	for index = 1, count do
		out[index] = args[index]
	end
	return out
end

-- What to do to a real argument, given what it really is. Each entry returns the replacements
-- worth trying for that type -- `{ label, value }` pairs, because "nil" and "a table" are the same
-- kind of test but tell you different things when one of them gets through.
local function attacks(value: any, instances: { Instance }): { { label: string, value: any } }
	local kind = typeof(value)

	if kind == "number" then
		return {
			{ label = "negative", value = -math.abs(value) - 1 },
			{ label = "huge", value = math.huge },
			{ label = "nan", value = 0 / 0 },
			{ label = "past 2^53", value = 2 ^ 53 },
			{ label = "string instead of number", value = tostring(value) },
		}
	end
	if kind == "string" then
		return {
			{ label = "empty string", value = "" },
			{ label = "10k string", value = HUGE_STRING },
			{ label = "number instead of string", value = 0 },
			{ label = "unknown name", value = `{value}_NOPE` },
		}
	end
	if kind == "boolean" then
		return {
			{ label = "flipped", value = not value },
			{ label = "number instead of boolean", value = 1 },
		}
	end
	if kind == "Instance" then
		local swaps: { { label: string, value: any } } = {}
		for _ = 1, math.min(3, #instances) do
			local other = instances[math.random(1, #instances)]
			table.insert(swaps, { label = `someone else's {other.ClassName}`, value = other })
		end
		table.insert(swaps, { label = "string instead of instance", value = (value :: Instance):GetFullName() })
		return swaps
	end
	if kind == "table" then
		return {
			{ label = "empty table", value = {} },
			{ label = "number instead of table", value = 0 },
			{ label = "huge table", value = table.create(10000, 1) },
		}
	end
	if kind == "Vector3" then
		return {
			{ label = "far away", value = Vector3.new(1e9, 1e9, 1e9) },
			{ label = "nan vector", value = Vector3.new(0 / 0, 0, 0) },
			{ label = "number instead of vector", value = 0 },
		}
	end

	return { { label = "junk", value = junk() } }
end

-- Every way this particular call can be broken, one break at a time. One argument changed per
-- variant on purpose: if two are wrong you learn which check fired, not which is missing.
function Exploit.Variants(args: { any }, count: number?): { Variant }
	local width = count or #args
	local instances = pool()
	local variants: { Variant } =
		{ { label = "unchanged", args = copy(args, width), count = width, suspicious = false } }

	for index = 1, width do
		local original = args[index]
		local label = `arg {index} ({typeof(original)})`

		local dropped = copy(args, width)
		dropped[index] = nil
		table.insert(variants, { label = `{label}: nil`, args = dropped, count = width, suspicious = true })

		for _, attack in attacks(original, instances) do
			local changed = copy(args, width)
			changed[index] = attack.value
			table.insert(
				variants,
				{ label = `{label}: {attack.label}`, args = changed, count = width, suspicious = true }
			)
		end
	end

	table.insert(variants, { label = "no arguments at all", args = {}, count = 0, suspicious = true })
	if width > 0 then
		local extra = copy(args, width)
		extra[width + 1] = junk()
		table.insert(variants, { label = "one extra argument", args = extra, count = width + 1, suspicious = true })
	end

	return variants
end

-- `verdict` is the reading, not the raw result. A handler that *throws* on a broken argument is
-- doing its job; the leads are the broken ones it *accepted*. So:
--   "rejected"  -- suspicious variant threw. Good. The check fired.
--   "served"    -- RemoteFunction handed back a value for a variant it should have refused. This is
--                  the confirmed one: you can see it did the wrong thing from the client alone.
--   "accepted"  -- RemoteEvent took a variant with no complaint. Nothing comes back, so this is a
--                  lead, not proof -- pair it with a server state read to see what it did.
--   "baseline"  -- the unchanged real call. Context, not a finding.
export type Attempt = { label: string, ok: boolean, detail: string, verdict: string }

local function verdictOf(variant: Variant, ok: boolean, answered: boolean): string
	if not variant.suspicious then
		return "baseline"
	end
	if not ok then
		return "rejected"
	end
	return if answered then "served" else "accepted"
end

-- Fires every variant once and judges what came back. This is the tailored half: the arguments are
-- the game's own, so the handler gets far enough in to be interesting.
function Exploit.Tailor(remote: Instance, args: { any }, count: number?): ({ Attempt }?, string?)
	local problem = guard(remote)
	if problem then
		return nil, problem
	end

	local isFunction = remote:IsA("RemoteFunction")
	local attempts: { Attempt } = {}
	for _, variant in Exploit.Variants(args, count) do
		local ok, produced = fire(remote, variant.args, variant.count)
		local answered = isFunction and ok and produced ~= nil
		local detail = if not ok
			then tostring(produced)
			elseif isFunction then `returned {Serialize.Render(produced)}`
			else "sent"
		table.insert(attempts, {
			label = variant.label,
			ok = ok,
			detail = detail,
			verdict = verdictOf(variant, ok, answered),
		})
		task.wait()
	end
	return attempts, nil
end

export type Verdict = {
	remote: string,
	abusable: boolean,
	served: number,
	accepted: number,
	rejected: number,
	attempts: { Attempt },
}

-- Tailor plus the one-line reading: is this remote abusable from the client, and how. "Abusable"
-- means at least one variant the server should have refused went through -- served (proven) or
-- accepted (lead). A remote that rejected everything suspicious is one that validates.
function Exploit.Abuse(remote: Instance, args: { any }, count: number?): (Verdict?, string?)
	local attempts, problem = Exploit.Tailor(remote, args, count)
	if not attempts then
		return nil, problem
	end
	local served, accepted, rejected = 0, 0, 0
	for _, attempt in attempts do
		if attempt.verdict == "served" then
			served += 1
		elseif attempt.verdict == "accepted" then
			accepted += 1
		elseif attempt.verdict == "rejected" then
			rejected += 1
		end
	end
	return {
		remote = remote:GetFullName(),
		abusable = served > 0 or accepted > 0,
		served = served,
		accepted = accepted,
		rejected = rejected,
		attempts = attempts,
	},
		nil
end

export type Target = { remote: string, args: { any }?, count: number?, severity: string?, kind: string? }

-- The client end of the loop: take the harsh remotes Audit picked (crossed through ctx with their
-- captured arguments), abuse each, and rank the ones that actually broke to the top. Served beats
-- accepted beats nothing; Audit's severity breaks ties. This is the single call that turns "the
-- code looks exploitable here" into "and from the client it is, like this".
function Exploit.AbuseAll(targets: { Target }): string
	if type(targets) ~= "table" or #targets == 0 then
		return "no targets -- run Audit.Scan on the server first and cross Audit.Harsh (with each remote's captured args) through ctx"
	end

	type Row = { verdict: Verdict, target: Target }
	local rows: { Row } = {}
	local skipped: { string } = {}

	for _, target in targets do
		local resolved = Path.Resolve(target.remote)
		if not resolved then
			table.insert(skipped, `{target.remote}: not in this DataModel`)
			continue
		end
		local args, count = Portable.RestoreArgs(target.args or {})
		local verdict, problem = Exploit.Abuse(resolved, args, count)
		if not verdict then
			table.insert(skipped, `{target.remote}: {problem}`)
			continue
		end
		table.insert(rows, { verdict = verdict, target = target })
	end

	local function score(row: Row): number
		return row.verdict.served * 1000 + row.verdict.accepted * 10 + (RANK[row.target.severity or ""] or 0)
	end
	table.sort(rows, function(a, b)
		return score(a) > score(b)
	end)

	local lines: { string } = {}
	for _, row in rows do
		local v = row.verdict
		local tag = if v.served > 0
			then "ABUSABLE (served)"
			elseif v.accepted > 0 then "abusable (accepted, check state)"
			else "held up"
		local from = if row.target.kind then ` [{row.target.severity or "?"}: {row.target.kind}]` else ""
		table.insert(
			lines,
			`  {tag}{from} {v.remote} -- {v.served} served, {v.accepted} accepted silently, {v.rejected} rejected`
		)
		for _, attempt in v.attempts do
			if attempt.verdict == "served" or attempt.verdict == "accepted" then
				table.insert(lines, `      {attempt.verdict}: {attempt.label} -> {attempt.detail}`)
			end
		end
	end
	for _, note in skipped do
		table.insert(lines, `  skipped {note}`)
	end

	if #lines == 0 then
		return "nothing to report"
	end
	return `abused {#rows} target(s), worst first:\n{table.concat(lines, "\n")}`
end

-- Fire one exact payload many times and count what stuck. The impact step: once a variant is known
-- to go through (a huge grant amount, another player's part), hammer it and pair it with a server
-- read before/after to turn "accepted" into "gave me 5,000,000 cash" or "deleted their base".
function Exploit.Repeat(remote: Instance, args: { any }, count: number?, times: number?): (Report?, string?)
	local problem = guard(remote)
	if problem then
		return nil, problem
	end
	local width = count or #args
	return Bench.Run(function()
		fire(remote, args, width)
	end, { times = times or 200, perFrame = 20 }), nil
end

-- The whole loop in one call: shapes captured on the server (Remotes.Shapes, crossed through ctx),
-- every remote in them replayed and broken here on the client.
function Exploit.FromTraffic(shapes: { any }): string
	if type(shapes) ~= "table" or #shapes == 0 then
		return "no captured traffic -- watch the remotes on the server first, and make the game send something"
	end

	local lines: { string } = {}
	for _, shape in shapes do
		local resolved = Path.Resolve(shape.remote)
		if not resolved then
			table.insert(lines, `{shape.remote}: not in this DataModel`)
			continue
		end

		local args, count = Portable.RestoreArgs(shape.sample or {})
		local attempts, problem = Exploit.Tailor(resolved, args, count)
		if not attempts then
			return problem :: string
		end

		local interesting = {}
		for _, attempt in attempts do
			if attempt.verdict == "served" or attempt.verdict == "accepted" then
				table.insert(interesting, `    {attempt.verdict}: {attempt.label} -> {attempt.detail}`)
			end
		end

		table.insert(
			lines,
			`  {shape.remote} ({#attempts} variants, signature: {table.concat(shape.signature or {}, ", ")})`
		)
		if #interesting > 0 then
			table.insert(lines, table.concat(interesting, "\n"))
		else
			table.insert(lines, "    every suspicious variant was rejected -- this one validates")
		end
	end

	return `replayed and broke the game's own traffic:\n{table.concat(lines, "\n")}`
end

Exploit.Summarise = Bench.Summarise

return Exploit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Instrument</string>
          <string name="Source"><![CDATA[--!strict
--!optimize 2

-- Puts a debug.profilebegin/profileend scope around every named function in a script, so one
-- capture says which function in a module the time went to -- the engine only ever reports
-- "$Script" on its own.
--
-- The end has to run on every way out, so each `return` that belongs to the function is rewritten
-- as `do debug.profileend() return ... end` (a `return` is always the last statement in its block,
-- so wrapping it in do/end is always legal) and one more profileend goes before the closing `end`
-- for the fall-through case. Errors leave the scope open; the engine closes it when the thread
-- ends, which is fine for a profile and wrong for nothing else.

local LuauScan = require(script.Parent.LuauScan)

local Instrument = {}

local BLOCK_CLOSERS = { ["end"] = true, ["else"] = true, ["elseif"] = true, ["until"] = true, [";"] = true }
local BLOCK_OPENERS = { ["function"] = true, ["if"] = true, ["do"] = true, ["repeat"] = true }

type Edit = { at: number, text: string, sequence: number? }

-- Index of the last token of the return statement starting at `from`. A `function`, `do` or
-- `repeat` inside the expression is balanced so its `end` isn't taken for the block's; an
-- if-expression has no `end` of its own.
local function returnEnd(tokens: { LuauScan.Token }, from: number): number
	local depth = 0
	local index = from + 1
	while index <= #tokens do
		local token = tokens[index]
		local text = token.text
		if token.kind == "keyword" and BLOCK_OPENERS[text] then
			-- `if` as an expression has no `end`; only a `function`, `do` or `repeat` opens here.
			if text ~= "if" then
				depth += 1
			end
		elseif depth > 0 and (text == "end" or text == "until") then
			depth -= 1
		elseif depth == 0 and BLOCK_CLOSERS[text] then
			return index - 1
		end
		index += 1
	end
	return #tokens
end

-- Rewrites `source` and returns it with the list of labels it introduced. Anonymous functions
-- (event handlers, callbacks) are skipped: they have no name to label, and a name is the point.
function Instrument.Functions(source: string, prefix: string): (string, { string })
	local scan = LuauScan.Scan(source)
	local tokens = scan.tokens
	local edits: { Edit } = {}
	local labels: { string } = {}
	local functionOf: { [number]: number } = {}

	for blockIndex, block in scan.blocks do
		if block.kind ~= "function" or not block.close or not block.body or block.name == "" then
			continue
		end
		local name = (block.name :: string):gsub("^local ", "")
		local label = `{prefix}.{name}`
		table.insert(labels, label)
		functionOf[blockIndex] = #labels

		local bodyToken = tokens[block.body :: number]
		local closeToken = tokens[block.close :: number]
		table.insert(edits, { at = bodyToken.start, text = `debug.profilebegin({string.format("%q", label)}) ` })
		table.insert(edits, { at = closeToken.start, text = "debug.profileend() " })
	end

	for index, token in tokens do
		if token.text ~= "return" or token.kind ~= "keyword" then
			continue
		end
		local owner = LuauScan.Enclosing(scan, index, "function")
		if not owner then
			continue
		end
		local ownerIndex = table.find(scan.blocks, owner) :: number
		if not functionOf[ownerIndex] then
			continue
		end
		local last = returnEnd(tokens, index)
		table.insert(edits, { at = token.start, text = "do debug.profileend() " })
		table.insert(edits, { at = tokens[last].stop + 1, text = " end" })
	end

	-- Same offset, same order they were added: a begin before an end on an empty body, " end"
	-- before the fall-through profileend when a return sits right at the close.
	for sequence, edit in edits do
		edit.sequence = sequence
	end
	table.sort(edits, function(a, b)
		if a.at ~= b.at then
			return a.at < b.at
		end
		return a.sequence < b.sequence
	end)
	local pieces = {}
	local cursor = 1
	for _, edit in edits do
		table.insert(pieces, string.sub(source, cursor, edit.at - 1))
		table.insert(pieces, edit.text)
		cursor = edit.at
	end
	table.insert(pieces, string.sub(source, cursor))
	local out = table.concat(pieces)
	return out, labels
end

return Instrument
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">Lint</string>
          <string name="Source"><![CDATA[--!strict
--!optimize 2

-- Finds the shapes that cost frame time, with the context that makes them cost it: a
-- GetDescendants is a fact, a GetDescendants inside a Heartbeat handler is a finding. Everything
-- here is a token pattern plus "which block is it in", so it's fast and it's shallow -- it hands
-- the profiler a shortlist, it doesn't replace it.

local LuauScan = require(script.Parent.LuauScan)

local Lint = {}

export type Finding = {
	line: number,
	-- high | medium | low
	severity: string,
	pattern: string,
	-- per-frame | hot-event | loop | function | top
	context: string,
	detail: string,
}

local PER_FRAME = {
	Heartbeat = true,
	RenderStepped = true,
	Stepped = true,
	PreRender = true,
	PreSimulation = true,
	PostSimulation = true,
	PreAnimation = true,
	BindToRenderStep = true,
}
local HOT_EVENT = { Touched = true, TouchEnded = true, Changed = true, GetPropertyChangedSignal = true }

local TREE_WALKS =
	{ GetDescendants = true, GetChildren = true, FindFirstChildWhichIsA = true, FindFirstChildOfClass = true }
local ALLOCATORS = { Clone = true }
local PHYSICS_QUERIES = {
	Raycast = true,
	Blockcast = true,
	Spherecast = true,
	Shapecast = true,
	GetPartBoundsInBox = true,
	GetPartBoundsInRadius = true,
	GetPartsInPart = true,
}
local LEGACY = { wait = "wait", spawn = "spawn", delay = "delay" }

-- What the innermost meaningful block around a token is. Loops beat functions because a loop
-- inside a per-frame handler is worse than the handler, and the label says so either way.
local function contextOf(scan: LuauScan.Scan, index: number): (string, string?)
	local at = scan.blockOf[index]
	local sawLoop = false
	local sawFunction = false
	while at do
		local block = scan.blocks[at]
		if block.kind == "loop" or block.kind == "repeat" then
			sawLoop = true
		elseif block.kind == "function" then
			local connect = block.connect
			if connect and PER_FRAME[connect] then
				return "per-frame", connect
			end
			if connect and HOT_EVENT[connect] then
				return "hot-event", connect
			end
			-- A handler wrapped in a named function connected elsewhere isn't traced; the loop
			-- inside a function is still the more useful label.
			if sawLoop then
				return "loop", nil
			end
			-- Keep walking: an anonymous function inside a Heartbeat handler still counts.
			sawFunction = true
			at = block.parent
			continue
		end
		at = block.parent
	end
	return if sawLoop then "loop" elseif sawFunction then "function" else "top", nil
end

local function inFunction(scan: LuauScan.Scan, index: number): boolean
	return LuauScan.Enclosing(scan, index, "function") ~= nil
end

-- Depth of a `game.A.B.C` / `workspace.A.B.C` chain starting at token `index`.
local function pathDepth(tokens: { LuauScan.Token }, index: number): number
	local depth = 0
	local at = index + 1
	while tokens[at] and tokens[at].text == "." and tokens[at + 1] and tokens[at + 1].kind == "name" do
		depth += 1
		at += 2
	end
	return depth
end

local function literalArgs(tokens: { LuauScan.Token }, paren: number): boolean
	local at = paren + 1
	while tokens[at] and tokens[at].text ~= ")" do
		local token = tokens[at]
		if not (token.kind == "number" or token.text == "," or token.text == "-") then
			return false
		end
		at += 1
	end
	return tokens[at] ~= nil
end

function Lint.Script(source: string): { Finding }
	local scan = LuauScan.Scan(source)
	local tokens = scan.tokens
	local findings: { Finding } = {}

	local function add(index: number, severity: string, pattern: string, detail: string)
		local context, signal = contextOf(scan, index)
		table.insert(findings, {
			line = tokens[index].line,
			severity = severity,
			pattern = pattern,
			context = if signal then `{context} ({signal})` else context,
			detail = detail,
		})
	end

	-- Severity for a thing that's bad in proportion to how often it runs.
	local function rate(index: number, whenHot: string, whenLoop: string, otherwise: string?): string?
		local context = contextOf(scan, index)
		if context == "per-frame" or context == "hot-event" then
			return whenHot
		end
		if context == "loop" then
			return whenLoop
		end
		return otherwise
	end

	for index, token in tokens do
		local text = token.text
		local previous = tokens[index - 1]
		local following = tokens[index + 1]
		local method = previous and previous.text == ":"
		local call = following and following.text == "("

		if token.kind == "name" and method and call then
			if TREE_WALKS[text] then
				local severity = rate(index, "high", "high", if inFunction(scan, index) then "low" else nil)
				if severity then
					add(index, severity, "tree walk", `{text}() walks the tree every time this runs`)
				end
			elseif text == "FindFirstChild" then
				-- Recursive form: FindFirstChild(name, true)
				local comma = tokens[index + 3]
				local flag = tokens[index + 4]
				if comma and comma.text == "," and flag and flag.text == "true" then
					local severity = rate(index, "high", "high", "medium")
					add(index, severity :: string, "tree walk", "FindFirstChild(name, true) is a recursive search")
				end
			elseif ALLOCATORS[text] then
				local severity = rate(index, "high", "medium", nil)
				if severity then
					add(index, severity, "allocation", `:{text}() creates instances each time this runs`)
				end
			elseif PHYSICS_QUERIES[text] then
				local severity = rate(index, "medium", "medium", nil)
				if severity then
					add(index, severity, "physics query", `:{text}() per run; check the params filter and MaxParts`)
				end
			elseif text == "FireAllClients" or text == "FireClient" or text == "FireServer" then
				local severity = rate(index, "high", "medium", nil)
				if severity then
					add(index, severity, "network", `:{text}() at this rate is a replication cost every frame`)
				end
			elseif text == "Create" and previous and tokens[index - 2] and tokens[index - 2].text == "TweenService" then
				local severity = rate(index, "medium", "low", nil)
				if severity then
					add(index, severity, "allocation", "TweenService:Create per run; reuse tweens or tween once")
				end
			elseif text == "GetService" then
				local severity = rate(index, "low", "low", nil)
				if severity then
					add(index, severity, "hoist", "GetService inside a hot path; hoist to the top of the script")
				end
			elseif text == "Connect" or text == "ConnectParallel" then
				local severity = rate(index, "high", "medium", nil)
				if severity then
					add(index, severity, "leak", "a new connection made each run; these accumulate")
				end
			end
		elseif token.kind == "name" and text == "new" and previous and previous.text == "." and call then
			local owner = tokens[index - 2]
			if owner and owner.text == "Instance" then
				local severity = rate(index, "high", "medium", nil)
				if severity then
					add(index, severity, "allocation", "Instance.new each time this runs")
				end
			elseif
				owner
				and (
					owner.text == "Vector3"
					or owner.text == "CFrame"
					or owner.text == "Color3"
					or owner.text == "UDim2"
				)
			then
				if literalArgs(tokens, index + 1) then
					local severity = rate(index, "low", "low", nil)
					if severity then
						add(index, severity, "hoist", `{owner.text}.new with constant arguments; build it once outside`)
					end
				end
			end
		elseif
			token.kind == "name"
			and LEGACY[text]
			and call
			and not (previous and (previous.text == "." or previous.text == ":"))
		then
			add(index, "medium", "legacy scheduler", `{text}() -- use task.{LEGACY[text]}`)
		elseif token.kind == "name" and text == "require" and call and inFunction(scan, index) then
			add(index, "low", "hoist", "require inside a function; move it to the top of the script")
		elseif token.kind == "name" and (text == "game" or text == "workspace") and inFunction(scan, index) then
			local depth = pathDepth(tokens, index)
			if depth >= 3 then
				local severity = rate(index, "medium", "medium", "low")
				add(index, severity :: string, "deep path", `{depth}-segment path lookup each run; cache the instance`)
			end
		elseif token.kind == "name" and text == "format" and previous and previous.text == "." then
			local owner = tokens[index - 2]
			if owner and owner.text == "string" and contextOf(scan, index) == "per-frame" then
				add(index, "low", "allocation", "string.format every frame allocates a new string")
			end
		elseif token.kind == "op" and text == ".." then
			local severity = rate(index, "medium", "low", nil)
			if severity then
				add(index, severity, "allocation", "string concat in a hot path; each .. makes a new string")
			end
		elseif token.kind == "name" and text == "pcall" and call then
			local severity = rate(index, "low", "low", nil)
			if severity then
				add(index, severity, "call overhead", "pcall per run; wrap the batch instead of the element")
			end
		elseif token.kind == "keyword" and text == "while" and following and following.text == "true" then
			add(
				index,
				"medium",
				"polling loop",
				"while true do ... wait -- an event would run only when something changes"
			)
		elseif token.kind == "name" and text == "GetPropertyChangedSignal" and call then
			local argument = tokens[index + 2]
			if
				argument
				and (argument.text == '"CFrame"' or argument.text == '"Position"' or argument.text == '"Velocity"')
			then
				add(index, "medium", "hot event", `{argument.text} changes every physics step for a moving part`)
			end
		elseif token.kind == "keyword" and text == "function" and following and following.text == "(" then
			local block = scan.blocks[scan.blockOf[index + 1] :: number]
			if block and block.connect and HOT_EVENT[block.connect] and block.connect ~= "GetPropertyChangedSignal" then
				add(index, "low", "hot event", `{block.connect} handler; fires far more often than it looks`)
			end
		end
	end

	return findings
end

local RANK = { high = 3, medium = 2, low = 1 }

-- Worst first, then by line.
function Lint.Sort(findings: { Finding })
	table.sort(findings, function(a, b)
		local ra, rb = RANK[a.severity], RANK[b.severity]
		if ra ~= rb then
			return ra > rb
		end
		return a.line < b.line
	end)
end

Lint.Rank = RANK

return Lint
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Load</string>
          <string name="Source"><![CDATA[--!strict

-- Makes a test client behave like a player for a while, so a profile taken meanwhile has real
-- movement, animation, replication and remote traffic in it -- and with several clients doing
-- it at once, the per-player loops that only blow up at eight players show up at eight players.
--
-- Client-side only: it drives `input`, the timeline's real input path, and fires remotes the way
-- the game's own UI would.

local Load = {}

export type RemoteSpec = { remote: Instance, args: { any }?, perSecond: number? }

export type Options = {
	-- Seconds to keep going. Defaults to 5.
	seconds: number?,
	-- Remotes to fire while wandering, each with the arguments to send and how often per second.
	remotes: { RemoteSpec }?,
	-- Chance per step of a jump. Defaults to 0.15.
	jump: number?,
	-- Seed, so eight clients don't all walk the same line. Defaults to the peer index if the
	-- caller passes it, else time.
	seed: number?,
}

local MOVE_KEYS = { "W", "A", "S", "D" }

-- Walks, turns, jumps and fires remotes until `seconds` are up. `input` is the timeline's input
-- object for this client event. Returns how many steps and remote calls were made.
function Load.Wander(input: any, options: Options?): { steps: number, remoteCalls: number }
	local settings: Options = options or {}
	local random = Random.new(settings.seed or math.floor(os.clock() * 1000))
	local deadline = os.clock() + (settings.seconds or 5)
	local jumpChance = settings.jump or 0.15
	local remotes: { RemoteSpec } = settings.remotes or {}
	local nextFire: { number } = {}
	for index in remotes do
		nextFire[index] = 0
	end

	local steps, remoteCalls = 0, 0
	local held: string? = nil
	while os.clock() < deadline do
		local key = MOVE_KEYS[random:NextInteger(1, #MOVE_KEYS)]
		if held then
			input:Release(held)
		end
		input:Hold(key)
		held = key
		if random:NextNumber() < jumpChance then
			input:Tap("Space", 0.05)
		end
		steps += 1

		local now = os.clock()
		for index, spec in remotes do
			if now < nextFire[index] then
				continue
			end
			nextFire[index] = now + 1 / (spec.perSecond or 2)
			local remote: any = spec.remote
			local args = spec.args or {}
			local ok = pcall(function()
				if remote:IsA("RemoteEvent") or remote:IsA("UnreliableRemoteEvent") then
					remote:FireServer(table.unpack(args))
				elseif remote:IsA("RemoteFunction") then
					remote:InvokeServer(table.unpack(args))
				end
			end)
			if ok then
				remoteCalls += 1
			end
		end

		task.wait(random:NextNumber(0.2, 0.7))
	end
	if held then
		input:Release(held)
	end
	return { steps = steps, remoteCalls = remoteCalls }
end

return Load
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">LuauScan</string>
          <string name="Source"><![CDATA[--!strict
--!native
--!optimize 2

-- A token stream for Luau source with block structure on top: which function, loop or `if` each
-- token sits inside. Not a parser -- it knows nothing about expressions -- but it's exactly enough
-- to answer "is this call inside a per-frame handler" (Lint) and "where does this function's body
-- start, and which returns are its own" (Instrument) without either of them lexing strings and
-- comments themselves.

local LuauScan = {}

export type Token = {
	kind: "name" | "keyword" | "number" | "string" | "op",
	text: string,
	line: number,
	-- Byte range in the source, inclusive.
	start: number,
	stop: number,
}

export type Block = {
	-- function | loop | if | do | repeat
	kind: string,
	-- Index of the opening token (the `function`, `do`, `if`, `repeat`, or the `while`/`for`).
	open: number,
	-- Index of the closing `end`/`until`, filled in when it's found.
	close: number?,
	-- Functions only: the declared name ("Combat.ResolveHit", "local step", "" for anonymous),
	-- and the signal name when it's the argument of `:Connect(` ("Heartbeat").
	name: string?,
	connect: string?,
	-- Functions only: index of the first token of the body.
	body: number?,
	parent: number?,
}

export type Scan = {
	tokens: { Token },
	blocks: { Block },
	-- blockOf[i] is the index into blocks of the innermost block containing token i, or nil at
	-- top level.
	blockOf: { number? },
}

local KEYWORDS = {}
for _, word in
	{
		"and",
		"break",
		"do",
		"else",
		"elseif",
		"end",
		"false",
		"for",
		"function",
		"if",
		"in",
		"local",
		"nil",
		"not",
		"or",
		"repeat",
		"return",
		"then",
		"true",
		"until",
		"while",
		"continue",
	}
do
	KEYWORDS[word] = true
end

-- Longest first, so `...` beats `..` beats `.`.
local OPS = {
	"...",
	"..=",
	"//=",
	"..",
	"==",
	"~=",
	"<=",
	">=",
	"->",
	"::",
	"+=",
	"-=",
	"*=",
	"/=",
	"%=",
	"^=",
	"//",
	"+",
	"-",
	"*",
	"/",
	"%",
	"^",
	"#",
	"=",
	"<",
	">",
	"(",
	")",
	"{",
	"}",
	"[",
	"]",
	";",
	":",
	",",
	".",
	"?",
	"|",
	"&",
}

local function longBracketLevel(source: string, at: number): number?
	-- `[` then `=`* then `[`
	if string.byte(source, at) ~= 91 then
		return nil
	end
	local index = at + 1
	local level = 0
	while string.byte(source, index) == 61 do
		level += 1
		index += 1
	end
	return if string.byte(source, index) == 91 then level else nil
end

local function closeLongBracket(source: string, from: number, level: number): number
	local pattern = "]" .. string.rep("=", level) .. "]"
	local _, stop = string.find(source, pattern, from, true)
	return stop or #source
end

function LuauScan.Tokenize(source: string): { Token }
	local tokens: { Token } = {}
	local index = 1
	local length = #source
	local line = 1

	local function push(kind: string, start: number, stop: number)
		table.insert(tokens, {
			kind = kind :: any,
			text = string.sub(source, start, stop),
			line = line,
			start = start,
			stop = stop,
		})
	end

	while index <= length do
		local byte = string.byte(source, index)

		if byte == 10 then
			line += 1
			index += 1
			continue
		end
		if byte == 32 or byte == 9 or byte == 13 then
			index += 1
			continue
		end

		-- Comments, line and block. Newlines inside still count.
		if byte == 45 and string.byte(source, index + 1) == 45 then
			local level = longBracketLevel(source, index + 2)
			local stop
			if level then
				stop = closeLongBracket(source, index + 2, level)
			else
				stop = (string.find(source, "\n", index, true) or length + 1) - 1
			end
			for _ in string.gmatch(string.sub(source, index, stop), "\n") do
				line += 1
			end
			index = stop + 1
			continue
		end

		-- Strings: quoted, backtick (interpolated -- treated as opaque), long bracket.
		if byte == 34 or byte == 39 or byte == 96 then
			local quote = byte
			local at = index + 1
			while at <= length do
				local current = string.byte(source, at)
				if current == 92 then
					at += 2
					continue
				end
				if current == quote then
					break
				end
				if current == 10 then
					line += 1
				end
				at += 1
			end
			push("string", index, math.min(at, length))
			index = at + 1
			continue
		end
		local level = longBracketLevel(source, index)
		if level then
			local stop = closeLongBracket(source, index, level)
			for _ in string.gmatch(string.sub(source, index, stop), "\n") do
				line += 1
			end
			push("string", index, stop)
			index = stop + 1
			continue
		end

		-- Names and keywords.
		if (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or byte == 95 then
			local _, stop = string.find(source, "^[%w_]+", index)
			local text = string.sub(source, index, stop :: number)
			push(if KEYWORDS[text] then "keyword" else "name", index, stop :: number)
			index = (stop :: number) + 1
			continue
		end

		-- Numbers, loosely: 0x..., 1e-5, 1_000, 3.5
		if
			byte >= 48 and byte <= 57
			or (
				byte == 46
				and (string.byte(source, index + 1) or 0) >= 48
				and (string.byte(source, index + 1) or 0) <= 57
			)
		then
			local _, stop = string.find(source, "^[%w_%.]+", index)
			-- `1e-5`: the sign belongs to the number.
			local tail = string.byte(source, (stop :: number) + 1)
			if (string.match(string.sub(source, index, stop :: number), "[eE]$")) and (tail == 45 or tail == 43) then
				local _, more = string.find(source, "^[%d_]+", (stop :: number) + 2)
				stop = more or (stop :: number) + 1
			end
			push("number", index, stop :: number)
			index = (stop :: number) + 1
			continue
		end

		local matched = false
		for _, op in OPS do
			if string.sub(source, index, index + #op - 1) == op then
				push("op", index, index + #op - 1)
				index += #op
				matched = true
				break
			end
		end
		if not matched then
			-- Something we don't know (unicode in an identifier, say). Skip the byte.
			index += 1
		end
	end

	return tokens
end

-- Tokens after which an `if` is an expression, not a statement.
local EXPRESSION_LEAD = { ["return"] = true, ["and"] = true, ["or"] = true, ["not"] = true, ["in"] = true }
local CLOSERS = { [")"] = true, ["}"] = true, ["]"] = true }

local STATEMENT_START = {
	["local"] = true,
	["if"] = true,
	["for"] = true,
	["while"] = true,
	["return"] = true,
	["do"] = true,
	["repeat"] = true,
	["function"] = true,
	["end"] = true,
	["break"] = true,
	["continue"] = true,
}

-- Where a function body starts, given the index of its `(`. Skips the parameter list and, if
-- there is one, the return type -- which has no terminator of its own, so this reads on until a
-- token that can only be the start of a statement.
local function bodyStart(tokens: { Token }, paren: number): number
	local depth = 0
	local index = paren
	while index <= #tokens do
		local text = tokens[index].text
		if text == "(" then
			depth += 1
		elseif text == ")" then
			depth -= 1
			if depth == 0 then
				break
			end
		end
		index += 1
	end
	index += 1
	local after = tokens[index]
	if not after or after.text ~= ":" then
		return index
	end
	-- A return type. Balance brackets; at depth 0 the body begins at a statement keyword, or at a
	-- name that directly follows something a type can end with.
	index += 1
	depth = 0
	while index <= #tokens do
		local token = tokens[index]
		local text = token.text
		if depth == 0 then
			if token.kind == "keyword" and STATEMENT_START[text] then
				return index
			end
			if token.kind == "name" or text == "(" then
				local previous = tokens[index - 1]
				if
					previous.kind == "name"
					or previous.kind == "number"
					or previous.text == ")"
					or previous.text == "}"
					or previous.text == "]"
					or previous.text == "?"
					or previous.text == ">"
				then
					return index
				end
			end
		end
		if text == "(" or text == "{" or text == "[" or text == "<" then
			depth += 1
		elseif text == ")" or text == "}" or text == "]" or text == ">" then
			depth -= 1
		end
		index += 1
	end
	return index
end

-- The declared name of a function statement, read backwards from its `function` keyword and
-- forwards to its `(`.
local function functionName(tokens: { Token }, at: number): string
	local parts = {}
	local index = at + 1
	while tokens[index] and tokens[index].text ~= "(" do
		table.insert(parts, tokens[index].text)
		index += 1
	end
	local name = table.concat(parts)
	local before = tokens[at - 1]
	if before and before.text == "local" then
		return `local {name}`
	end
	return name
end

-- The signal an anonymous function is connected to, when it's the first argument of `:Connect(`
-- / `:Once(` / `:ConnectParallel(`: the name just before the `:`.
local function connectedTo(tokens: { Token }, at: number): string?
	local paren = tokens[at - 1]
	local method = tokens[at - 2]
	local colon = tokens[at - 3]
	local signal = tokens[at - 4]
	if not (paren and paren.text == "(" and colon and colon.text == ":" and signal) then
		return nil
	end
	if
		method.text == "Connect"
		or method.text == "Once"
		or method.text == "ConnectParallel"
		or method.text == "BindToRenderStep"
	then
		return signal.text
	end
	return nil
end

function LuauScan.Scan(source: string): Scan
	local tokens = LuauScan.Tokenize(source)
	local blocks: { Block } = {}
	local blockOf: { number? } = table.create(#tokens)
	local stack: { number } = {}
	local pendingLoop = false

	local function open(kind: string, index: number): Block
		local block: Block = { kind = kind, open = index, parent = stack[#stack] }
		table.insert(blocks, block)
		table.insert(stack, #blocks)
		return block
	end

	for index, token in tokens do
		blockOf[index] = stack[#stack]
		if token.kind ~= "keyword" then
			continue
		end
		local text = token.text

		if text == "function" then
			local block = open("function", index)
			local next = tokens[index + 1]
			if next and next.text == "(" then
				block.name = ""
				block.connect = connectedTo(tokens, index)
				block.body = bodyStart(tokens, index + 1)
			else
				block.name = functionName(tokens, index)
				local paren = index + 1
				while tokens[paren] and tokens[paren].text ~= "(" do
					paren += 1
				end
				block.body = bodyStart(tokens, paren)
			end
		elseif text == "while" or text == "for" then
			pendingLoop = true
		elseif text == "do" then
			if pendingLoop then
				pendingLoop = false
				open("loop", index)
			else
				open("do", index)
			end
		elseif text == "if" then
			-- `x = if a then b else c` is an expression and has no `end`.
			local previous = tokens[index - 1]
			local expression = previous ~= nil
				and ((previous.kind == "op" and not CLOSERS[previous.text]) or EXPRESSION_LEAD[previous.text])
			if not expression then
				open("if", index)
			end
		elseif text == "repeat" then
			open("repeat", index)
		elseif text == "end" or text == "until" then
			local top = stack[#stack]
			if top then
				blocks[top].close = index
				table.remove(stack)
			end
		end
	end

	return { tokens = tokens, blocks = blocks, blockOf = blockOf }
end

-- The innermost enclosing block of `kind` for token `index`, walking parents.
function LuauScan.Enclosing(scan: Scan, index: number, kind: string): Block?
	local at = scan.blockOf[index]
	while at do
		local block = scan.blocks[at]
		if block.kind == kind then
			return block
		end
		at = block.parent
	end
	return nil
end

return LuauScan
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Profile</string>
          <string name="Source"><![CDATA[--!strict
--!native
--!optimize 2

-- MicroProfiler captures through LibMP (github.com/Roblox/libmp), and the reading of them.
--
-- LibMP is the user's module, not ours: it's a few hundred KB of Luau wrapping a WASM blob, so it
-- lives in the place (ReplicatedStorage.LibMP by convention) and this just finds and requires it.
-- The MicroProfiler is per process, so a capture sees every DataModel in that process -- run the
-- capture in the context whose scripts you're loading and the load shows up.
--
-- The last capture stays in `Profile.LastBuffer` so a run_luau snippet in the same context can
-- open it again with `vmcp.Profile.Session()` and dig deeper than the summary went.

local CollectionService = game:GetService("CollectionService")
local HttpService = game:GetService("HttpService")
local InsertService = game:GetService("InsertService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Bridge = require(script.Parent.Parent.Bridge)
local GameVm = require(script.Parent.Parent.Exec.GameVm)
local Inject = require(script.Parent.Parent.Exec.Inject)

local Profile = {}

-- The Creator Store asset LibMP's README points at.
local LIBMP_ASSET_ID = 109009378620272
local MAX_FRAME_LIMIT = 256
local DEFAULT_TOP = 15
local DEFAULT_CALLS = 500
local DEFAULT_SECONDS = 2
local DEFAULT_WARMUP = 5
local DEFAULT_FRAME_LIMIT = 128
local RESULT_NAME = "__VMCP_ProfileResult"
-- Base64 of the capture has to fit one socket message (VMCP_MAX_MESSAGE_MB, 8 by default).
local MAX_DUMP_BYTES = 4_500_000

Profile.LastBuffer = nil :: buffer?

export type TimerRow = {
	timerId: number,
	name: string,
	group: string,
	selfMs: number,
	inclusiveMs: number,
	count: number,
	maxMs: number,
	worstFrameMs: number,
	worstFrameId: number,
	worstFrameAbsoluteId: number,
}

export type FrameRow = {
	frameId: number,
	absoluteId: number,
	cpuMs: number,
	top: { { name: string, selfMs: number } },
}

export type Target = {
	label: string,
	setup: string,
	calls: number?,
	seconds: number?,
	perFrame: number?,
	warmup: number?,
}

export type HammerOptions = {
	vm: string?,
	-- What a plugin-VM setup sees as `vmcp`. Ignored for the game VM.
	env: any?,
	frameLimit: number?,
	top: number?,
	dump: boolean?,
	name: string?,
	-- Extra scope names to report alongside the targets' own labels (section labels, usually).
	labels: { string }?,
}

-- One target's outcome: the load line's facts plus the capture's report.
export type Outcome = {
	label: string,
	calls: number,
	errors: number,
	seconds: number,
	allocatedKbPerCall: number,
	report: Report?,
	error: string?,
}

export type Report = {
	frames: number,
	spanMs: number,
	frameMeanMs: number,
	frameP95Ms: number,
	frameMaxMs: number,
	frameMaxId: number,
	frameMaxAbsoluteId: number,
	heapStartMb: number?,
	heapEndMb: number?,
	labels: { TimerRow },
	top: { TimerRow },
	spikes: { FrameRow },
}

local cached: any = nil

-- The LibMP ModuleScript in this place, if there is one.
function Profile.Find(): ModuleScript?
	local direct = ReplicatedStorage:FindFirstChild("LibMP")
	if direct and direct:IsA("ModuleScript") then
		return direct
	end
	return game:QueryDescendants("ModuleScript#LibMP")[1] :: ModuleScript?
end

-- Requires LibMP, once. Returns the module table or the reason there isn't one.
function Profile.LibMP(): (any?, string?)
	if cached then
		return cached, nil
	end
	local module = Profile.Find()
	if not module then
		return nil,
			"LibMP isn't in this place. Put the LibMP ModuleScript in ReplicatedStorage (Creator Store "
				.. `asset {LIBMP_ASSET_ID}, or github.com/Roblox/libmp/releases), or pass installLibMP = true.`
	end
	local ok, lib = pcall(require, module)
	if not ok then
		return nil, `LibMP failed to load: {lib}`
	end
	if type(lib) ~= "table" or type(lib.Control) ~= "table" then
		return nil, `{module:GetFullName()} loaded but doesn't look like LibMP`
	end
	if not lib.Control:IsBackendReady() then
		return nil,
			"LibMP loaded but the MicroProfiler backend isn't reachable from here (version mismatch, "
				.. "or this build of Studio doesn't expose it)"
	end
	cached = lib
	return lib, nil
end

-- Edit mode only: pulls the module off the Creator Store into ReplicatedStorage. Tagged excludeLOC
-- so count_lines doesn't report LibMP as the biggest script in the game.
function Profile.Install(): (ModuleScript?, string?)
	local existing = Profile.Find()
	if existing then
		return existing, nil
	end
	local ok, container = pcall(InsertService.LoadAsset, InsertService, LIBMP_ASSET_ID)
	if not ok then
		return nil, `couldn't insert LibMP from the Creator Store: {container}`
	end
	local module = container:FindFirstChildWhichIsA("ModuleScript", true)
	if not module then
		container:Destroy()
		return nil, "the LibMP asset didn't contain a ModuleScript"
	end
	module.Name = "LibMP"
	module.Parent = ReplicatedStorage
	CollectionService:AddTag(module, "excludeLOC")
	container:Destroy()
	cached = nil
	return module, nil
end

-- Turns the profiler on, runs `load`, and snapshots the last `frameLimit` frames. The buffer is
-- what everything else reads; the live session is never touched after this.
function Profile.Capture(frameLimit: number?, load: () -> ()): (buffer?, string?)
	local lib, why = Profile.LibMP()
	if not lib then
		return nil, why
	end
	local control = lib.Control
	local limit = math.clamp(frameLimit or 128, 8, MAX_FRAME_LIMIT)

	control:EnableProfiler(true)
	control:SetFrameLimit(limit)
	control:EnableCapture(true)
	-- Two frames so the first frame of the load isn't also the frame the profiler woke up in.
	RunService.Heartbeat:Wait()
	RunService.Heartbeat:Wait()

	local ok, failure = pcall(load :: any)

	-- The last call's scope closes in the frame after it ran.
	RunService.Heartbeat:Wait()
	local captured, buf = pcall(function()
		return control:CaptureToBufferSync()
	end)
	if not ok then
		return nil, `the load errored: {failure}`
	end
	if not captured or typeof(buf) ~= "buffer" then
		return nil, `CaptureToBufferSync failed: {buf}`
	end
	Profile.LastBuffer = buf
	return buf, nil
end

-- A fresh session over the last capture (or a buffer you pass). Dispose it when you're done.
function Profile.Session(buf: buffer?): (any?, string?)
	local lib, why = Profile.LibMP()
	if not lib then
		return nil, why
	end
	local source = buf or Profile.LastBuffer
	if not source then
		return nil, "nothing captured yet -- run profile_scripts first"
	end
	local session = lib.Session.OpenFromBuffer(source)
	if not session or not session:IsValid() then
		return nil, "LibMP couldn't open the capture"
	end
	return session, nil
end

local function percentile(sorted: { number }, fraction: number): number
	if #sorted == 0 then
		return 0
	end
	return sorted[math.clamp(math.ceil(fraction * #sorted), 1, #sorted)]
end

-- Walks every CPU thread's log frame by frame and attributes each scope's time to the frame it ran
-- in -- the frame-local iteration from LibMP's own SKILL.md, plus a self-time pass on top, because
-- inclusive time makes every parent scope look as expensive as its slowest child.
type AnalyzeOptions = { labels: { string }?, top: number? }

function Profile.Analyze(buf: buffer, options: AnalyzeOptions?): (Report?, string?)
	local settings: AnalyzeOptions = options or {}
	local session, why = Profile.Session(buf)
	if not session then
		return nil, why
	end

	local tickToMs = session:FetchGlobalDesc().TickToMsCpu
	local frameMin = session:GetFrameIdMin()
	local frameMax = session:GetFrameIdMax()
	if frameMin == 0 and frameMax == 0 then
		session:Dispose()
		return nil, "the capture holds no frames"
	end

	local frameDescs: { [number]: any } = {}
	local frameTimes: { number } = {}
	local spanMs = 0
	for id = frameMin, frameMax do
		local desc = session:FetchFrameDesc(id)
		frameDescs[id] = desc
		local ms = (desc.TickEndCpu - desc.TickStartCpu) * tickToMs
		table.insert(frameTimes, ms)
		spanMs += ms
	end

	-- Per timer totals, and per frame per timer so spikes can say what filled them.
	local rows: { [number]: TimerRow } = {}
	local selfByFrame: { [number]: { [number]: number } } = {}
	local inclByFrame: { [number]: { [number]: number } } = {}
	-- childAcc[thread][level] is how much of the scope currently open at that level went to its
	-- children, so self = inclusive - children when it closes.
	local childAcc: { [number]: { [number]: number } } = {}

	local function rowFor(timerId: number): TimerRow
		local known = rows[timerId]
		if known then
			return known
		end
		local desc = session:FetchTimerDesc(timerId)
		local groupOk, group = pcall(function()
			return session:FetchGroupDesc(desc.GroupId).GroupName
		end)
		local row: TimerRow = {
			timerId = timerId,
			name = desc.TimerName,
			group = if groupOk then group else "?",
			selfMs = 0,
			inclusiveMs = 0,
			count = 0,
			maxMs = 0,
			worstFrameMs = 0,
			worstFrameId = 0,
			worstFrameAbsoluteId = 0,
		}
		rows[timerId] = row
		return row
	end

	local function account(
		frameId: number,
		threadId: number,
		level: number,
		timerId: number,
		ms: number,
		closed: boolean
	)
		local acc = childAcc[threadId]
		if not acc then
			acc = {}
			childAcc[threadId] = acc
		end
		local children = acc[level + 1] or 0
		acc[level + 1] = 0
		acc[level] = (acc[level] or 0) + ms
		local selfMs = math.max(ms - children, 0)

		local row = rowFor(timerId)
		row.inclusiveMs += ms
		row.selfMs += selfMs
		if closed then
			row.count += 1
			if ms > row.maxMs then
				row.maxMs = ms
			end
		end

		local frameSelf = selfByFrame[frameId]
		if not frameSelf then
			frameSelf = {}
			selfByFrame[frameId] = frameSelf
			inclByFrame[frameId] = {}
		end
		frameSelf[timerId] = (frameSelf[timerId] or 0) + selfMs
		local frameIncl = inclByFrame[frameId]
		frameIncl[timerId] = (frameIncl[timerId] or 0) + ms
	end

	local iter = session:CreateLogIterator()
	iter:Configure({ SkipGpuThreads = true, SkipEvents = true, EmitThreadFrameEnd = true })
	local state = iter:GetState()
	iter:RewindTo(frameMin, frameMax)

	while iter:Step() do
		if state:IsThreadFrameEnd() then
			local frameId = state:FrameId()
			local threadId = state:ThreadId()
			local exitAt = state:Timestamp()
			local depth = state:ThreadStackDepth()
			for level = depth - 1, 0, -1 do
				local element = iter:GetCurrentThreadStackElement(level)
				if element then
					local ms = (exitAt - element:EnterTimestampFrameLocal()) * tickToMs
					account(frameId, threadId, level, element:EnterTimerId(), ms, false)
				end
			end
			-- Whatever is still open starts the next frame with no children counted against it.
			childAcc[threadId] = nil
		elseif state:IsExit() and not state:ThreadStackWasOverflowed() then
			local frameId = state:FrameId()
			local depth = state:ThreadStackDepth()
			local enterAt
			if state:ThreadStackIsUnderflowed() then
				enterAt = frameDescs[frameId].TickStartCpu
			else
				enterAt = iter:GetCurrentThreadStackElement(depth):EnterTimestampFrameLocal()
			end
			local ms = (state:Timestamp() - enterAt) * tickToMs
			account(frameId, state:ThreadId(), depth, state:TimerId(), ms, true)
		end
	end
	iter:Dispose()

	-- Worst single frame for every timer, by inclusive time -- that's the number that maps to a
	-- hitch a player felt.
	for frameId, perTimer in inclByFrame do
		local desc = frameDescs[frameId]
		for timerId, ms in perTimer do
			local row = rows[timerId]
			if ms > row.worstFrameMs then
				row.worstFrameMs = ms
				row.worstFrameId = frameId
				row.worstFrameAbsoluteId = desc.FrameAbsoluteId
			end
		end
	end

	local all: { TimerRow } = {}
	for _, row in rows do
		table.insert(all, row)
	end
	table.sort(all, function(a, b)
		return a.selfMs > b.selfMs
	end)

	local wanted: { [string]: boolean } = {}
	for _, label in settings.labels or ({} :: { string }) do
		wanted[label] = true
	end
	-- The engine files debug.profilebegin scopes under "::label".
	local labels: { TimerRow } = {}
	for _, row in all do
		if wanted[row.name] or wanted[string.gsub(row.name, "^::", "")] then
			table.insert(labels, row)
		end
	end

	local top: { TimerRow } = {}
	for index = 1, math.min(settings.top or DEFAULT_TOP, #all) do
		top[index] = all[index]
	end

	-- The three slowest frames and what filled them.
	local order = {}
	for id = frameMin, frameMax do
		table.insert(order, id)
	end
	table.sort(order, function(a, b)
		return frameTimes[a - frameMin + 1] > frameTimes[b - frameMin + 1]
	end)
	local spikes: { FrameRow } = {}
	for index = 1, math.min(3, #order) do
		local frameId = order[index]
		local perTimer = selfByFrame[frameId] or ({} :: { [number]: number })
		local filled = {}
		for timerId, ms in perTimer do
			table.insert(filled, { name = rows[timerId].name, selfMs = ms })
		end
		table.sort(filled, function(a, b)
			return a.selfMs > b.selfMs
		end)
		for trim = #filled, 5, -1 do
			filled[trim] = nil
		end
		table.insert(spikes, {
			frameId = frameId,
			absoluteId = frameDescs[frameId].FrameAbsoluteId,
			cpuMs = frameTimes[frameId - frameMin + 1],
			top = filled,
		})
	end

	local heapStart, heapEnd
	local heapId = session:FindCounterId("**/Luau/heap", false)
	if heapId ~= 0 then
		local samples = session:FetchCounterSamples(heapId)
		if #samples > 0 then
			heapStart = samples[1].Value / (1024 * 1024)
			heapEnd = samples[#samples].Value / (1024 * 1024)
		end
	end

	local sorted = table.clone(frameTimes)
	table.sort(sorted)
	local worst = order[1]

	session:Dispose()

	return {
		frames = #frameTimes,
		spanMs = spanMs,
		frameMeanMs = spanMs / #frameTimes,
		frameP95Ms = percentile(sorted, 0.95),
		frameMaxMs = frameTimes[worst - frameMin + 1],
		frameMaxId = worst,
		frameMaxAbsoluteId = frameDescs[worst].FrameAbsoluteId,
		heapStartMb = heapStart,
		heapEndMb = heapEnd,
		labels = labels,
		top = top,
		spikes = spikes,
	},
		nil
end

local function fmtMs(value: number): string
	return string.format("%.2fms", value)
end

function Profile.Summarise(report: Report): string
	local lines = {
		string.format(
			"capture: %d frames over %.0fms -- CPU frame mean %s, p95 %s, max %s (frame %d / abs %d)",
			report.frames,
			report.spanMs,
			fmtMs(report.frameMeanMs),
			fmtMs(report.frameP95Ms),
			fmtMs(report.frameMaxMs),
			report.frameMaxId,
			report.frameMaxAbsoluteId
		),
	}
	if report.heapStartMb and report.heapEndMb then
		table.insert(
			lines,
			string.format(
				"Luau heap: %.1f MB -> %.1f MB (%+.1f)",
				report.heapStartMb,
				report.heapEndMb,
				report.heapEndMb - report.heapStartMb
			)
		)
	end

	if #report.labels > 0 then
		table.insert(lines, "")
		table.insert(lines, "your labels (inclusive):")
		for _, row in report.labels do
			local avg = if row.count > 0 then row.inclusiveMs / row.count else 0
			table.insert(
				lines,
				string.format(
					"  %-32s %5d calls  total %s  avg %s  max %s  worst frame %s (frame %d / abs %d)",
					row.name,
					row.count,
					fmtMs(row.inclusiveMs),
					fmtMs(avg),
					fmtMs(row.maxMs),
					fmtMs(row.worstFrameMs),
					row.worstFrameId,
					row.worstFrameAbsoluteId
				)
			)
		end
	end

	table.insert(lines, "")
	table.insert(lines, `top {#report.top} scopes by self time, all CPU threads (inclusive in brackets):`)
	for index, row in report.top do
		table.insert(
			lines,
			string.format(
				"  %2d. %9s  %-36s [%s]  (incl %s)  n=%d  max %s",
				index,
				fmtMs(row.selfMs),
				row.name,
				row.group,
				fmtMs(row.inclusiveMs),
				row.count,
				fmtMs(row.maxMs)
			)
		)
	end

	table.insert(lines, "")
	table.insert(lines, "slowest frames and what filled them (self time):")
	for _, frame in report.spikes do
		local parts = {}
		for _, entry in frame.top do
			table.insert(parts, `{entry.name} {fmtMs(entry.selfMs)}`)
		end
		table.insert(
			lines,
			string.format(
				"  frame %d / abs %d: %s -- %s",
				frame.frameId,
				frame.absoluteId,
				fmtMs(frame.cpuMs),
				table.concat(parts, ", ")
			)
		)
	end

	return table.concat(lines, "\n")
end

-- The load loop as source, because it runs in the game VM where nothing of ours is in scope.
local function loadSource(target: Target): string
	local calls = target.calls or DEFAULT_CALLS
	local seconds = target.seconds or DEFAULT_SECONDS
	local perFrame = target.perFrame or math.max(1, math.ceil(calls / (seconds * 60)))
	local warmup = target.warmup or DEFAULT_WARMUP
	return string.format(
		[[
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local label = %q
local result = { label = label }
local function setup()
%s
end
local ok, fn = pcall(setup)
if not ok then
	result.error = "setup errored: " .. tostring(fn)
elseif type(fn) ~= "function" then
	result.error = "setup must return a function, it returned " .. typeof(fn)
else
	for _ = 1, %d do
		pcall(fn, 0)
	end
	local made, errors, firstError = 0, 0, nil
	local allocatedKb = 0
	local inFrame = 0
	local started = os.clock()
	local deadline = started + %s
	while made < %d and os.clock() < deadline do
		made += 1
		local heapBefore = collectgarbage("count")
		debug.setmemorycategory(label)
		debug.profilebegin(label)
		local passed, failure = pcall(fn, made)
		debug.profileend()
		debug.resetmemorycategory()
		local grew = collectgarbage("count") - heapBefore
		if grew > 0 then
			allocatedKb += grew
		end
		if not passed then
			errors += 1
			firstError = firstError or tostring(failure)
		end
		inFrame += 1
		if inFrame >= %d then
			inFrame = 0
			RunService.Heartbeat:Wait()
		end
	end
	result.calls = made
	result.errors = errors
	result.firstError = firstError
	result.seconds = os.clock() - started
	result.allocatedKbPerCall = if made > 0 then allocatedKb / made else 0
end
local holder = game:GetService("ReplicatedStorage"):FindFirstChild(%q) or Instance.new("StringValue")
holder.Name = %q
holder.Archivable = false
holder.Value = HttpService:JSONEncode(result)
holder.Parent = game:GetService("ReplicatedStorage")
]],
		target.label,
		target.setup,
		warmup,
		tostring(seconds),
		calls,
		perFrame,
		RESULT_NAME,
		RESULT_NAME
	)
end

local function runLoad(target: Target, vm: string?, env: any?): (any?, string?)
	local source = loadSource(target)
	local ok, failure
	if vm == "plugin" then
		ok, failure = Inject.Run(source, env or {}, (target.seconds or DEFAULT_SECONDS) + 30)
	else
		ok, failure = GameVm.Run(source)
	end
	if not ok then
		return nil, tostring(failure)
	end
	local holder = ReplicatedStorage:FindFirstChild(RESULT_NAME)
	if not holder or not holder:IsA("StringValue") then
		return nil, "the load ran but left no result behind"
	end
	local decoded, result = pcall(HttpService.JSONDecode, HttpService, holder.Value)
	holder:Destroy()
	if not decoded then
		return nil, `couldn't read the load's result: {result}`
	end
	return result, nil
end

local function safeName(name: string): string
	return (string.gsub(name, "[^%w_%-]", "_"):sub(1, 48))
end

-- Runs every target under its own capture, one after another, and hands back the report text for
-- all of them. This is what profile_scripts does in the playtest; a timeline `server` event calls
-- it directly as vmcp.Profile.Hammer so old-vs-new plus the output check fit in one run.
function Profile.Hammer(targets: { Target }, options: HammerOptions?): (string, boolean, { [string]: Outcome })
	local settings: HammerOptions = options or {}
	local outcomes: { [string]: Outcome } = {}
	local labels: { string } = {}
	for _, target in targets do
		table.insert(labels, target.label)
	end
	for _, label in settings.labels or ({} :: { string }) do
		table.insert(labels, label)
	end

	local prefix = safeName(settings.name or os.date("%Y%m%d-%H%M%S"))
	local parts = {}
	local failed = false

	for _, target in targets do
		local loadResult: any = nil
		local loadProblem: string? = nil
		local buf, why = Profile.Capture(settings.frameLimit or DEFAULT_FRAME_LIMIT, function()
			loadResult, loadProblem = runLoad(target, settings.vm, settings.env)
		end)

		local outcome: Outcome = {
			label = target.label,
			calls = 0,
			errors = 0,
			seconds = 0,
			allocatedKbPerCall = 0,
		}
		outcomes[target.label] = outcome

		local header = { `== {target.label} ==` }
		if loadProblem then
			outcome.error = `load failed: {loadProblem}`
			table.insert(header, outcome.error :: string)
			failed = true
		elseif loadResult.error then
			outcome.error = loadResult.error
			table.insert(header, loadResult.error)
			failed = true
		else
			outcome.calls = loadResult.calls
			outcome.errors = loadResult.errors
			outcome.seconds = loadResult.seconds
			outcome.allocatedKbPerCall = loadResult.allocatedKbPerCall or 0
			local line = string.format(
				"%d calls in %.2fs, ~%.1f KB allocated per call",
				loadResult.calls,
				loadResult.seconds,
				outcome.allocatedKbPerCall
			)
			if loadResult.errors > 0 then
				line ..= ` -- {loadResult.errors} errored, first: {loadResult.firstError}`
			end
			table.insert(header, line)
		end

		if not buf then
			table.insert(header, `no capture: {why}`)
			table.insert(parts, table.concat(header, "\n"))
			failed = true
			continue
		end

		local report, analyzeProblem = Profile.Analyze(buf, { labels = labels, top = settings.top })
		if not report then
			table.insert(header, `couldn't read the capture: {analyzeProblem}`)
		else
			outcome.report = report
			table.insert(header, Profile.Summarise(report))
		end

		if settings.dump ~= false then
			local size = buffer.len(buf)
			if size > MAX_DUMP_BYTES then
				table.insert(
					header,
					`(capture is {math.floor(size / 1024)} KB, too big to ship as one message -- lower frameLimit, or raise VMCP_MAX_MESSAGE_MB)`
				)
			else
				local posted, written = Bridge.Post({
					kind = "gprx",
					name = `{prefix}-{safeName(target.label)}`,
					data = Profile.Base64(buf),
				})
				table.insert(header, if posted then written else `dump failed: {written}`)
			end
		end

		table.insert(parts, table.concat(header, "\n"))
	end

	return table.concat(parts, "\n\n"), failed, outcomes
end

-- The label's own row in a report, with or without the engine's "::" prefix.
local function labelRow(report: Report, label: string): TimerRow?
	for _, row in report.labels do
		if row.name == label or row.name == `::{label}` then
			return row
		end
	end
	return nil
end

export type Delta = {
	-- Fractions: 0.4 means "new is 40% of old", so under 1 is faster/smaller.
	perCall: number?,
	worstFrame: number?,
	frameP95: number,
	heap: number?,
	allocation: number?,
	text: string,
	-- True when nothing got worse and something got meaningfully better.
	better: boolean,
}

local function ratio(after: number, before: number): number?
	if before <= 0 then
		return nil
	end
	return after / before
end

local function pct(fraction: number?): string
	if not fraction then
		return "n/a"
	end
	return string.format("%+.0f%%", (fraction - 1) * 100)
end

-- Two outcomes from the same Hammer call, old against new. Everything is a ratio so a timeline
-- assertion can say `ctx.delta.worstFrame < 0.8` and mean it.
function Profile.Compare(old: Outcome, new: Outcome): Delta
	local oldReport, newReport = old.report, new.report
	local oldRow = if oldReport then labelRow(oldReport, old.label) else nil
	local newRow = if newReport then labelRow(newReport, new.label) else nil

	local perCall
	if oldRow and newRow and oldRow.count > 0 and newRow.count > 0 then
		perCall = ratio(newRow.inclusiveMs / newRow.count, oldRow.inclusiveMs / oldRow.count)
	end
	local worstFrame = if oldRow and newRow then ratio(newRow.worstFrameMs, oldRow.worstFrameMs) else nil
	local frameP95 = if oldReport and newReport then ratio(newReport.frameP95Ms, oldReport.frameP95Ms) else nil
	local heap
	if oldReport and newReport and oldReport.heapStartMb and newReport.heapStartMb then
		local oldGrowth = (oldReport.heapEndMb :: number) - oldReport.heapStartMb
		local newGrowth = (newReport.heapEndMb :: number) - newReport.heapStartMb
		heap = if oldGrowth > 0.05 then newGrowth / oldGrowth else nil
	end
	local allocation = ratio(new.allocatedKbPerCall, old.allocatedKbPerCall)

	local worse = (perCall or 1) > 1.05 or (worstFrame or 1) > 1.1 or (allocation or 1) > 1.25
	local gained = (perCall or 1) < 0.85 or (worstFrame or 1) < 0.85 or (allocation or 1) < 0.75
	local lines = {
		`{old.label} -> {new.label}:`,
		`  per call    {pct(perCall)}` .. (if oldRow and newRow
			then string.format(
				"  (%.3fms -> %.3fms)",
				oldRow.inclusiveMs / math.max(oldRow.count, 1),
				newRow.inclusiveMs / math.max(newRow.count, 1)
			)
			else ""),
		`  worst frame {pct(worstFrame)}` .. (if oldRow and newRow
			then string.format("  (%.2fms -> %.2fms)", oldRow.worstFrameMs, newRow.worstFrameMs)
			else ""),
		`  frame p95   {pct(frameP95)}`,
		`  allocation  {pct(allocation)}`
			.. string.format("  (%.1f KB -> %.1f KB per call)", old.allocatedKbPerCall, new.allocatedKbPerCall),
		`  heap growth {pct(heap)}`,
		if worse
			then "  verdict: REGRESSION on at least one axis"
			elseif gained then "  verdict: better"
			else "  verdict: no meaningful change",
	}
	return {
		perCall = perCall,
		worstFrame = worstFrame,
		frameP95 = frameP95 or 1,
		heap = heap,
		allocation = allocation,
		text = table.concat(lines, "\n"),
		better = gained and not worse,
	}
end

-- A capture of whatever the game is doing on its own for `seconds` -- the real-load baseline.
-- Nothing is hammered; whatever drives the game (the user, a client timeline event walking and
-- firing remotes) is the load. Returns the report text and the report.
export type ObserveOptions = { frameLimit: number?, top: number?, labels: { string }?, dump: boolean?, name: string? }

function Profile.Observe(seconds: number?, options: ObserveOptions?): (string, Report?)
	local settings: ObserveOptions = options or {}
	local hold = math.max(seconds or 3, 0.1)
	local buf, why = Profile.Capture(settings.frameLimit or MAX_FRAME_LIMIT, function()
		task.wait(hold)
	end)
	if not buf then
		return `no capture: {why}`, nil
	end
	local report, problem = Profile.Analyze(buf, { labels = settings.labels, top = settings.top or 25 })
	if not report then
		return `couldn't read the capture: {problem}`, nil
	end
	local text = `== observed {string.format("%.1f", hold)}s of the game as it runs ==\n` .. Profile.Summarise(report)
	if settings.dump then
		local size = buffer.len(buf)
		if size <= MAX_DUMP_BYTES then
			local posted, outcome = Bridge.Post({
				kind = "gprx",
				name = `{safeName(settings.name or os.date("%Y%m%d-%H%M%S"))}-observe`,
				data = Profile.Base64(buf),
			})
			text ..= "\n" .. (if posted then outcome else `dump failed: {outcome}`)
		else
			text ..= `\n(capture is {math.floor(size / 1024)} KB, too big to ship -- lower frameLimit)`
		end
	end
	return text, report
end

local ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local CHARS = {}
for index = 1, 64 do
	CHARS[index - 1] = string.sub(ALPHABET, index, index)
end

-- The capture has to cross the socket as JSON to get written to disk, and JSON has no bytes.
function Profile.Base64(buf: buffer): string
	local length = buffer.len(buf)
	local out = table.create(math.ceil(length / 3))
	local index = 0
	while index + 3 <= length do
		local a, b, c = buffer.readu8(buf, index), buffer.readu8(buf, index + 1), buffer.readu8(buf, index + 2)
		local word = a * 65536 + b * 256 + c
		table.insert(
			out,
			CHARS[bit32.rshift(word, 18)]
				.. CHARS[bit32.band(bit32.rshift(word, 12), 63)]
				.. CHARS[bit32.band(bit32.rshift(word, 6), 63)]
				.. CHARS[bit32.band(word, 63)]
		)
		index += 3
	end
	local rest = length - index
	if rest == 1 then
		local a = buffer.readu8(buf, index)
		table.insert(out, CHARS[bit32.rshift(a, 2)] .. CHARS[bit32.band(bit32.lshift(a, 4), 63)] .. "==")
	elseif rest == 2 then
		local a, b = buffer.readu8(buf, index), buffer.readu8(buf, index + 1)
		local word = a * 256 + b
		table.insert(
			out,
			CHARS[bit32.rshift(word, 10)]
				.. CHARS[bit32.band(bit32.rshift(word, 4), 63)]
				.. CHARS[bit32.band(bit32.lshift(word, 2), 63)]
				.. "="
		)
	end
	return table.concat(out)
end

return Profile
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--!strict

-- Watches remote traffic, so "what is this thing actually sending" stops being a guess.
--
-- Two different mechanisms, because remotes aren't symmetrical. A RemoteEvent can be *observed*:
-- connecting a second listener to OnServerEvent doesn't disturb the first, so watching one is
-- free and can't break the game. A RemoteFunction has exactly one callback, so the only way to
-- see a call is to take the callback, put our own in front, and hand the arguments on -- a real
-- hook. Stop() puts the originals back; a watch left running when a playtest ends dies with it.

local RunService = game:GetService("RunService")

local Path = require(script.Parent.Parent.Path)
local Portable = require(script.Parent.Parent.Exec.Portable)
local Serialize = require(script.Parent.Parent.Exec.Serialize)

local Remotes = {}

export type Call = {
	remote: string,
	direction: string,
	from: string?,
	at: number,
	args: string,
	-- The same arguments in a form that survives ctx and can be rebuilt in another DataModel, so
	-- what a client really sent can be replayed and mutated from a client event.
	captured: { any },
}

local MAX_CALLS = 500

local calls: { Call } = {}
local connections: { RBXScriptConnection } = {}
local restores: { () -> () } = {}

local function record(remote: Instance, direction: string, from: string?, args: { any })
	if #calls >= MAX_CALLS then
		return
	end
	table.insert(calls, {
		remote = remote:GetFullName(),
		direction = direction,
		from = from,
		at = os.clock(),
		args = Serialize.Render(args),
		captured = Portable.CaptureArgs(args),
	})
end

local function watchEvent(remote: RemoteEvent | UnreliableRemoteEvent)
	if RunService:IsServer() then
		table.insert(
			connections,
			(remote :: any).OnServerEvent:Connect(function(player: Player, ...)
				record(remote, "client to server", player.Name, table.pack(...))
			end)
		)
		return
	end
	table.insert(
		connections,
		(remote :: any).OnClientEvent:Connect(function(...)
			record(remote, "server to client", nil, table.pack(...))
		end)
	)
end

-- The invasive half. Saved and restored rather than left in place, because leaving a wrapper on a
-- live RemoteFunction after the watch ends would quietly change the game's behaviour.
local function hookFunction(remote: RemoteFunction)
	local property = if RunService:IsServer() then "OnServerInvoke" else "OnClientInvoke"
	local original = (remote :: any)[property]
	if type(original) ~= "function" then
		-- Nothing has claimed it yet. Hooking now would make us the handler, and there'd be no
		-- real one to pass the call to.
		return
	end
	(remote :: any)[property] = function(...)
		if RunService:IsServer() then
			-- OnServerInvoke gets the player as the first argument; the payload is what comes after,
			-- so a captured call can be replayed from a client without the player baked into it.
			local player = select(1, ...) :: any
			record(
				remote,
				"invoke server",
				if typeof(player) == "Instance" then player.Name else nil,
				table.pack(select(2, ...))
			)
		else
			record(remote, "invoke client", nil, table.pack(...))
		end
		return original(...)
	end

	table.insert(restores, function()
		(remote :: any)[property] = original
	end)
end

function Remotes.Watch(remote: Instance): string?
	if remote:IsA("RemoteEvent") or remote:IsA("UnreliableRemoteEvent") then
		watchEvent(remote :: any)
		return nil
	end
	if remote:IsA("RemoteFunction") then
		hookFunction(remote)
		return nil
	end
	return `{remote:GetFullName()} is a {remote.ClassName}, not a remote`
end

-- Every remote under `root`, plus any added later, so a remote created after the watch started
-- still gets seen.
function Remotes.WatchAll(root: Instance): number
	local found = 0
	for _, descendant in root:GetDescendants() do
		if not Remotes.Watch(descendant) then
			found += 1
		end
	end
	table.insert(
		connections,
		root.DescendantAdded:Connect(function(descendant: Instance)
			Remotes.Watch(descendant)
		end)
	)
	return found
end

function Remotes.Calls(): { Call }
	return calls
end

export type Shape = {
	remote: string,
	class: string,
	direction: string,
	calls: number,
	-- One word per argument position, from the most recent call.
	signature: { string },
	-- Real arguments, as sent. Feed them to Exploit.Tailor and it breaks them in the ways that
	-- matter for the types they actually are.
	sample: { any },
}

-- What the game's own traffic looks like: every remote seen, with a real set of arguments. JSON
-- safe on purpose -- write it to ctx from a server event and read it from a client event, and the
-- fuzzer stops guessing at shapes it could have just been told.
function Remotes.Shapes(): { Shape }
	local byRemote: { [string]: Shape } = {}
	local order: { string } = {}

	for _, call in calls do
		local shape = byRemote[call.remote]
		if not shape then
			local instance = Path.Resolve(call.remote)
			shape = {
				remote = call.remote,
				class = if instance then instance.ClassName else "unknown",
				direction = call.direction,
				calls = 0,
				signature = {},
				sample = {},
			}
			byRemote[call.remote] = shape
			table.insert(order, call.remote)
		end

		shape.calls += 1
		-- Last call wins: a later one is likelier to be the interesting in-game case than the
		-- first, which is often an empty init ping.
		shape.sample = call.captured
		local signature = {}
		for index = 1, (call.captured :: any).n or #call.captured do
			table.insert(signature, Portable.Describe(call.captured[index]))
		end
		shape.signature = signature
	end

	local out: { Shape } = {}
	for _, name in order do
		table.insert(out, byRemote[name])
	end
	return out
end

function Remotes.Report(): string
	if #calls == 0 then
		return "no remote traffic seen"
	end

	local counts: { [string]: number } = {}
	local order: { string } = {}
	for _, call in calls do
		local key = `{call.remote} ({call.direction})`
		if not counts[key] then
			table.insert(order, key)
		end
		counts[key] = (counts[key] or 0) + 1
	end

	local lines = { `{#calls} call(s) across {#order} remote(s):` }
	for _, key in order do
		table.insert(lines, `  {counts[key]}x {key}`)
	end
	table.insert(lines, "")
	table.insert(lines, "most recent:")
	for index = math.max(#calls - 9, 1), #calls do
		local call = calls[index]
		local who = if call.from then ` from {call.from}` else ""
		table.insert(lines, `  {call.remote}{who} {call.args}`)
	end
	return table.concat(lines, "\n")
end

function Remotes.Stop()
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
	for _, restore in restores do
		pcall(restore)
	end
	table.clear(restores)
end

function Remotes.Clear()
	table.clear(calls)
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">Rig</string>
          <string name="Source"><![CDATA[--!strict

-- Derives a rig's pose hierarchy from the Motor6D graph it actually has.
--
-- This exists because of one trap that costs an afternoon every time: a Pose is *named* after a
-- BasePart, but the CFrame on it drives the Motor6D joining that part to its **parent pose's**
-- part. A Pose named LowerTorso drives the motor named Root. So a pose tree that looks sensible
-- but doesn't mirror the real joint graph animates the wrong joints, and nothing errors -- the
-- character just moves wrong.
--
-- Nothing here is hardcoded to a skeleton, so R6, R15 and custom rigs all work the same way.

local Rig = {}

export type Node = {
	part: BasePart,
	-- The motor that moves `part` relative to its parent. nil on the root, which nothing moves.
	motor: Motor6D?,
	children: { Node },
}

export type Rig = {
	root: Node,
	byName: { [string]: Node },
	-- Every part name, parents before children, which is the order a pose tree has to be built in.
	order: { string },
}

local function collect(model: Instance): ({ Motor6D }, { [BasePart]: true })
	local motors: { Motor6D } = {}
	local moved: { [BasePart]: true } = {}
	for _, descendant in model:GetDescendants() do
		if not descendant:IsA("Motor6D") then
			continue
		end
		local child = descendant.Part1
		if descendant.Part0 and child then
			table.insert(motors, descendant)
			moved[child] = true
		end
	end
	return motors, moved
end

-- Walks the Motor6D graph out from the one part nothing else moves. Returns the problem instead
-- of the rig when the graph doesn't describe a single tree, because every later step assumes it.
function Rig.Build(model: Instance): (Rig?, string?)
	local motors, moved = collect(model)
	if #motors == 0 then
		return nil, `{model:GetFullName()} has no Motor6Ds, so there's no rig to read`
	end

	local roots: { BasePart } = {}
	for _, motor in motors do
		local part0 = motor.Part0 :: BasePart
		if not moved[part0] and not table.find(roots, part0) then
			table.insert(roots, part0)
		end
	end
	if #roots == 0 then
		return nil, "every part in this rig is driven by a motor, so the joints form a loop"
	end
	if #roots > 1 then
		local names = {}
		for _, part in roots do
			table.insert(names, part.Name)
		end
		return nil, `this rig has {#roots} unmoved parts ({table.concat(names, ", ")}); it needs exactly one root`
	end

	local byName: { [string]: Node } = {}
	local order: { string } = {}

	local function node(part: BasePart, motor: Motor6D?): Node
		local created: Node = { part = part, motor = motor, children = {} }
		byName[part.Name] = created
		table.insert(order, part.Name)
		return created
	end

	local root = node(roots[1], nil)
	local frontier = { root }
	while #frontier > 0 do
		local current = table.remove(frontier) :: Node
		for _, motor in motors do
			if motor.Part0 ~= current.part then
				continue
			end
			local child = node(motor.Part1 :: BasePart, motor)
			table.insert(current.children, child)
			table.insert(frontier, child)
		end
	end

	if #order < #motors + 1 then
		return nil, `only {#order} of {#motors + 1} parts are reachable from {root.part.Name} -- the rig is in pieces`
	end
	return { root = root, byName = byName, order = order }, nil
end

-- Builds one keyframe's worth of Poses: the same shape as the rig, one Pose per part, named after
-- the part but driving the motor above it. `cframeFor` supplies each joint's transform; anything
-- it has no opinion on stays at identity, which is the joint's rest position.
function Rig.PoseTree(rig: Rig, cframeFor: (partName: string) -> CFrame?): Pose
	local function build(node: Node): Pose
		local pose = Instance.new("Pose")
		pose.Name = node.part.Name
		pose.CFrame = cframeFor(node.part.Name) or CFrame.identity
		for _, child in node.children do
			build(child).Parent = pose
		end
		return pose
	end
	return build(rig.root)
end

-- Names the rig knows, so a typo in a track can be reported as "no such joint" instead of
-- animating nothing and looking like a broken export.
function Rig.Describe(rig: Rig): string
	local lines = {}
	local function walk(node: Node, depth: number)
		local motor = if node.motor then ` via {node.motor.Name}` else " (root)"
		table.insert(lines, `{string.rep("  ", depth)}{node.part.Name}{motor}`)
		for _, child in node.children do
			walk(child, depth + 1)
		end
	end
	walk(rig.root, 0)
	return table.concat(lines, "\n")
end

return Rig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">Style</string>
          <string name="Source"><![CDATA[--!strict

-- Two small checks around StyleRule, both of which exist because the engine fails quietly here.
--
-- StyleRule:SetProperties ignores a property name the target class doesn't have. No error, no
-- warning -- the rule just does less than it says, and the usual next move is to go and rewrite
-- the selector, which was never the problem. StyleRule.SelectorError is the same shape of trap in
-- the other direction: the message is there to read, but nothing makes you read it.

local Style = {}

-- Instance.new is the only honest way to ask "does this class have this property". A probe costs
-- one instance that's thrown away immediately, and the answer is exact.
local function probe(className: string): (Instance?, string?)
	local ok, instance = pcall(Instance.new, className)
	if not ok then
		return nil,
			`can't check against "{className}" -- either it isn't a class or it isn't creatable, `
				.. "which is the case for abstract ones like GuiObject"
	end
	return instance, nil
end

-- Returns the property names the class doesn't have. Empty means everything would land.
function Style.Check(className: string, properties: { [string]: any }): ({ string }, string?)
	local instance, problem = probe(className)
	if not instance then
		return {}, problem
	end

	local missing = {}
	for name in properties do
		if not pcall(function()
			return (instance :: any)[name]
		end) then
			table.insert(missing, name)
		end
	end
	instance:Destroy()

	table.sort(missing)
	return missing, nil
end

-- Checks first, then applies. Returns the names it refused to set, so a typo shows up as a list
-- rather than as a rule that mysteriously does nothing.
function Style.Apply(rule: StyleRule, className: string, properties: { [string]: any }): ({ string }, string?)
	local missing, problem = Style.Check(className, properties)
	if problem then
		return {}, problem
	end

	local wanted = {}
	for name, value in properties do
		if not table.find(missing, name) then
			wanted[name] = value
		end
	end
	rule:SetProperties(wanted)
	return missing, nil
end

-- Sets a selector and hands back whatever the engine made of it. An empty return means it parsed.
function Style.Selector(rule: StyleRule, selector: string): string?
	rule.Selector = selector
	local complaint = rule.SelectorError
	return if complaint ~= "" then complaint else nil
end

-- A styled value never shows up in a plain property read: `frame.BackgroundColor3` keeps saying
-- the default while the rule renders fine. GetStyled is the read that sees the rules, and this
-- is the same thing for several properties at once. A name the class doesn't have comes back
-- as the error string instead of a value.
function Style.Read(instance: Instance, names: { string }): { [string]: any }
	local out = {}
	for _, name in names do
		local ok, value = pcall(function()
			return (instance :: any):GetStyled(name)
		end)
		out[name] = if ok then value else `no property "{name}"`
	end
	return out
end

return Style
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="26">
      <Properties>
        <string name="Name">Log</string>
      </Properties>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">Buffer</string>
          <string name="Source"><![CDATA[--!strict
--!optimize 2

-- A rolling record of everything Studio logs, hooked once at plugin load.
--
-- This is the part run_luau structurally cannot do: a snippet only ever sees its own output, but
-- the errors worth reading are usually thrown by the place's own scripts, minutes before any tool
-- ran. Buffer.Since also backs run_luau's output capture -- note the cursor, run, read the tail.

local LogService = game:GetService("LogService")

local CAPACITY = 500

export type Entry = {
	cursor: number,
	time: number,
	severity: string,
	text: string,
}

local SEVERITY: { [Enum.MessageType]: string } = {
	[Enum.MessageType.MessageOutput] = "print",
	[Enum.MessageType.MessageInfo] = "info",
	[Enum.MessageType.MessageWarning] = "warn",
	[Enum.MessageType.MessageError] = "error",
}

local Buffer = {
	-- Total entries ever written, so it doubles as a cursor that never repeats.
	written = 0,
}

local entries: { Entry } = table.create(CAPACITY)
local started = false

local function push(messageType: Enum.MessageType, text: string, when: number)
	Buffer.written += 1
	entries[(Buffer.written - 1) % CAPACITY + 1] = {
		cursor = Buffer.written,
		time = when,
		severity = SEVERITY[messageType] or "print",
		text = text,
	}
end

function Buffer.Start()
	if started then
		return
	end
	started = true

	-- MessageOut only fires from here on, so whatever Studio already has scrolls in first. Only
	-- the plugin can do that -- GetLogHistory is PluginSecurity and this module is also injected
	-- into playtest DataModels, where the backfill simply isn't available.
	pcall(function()
		for _, item in LogService:GetLogHistory() do
			push(item.messageType, item.message, item.timestamp)
		end
	end)
	LogService.MessageOut:Connect(function(text: string, messageType: Enum.MessageType)
		push(messageType, text, os.time())
	end)
end

-- Entries newer than `cursor`, oldest first, plus how many fell off the ring before we got to
-- them -- a caller that asked for a gap it can't have should be able to say so.
function Buffer.Since(cursor: number): ({ Entry }, number)
	local oldest = math.max(Buffer.written - CAPACITY, 0)
	local dropped = math.max(oldest - cursor, 0)

	local out = {}
	for index = math.max(cursor, oldest) + 1, Buffer.written do
		table.insert(out, entries[(index - 1) % CAPACITY + 1])
	end
	return out, dropped
end

return Buffer
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="ModuleScript" referent="28">
      <Properties>
        <string name="Name">Panel</string>
        <string name="Source"><![CDATA[--!strict
--!optimize 2

-- The panel's instance tree and its styling. There is no protocol, no state machine and no
-- validation in here -- it builds the widgets, styles them, and hands them back for you to wire.
--
--   local root = Panel.Mount(parent)
--
--   Panel.ConnectButton     TextButton
--   Panel.DisconnectButton  TextButton  (starts disabled; set .Interactable)
--   Panel.PortInput         TextBox
--   Panel.TokenInput        TextBox
--   Panel.StatusLine        TextLabel   the sentence under the buttons
--   Panel.StatusWord        TextLabel   the word beside the lamp
--
--   Panel.SetSignal("Idle" | "Work" | "Live" | "Fault")   lamp + hairline colour; Work animates
--   Panel.SetTokenOpen(open)                              the auth-token drawer
--   Panel.SetStatusWord(text)                              the word beside the lamp
--   Panel.SetStatusLine(text)                              the sentence under the buttons
--   Panel.SetConnectEnabled(enabled)                       ConnectButton.Interactable
--   Panel.SetDisconnectEnabled(enabled)                    DisconnectButton.Interactable
--   Panel.Destroy()
--
--   Panel.ConnectRequested      ()             Connect button clicked
--   Panel.DisconnectRequested   ()             Disconnect button clicked
--   Panel.PortChanged           (text: string) PortInput text edited
--   Panel.TokenChanged          (text: string) TokenInput text edited
--
-- Clicking the disclosure row toggles the drawer on its own. Everything else is yours.

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Style = require(script.Style)

local ADDRESS_PREFIX = "ws://127.0.0.1:"
local NARROW_WIDTH = 240
local FIELD_H = 32
local PAD = 16

local EASE = TweenInfo.new(0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

-- Filled in by Mount; this is the panel's whole public surface.
local Panel = {
	Root = nil :: any,
	ConnectButton = nil :: any,
	DisconnectButton = nil :: any,
	PortInput = nil :: any,
	TokenInput = nil :: any,
	StatusLine = nil :: any,
	StatusWord = nil :: any,
	ConnectRequested = nil :: any,
	DisconnectRequested = nil :: any,
	PortChanged = nil :: any,
	TokenChanged = nil :: any,
}

Panel._connectRequestedBindable = Instance.new("BindableEvent")
Panel._disconnectRequestedBindable = Instance.new("BindableEvent")
Panel._portChangedBindable = Instance.new("BindableEvent")
Panel._tokenChangedBindable = Instance.new("BindableEvent")
Panel.ConnectRequested = Panel._connectRequestedBindable.Event
Panel.DisconnectRequested = Panel._disconnectRequestedBindable.Event
Panel.PortChanged = Panel._portChangedBindable.Event
Panel.TokenChanged = Panel._tokenChangedBindable.Event

local gradient: UIGradient
local tokenGroup: Frame
local toggleWord: TextLabel
local sweep: RBXScriptConnection? = nil
local tokenOpen = false

---------------------------------------------------------------------- tree helpers

local orders: { [Instance]: number } = {}

local function new(class: string, props: { [string]: any }, parent: Instance?): any
	local inst = Instance.new(class)
	for key, value in props do
		(inst :: any)[key] = value
	end
	-- Siblings lay out in the order they are written below, so nothing hand-numbers LayoutOrder.
	if parent and inst:IsA("GuiObject") then
		local n = (orders[parent] or 0) + 1
		orders[parent] = n
		inst.LayoutOrder = n
	end
	inst.Parent = parent
	return inst
end

-- A transparent auto-height container and its layout. Every group in the panel is one of these.
local function box(name: string, parent: Instance, dir: Enum.FillDirection, gap: number): Frame
	local frame = new("Frame", {
		Name = name,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
	}, parent)
	new("UIListLayout", {
		FillDirection = dir,
		Padding = UDim.new(0, gap),
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, frame)
	return frame
end

local function pad(parent: Instance, x: number, y: number)
	new("UIPadding", {
		PaddingLeft = UDim.new(0, x),
		PaddingRight = UDim.new(0, x),
		PaddingTop = UDim.new(0, y),
		PaddingBottom = UDim.new(0, y),
	}, parent)
end

local function label(name: string, text: string, parent: Instance): TextLabel
	local created = new("TextLabel", {
		Name = name,
		Text = text,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 14),
		TextXAlignment = Enum.TextXAlignment.Left,
	}, parent)
	created:AddTag("FieldLabel")
	return created
end

-- A bordered input row. Active so the frame reports :Hover to the stroke rule.
local function field(name: string, parent: Instance): Frame
	local frame = new("Frame", { Name = name, Size = UDim2.new(1, 0, 0, FIELD_H), Active = true }, parent)
	frame:AddTag("Field")
	new("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }, frame)
	return frame
end

local function button(name: string, text: string, role: string, parent: Instance): TextButton
	local btn = new("TextButton", { Name = name, Text = text }, parent)
	btn:AddTag("Btn")
	btn:AddTag(role)
	return btn
end

---------------------------------------------------------------------- presentation

-- The lamp and the hairline share one colour. "Work" is the only one that animates, and the
-- sweep runs for exactly as long as that signal is showing.
function Panel.SetSignal(name: string)
	Style.SetSignal(name)

	local animate = name == "Work"
	gradient.Enabled = animate

	if not animate then
		if sweep then
			sweep:Disconnect()
			sweep = nil
		end
	elseif not sweep then
		sweep = RunService.Heartbeat:Connect(function()
			gradient.Offset = Vector2.new((os.clock() * 0.9) % 2 - 1, 0)
		end)
	end
end

function Panel.SetTokenOpen(open: boolean)
	if tokenOpen == open then
		return
	end
	tokenOpen = open

	TweenService:Create(tokenGroup, EASE, {
		Size = UDim2.new(1, 0, 0, if open then FIELD_H else 0),
	}):Play()
	toggleWord.Text = if open then "Hide" else "Show"

	if not open and Panel.TokenInput:IsFocused() then
		Panel.TokenInput:ReleaseFocus()
	end
end

function Panel.SetStatusWord(text: string)
	Panel.StatusWord.Text = text
end

function Panel.SetStatusLine(text: string)
	Panel.StatusLine.Text = text
end

function Panel.SetConnectEnabled(enabled: boolean)
	Panel.ConnectButton.Interactable = enabled
end

function Panel.SetDisconnectEnabled(enabled: boolean)
	Panel.DisconnectButton.Interactable = enabled
end

---------------------------------------------------------------------- tree

function Panel.Mount(parent: Instance): Frame
	local root = new("Frame", {
		Name = "VmcpRoot",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
	}, parent)
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, root)

	-- header: wordmark left, lamp and one-word status right
	local header = new("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 48),
		BackgroundTransparency = 1,
	}, root)
	pad(header, PAD, 0)

	new("TextLabel", {
		Name = "Wordmark",
		Text = "VMCP",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
	}, header)

	local statusGroup = box("StatusGroup", header, Enum.FillDirection.Horizontal, 6)
	statusGroup.AnchorPoint = Vector2.new(1, 0.5)
	statusGroup.Position = UDim2.new(1, 0, 0.5, 0)
	statusGroup.Size = UDim2.fromOffset(0, 16)
	statusGroup.AutomaticSize = Enum.AutomaticSize.X

	new("Frame", { Name = "Lamp", Size = UDim2.fromOffset(8, 8) }, statusGroup)
	Panel.StatusWord = label("StatusWord", "not connected", statusGroup)

	-- the hero: a full-bleed hairline carrying the signal colour
	local signalRule = new("Frame", { Name = "SignalRule", Size = UDim2.new(1, 0, 0, 1) }, root)
	gradient = new("UIGradient", {
		Enabled = false,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.7),
			NumberSequenceKeypoint.new(0.42, 0.7),
			NumberSequenceKeypoint.new(0.5, 0),
			NumberSequenceKeypoint.new(0.58, 0.7),
			NumberSequenceKeypoint.new(1, 0.7),
		}),
	}, signalRule)

	local body = box("Body", root, Enum.FillDirection.Vertical, PAD)
	pad(body, PAD, PAD)

	-- port field: spells out the whole address, so the number is never a bare mystery integer
	local portGroup = box("PortGroup", body, Enum.FillDirection.Vertical, 6)
	label("PortLabel", "Bridge port", portGroup).Size = UDim2.new(1, 0, 0, 12)

	local portField = field("PortField", portGroup)
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, portField)

	new("TextLabel", {
		Name = "PortPrefix",
		Text = ADDRESS_PREFIX,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 1, 0),
	}, portField)

	Panel.PortInput = new("TextBox", {
		Name = "PortInput",
		Text = "",
		PlaceholderText = "8791",
		Size = UDim2.new(0, 0, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
	}, portField)
	new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill }, Panel.PortInput)

	-- buttons. The StyleQuery stacks them below NARROW_WIDTH; there is no second code path.
	local buttonRow = box("ButtonRow", body, Enum.FillDirection.Horizontal, 8)
	new("StyleQuery", { Name = "Narrow" }, buttonRow):SetConditions({
		MinSize = Vector2.zero,
		MaxSize = Vector2.new(NARROW_WIDTH, math.huge),
	})

	Panel.ConnectButton = button("Connect", "Connect", "Fill", buttonRow)
	new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill }, Panel.ConnectButton)
	Panel.DisconnectButton = button("Disconnect", "Disconnect", "Ghost", buttonRow)
	Panel.DisconnectButton.Interactable = false

	-- footer
	local footer = box("Footer", body, Enum.FillDirection.Vertical, 8)

	Panel.StatusLine = label("StatusLine", "Not connected", footer)
	Panel.StatusLine.Size = UDim2.new(1, 0, 0, 12)
	Panel.StatusLine.AutomaticSize = Enum.AutomaticSize.None
	Panel.StatusLine.TextTruncate = Enum.TextTruncate.AtEnd

	local disclosure = new("TextButton", { Name = "Disclosure", Text = "", Size = UDim2.new(1, 0, 0, 14) }, footer)
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, disclosure)
	label("DisclosureLabel", "Auth token", disclosure)
	-- A word, not a caret glyph: it says what clicking does and needs no icon system.
	toggleWord = label("ToggleWord", "Show", disclosure)

	tokenGroup = new("Frame", {
		Name = "TokenGroup",
		Size = UDim2.new(1, 0, 0, 0),
		ClipsDescendants = true,
		BackgroundTransparency = 1,
	}, footer)

	Panel.TokenInput = new("TextBox", {
		Name = "TokenInput",
		Text = "",
		PlaceholderText = "paste the auth token",
		Size = UDim2.new(1, 0, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, field("TokenField", tokenGroup))

	Style.Attach(root)
	disclosure.Activated:Connect(function()
		Panel.SetTokenOpen(not tokenOpen)
	end)

	Panel.ConnectButton.Activated:Connect(function()
		Panel._connectRequestedBindable:Fire()
	end)
	Panel.DisconnectButton.Activated:Connect(function()
		Panel._disconnectRequestedBindable:Fire()
	end)
	Panel.PortInput.FocusLost:Connect(function()
		Panel._portChangedBindable:Fire(Panel.PortInput.Text)
	end)
	Panel.TokenInput.FocusLost:Connect(function()
		Panel._tokenChangedBindable:Fire(Panel.TokenInput.Text)
	end)

	table.clear(orders)
	Panel.SetSignal("Idle")
	Panel.Root = root
	return root
end

function Panel.Destroy()
	Panel.SetSignal("Idle")
	Style.Destroy()
	if Panel.Root then
		Panel.Root:Destroy()
	end
	Panel._connectRequestedBindable:Destroy()
	Panel._disconnectRequestedBindable:Destroy()
	Panel._portChangedBindable:Destroy()
	Panel._tokenChangedBindable:Destroy()
end

return Panel
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">Style</string>
          <string name="Source"><![CDATA[--!strict
--!optimize 2

-- The panel's whole visual system. Two token sheets (one per Studio theme) hold the values;
-- one rule sheet holds the rules and derives from whichever theme is live. Connection state is
-- a single attribute write -- every rule referencing $Signal re-resolves and eases there itself.

local FONT_UI = "rbxasset://fonts/families/BuilderSans.json"
local FONT_MONO = "rbxasset://fonts/families/RobotoMono.json"

-- Theme-independent tokens, copied onto both theme sheets so no derive chain is needed.
local SHARED: { [string]: any } = {
	Rad = UDim.new(0, 6),
	RadBtn = UDim.new(0, 5),
	FontUI = Font.new(FONT_UI, Enum.FontWeight.Medium),
	FontStrong = Font.new(FONT_UI, Enum.FontWeight.SemiBold),
	FontMono = Font.new(FONT_MONO, Enum.FontWeight.Medium),
	SizeWordmark = 12,
	SizeBody = 13,
	SizeMono = 14,
	SizeMicro = 11,
}

local DARK = {
	Ground = Color3.fromHex("0F1113"),
	Raised = Color3.fromHex("181B1E"),
	HairlineStrong = Color3.fromHex("343A40"),
	Ink = Color3.fromHex("E6E9EC"),
	InkDim = Color3.fromHex("8B949C"),
	InkFaint = Color3.fromHex("7A848C"),
	SignalIdle = Color3.fromHex("5C666E"),
	SignalWork = Color3.fromHex("E0A44A"),
	SignalLive = Color3.fromHex("3ECF8E"),
	SignalFault = Color3.fromHex("FF6B5E"),
}

local LIGHT = {
	Ground = Color3.fromHex("F4F5F6"),
	Raised = Color3.fromHex("FFFFFF"),
	HairlineStrong = Color3.fromHex("CBD1D5"),
	Ink = Color3.fromHex("14171A"),
	InkDim = Color3.fromHex("5C666E"),
	InkFaint = Color3.fromHex("7A848C"),
	SignalIdle = Color3.fromHex("9AA3AA"),
	SignalWork = Color3.fromHex("B77A16"),
	SignalLive = Color3.fromHex("1F9E68"),
	SignalFault = Color3.fromHex("D4362A"),
}

local EASE = TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local EASE_FAST = TweenInfo.new(0.12, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

-- Rules are layered: structure loses to role, role loses to interaction state, and a
-- non-interactable control wins over everything.
local BASE, ROLE, STATE, OFF = 0, 10, 20, 30

local Style = {}

local sheets: { style: StyleSheet, dark: StyleSheet, light: StyleSheet }? = nil
local signalName = "Idle"
local dark = true

local function tokenSheet(name: string, palette: { [string]: any }, container: Instance): StyleSheet
	local sheet = Instance.new("StyleSheet")
	sheet.Name = name
	for key, value in palette do
		sheet:SetAttribute(key, value)
	end
	for key, value in SHARED do
		sheet:SetAttribute(key, value)
	end
	sheet.Parent = container
	return sheet
end

-- The sheets live inside the tree they style, so the panel carries its own styling wherever it
-- is mounted and a single Destroy on the root takes the whole thing with it.
local function build(container: Instance)
	local darkSheet = tokenSheet("VmcpDarkTokens", DARK, container)
	local lightSheet = tokenSheet("VmcpLightTokens", LIGHT, container)

	local style = Instance.new("StyleSheet")
	style.Name = "VmcpStyle"
	style.Parent = container
	style:SetDerives({ darkSheet })

	local function rule(selector: string, priority: number, props: { [string]: any }): StyleRule
		local r = Instance.new("StyleRule")
		r.Selector = selector
		r.Priority = priority
		r:SetProperties(props)
		r.Parent = style
		return r
	end

	rule("#VmcpRoot", BASE, { BackgroundColor3 = "$Ground", BorderSizePixel = 0 })

	-- The signal: a full-bleed hairline and a lamp, both carrying the one colour that means state.
	local signalRule = rule("#SignalRule", BASE, { BackgroundColor3 = "$Signal", BorderSizePixel = 0 })
	local lampRule = rule("#Lamp", BASE, { BackgroundColor3 = "$Signal", BorderSizePixel = 0 })
	rule("#Lamp::UICorner", BASE, { CornerRadius = UDim.new(1, 0) })
	signalRule:SetPropertyTransition("BackgroundColor3", EASE)
	lampRule:SetPropertyTransition("BackgroundColor3", EASE)

	-- Type
	rule("#Wordmark", BASE, {
		FontFace = "$FontStrong",
		TextSize = "$SizeWordmark",
		TextColor3 = "$Ink",
		BackgroundTransparency = 1,
	})
	rule("#StatusWord, #StatusLine, .FieldLabel", BASE, {
		FontFace = "$FontUI",
		TextSize = "$SizeMicro",
		TextColor3 = "$InkDim",
		BackgroundTransparency = 1,
	})

	-- Fields. Active = true so the frame reports :Hover for the stroke rule below.
	rule(".Field", ROLE, { BackgroundColor3 = "$Raised", BorderSizePixel = 0 })
	rule(".Field::UICorner", ROLE, { CornerRadius = "$Rad" })
	-- Border mode, not the Contextual default: on a transparent background Contextual outlines the
	-- glyphs instead of the edge.
	local fieldStroke = rule(".Field::UIStroke", ROLE, {
		Color = "$HairlineStrong",
		Thickness = 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
	rule(".Field:Hover::UIStroke", STATE, { Color = "$InkFaint" })
	fieldStroke:SetPropertyTransition("Color", EASE_FAST)

	rule("#PortPrefix", BASE, {
		FontFace = "$FontMono",
		TextSize = "$SizeMono",
		TextColor3 = "$InkFaint",
		BackgroundTransparency = 1,
	})
	rule("TextBox", BASE, {
		FontFace = "$FontMono",
		TextSize = "$SizeMono",
		TextColor3 = "$Ink",
		PlaceholderColor3 = "$InkFaint",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
	})

	-- Buttons. Connect is an inverted neutral fill, not a blue -- the only saturated colour on
	-- the panel is the signal, so nothing else competes with it.
	-- Size lives here rather than on the instances: a property set directly on an instance beats
	-- every rule, which would make the @Narrow override below a no-op.
	rule(".Btn", BASE, {
		FontFace = "$FontUI",
		TextSize = "$SizeBody",
		Size = UDim2.new(0, 104, 0, 34),
		BorderSizePixel = 0,
		AutoButtonColor = false,
	})
	rule(".Btn::UICorner", BASE, { CornerRadius = "$RadBtn" })

	local fill = rule(".Fill", ROLE, {
		BackgroundColor3 = "$Ink",
		TextColor3 = "$Ground",
		BackgroundTransparency = 0,
	})
	rule(".Fill:Hover", STATE, { BackgroundTransparency = 0.08 })
	rule(".Fill:Press", STATE, { BackgroundTransparency = 0.2 })
	-- Only the return eases; press-in stays instant so the control feels connected to the click.
	fill:SetPropertyTransition("BackgroundTransparency", EASE_FAST)

	local ghost = rule(".Ghost", ROLE, {
		BackgroundColor3 = "$Raised",
		BackgroundTransparency = 1,
		TextColor3 = "$Ink",
	})
	local ghostStroke = rule(".Ghost::UIStroke", ROLE, {
		Color = "$HairlineStrong",
		Thickness = 1,
		Transparency = 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
	rule(".Ghost:Hover", STATE, { BackgroundTransparency = 0 })
	rule(".Ghost:Press", STATE, { TextColor3 = "$SignalFault" })
	rule(".Ghost:Press::UIStroke", STATE, { Color = "$SignalFault" })
	ghost:SetPropertyTransition("BackgroundTransparency", EASE_FAST)
	ghost:SetPropertyTransition("TextColor3", EASE_FAST)
	ghostStroke:SetPropertyTransition("Color", EASE_FAST)

	-- GuiState has no Disabled, so an off control is Interactable = false and styled here. It goes
	-- fully transparent rather than to a filled slab, so the one live control keeps the weight.
	rule(".Btn:NonInteractable", OFF, {
		BackgroundTransparency = 1,
		TextColor3 = "$InkFaint",
	})
	rule(".Btn:NonInteractable::UIStroke", OFF, { Transparency = 1 })

	rule("#Disclosure", BASE, {
		FontFace = "$FontUI",
		TextSize = "$SizeMicro",
		TextColor3 = "$InkDim",
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		BorderSizePixel = 0,
	})
	local disclosureHover = rule("#Disclosure:Hover", STATE, { TextColor3 = "$Ink" })
	disclosureHover:SetPropertyTransition("TextColor3", EASE_FAST)

	-- The narrow layout is a media query, not a second code path: the button row's UIListLayout
	-- is phantom, so the @Narrow rule simply overrides it.
	rule("#ButtonRow::UIListLayout", BASE, {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Center,
	})
	rule("@Narrow::UIListLayout", ROLE, { FillDirection = Enum.FillDirection.Vertical })
	rule("@Narrow >> .Btn", ROLE, { Size = UDim2.new(1, 0, 0, 34) })

	sheets = { style = style, dark = darkSheet, light = lightSheet }
end

local function applySignal()
	local live = sheets
	if not live then
		return
	end
	live.dark:SetAttribute("Signal", DARK["Signal" .. signalName])
	live.light:SetAttribute("Signal", LIGHT["Signal" .. signalName])
end

-- Creates the sheets on first call, then links them to `root` and everything beneath it.
function Style.Attach(root: Instance)
	if not sheets then
		build(root)
	end
	local live = sheets :: any

	local link = Instance.new("StyleLink")
	link.Name = "VmcpStyleLink"
	link.StyleSheet = live.style
	link.Parent = root

	applySignal()
end

-- `name` is one of Idle, Work, Live, Fault.
function Style.SetSignal(name: string)
	if signalName == name then
		return
	end
	signalName = name
	applySignal()
end

function Style.SetTheme(isDark: boolean)
	local live = sheets
	if not live then
		dark = isDark
		return
	end
	if dark == isDark then
		return
	end
	dark = isDark

	live.style:SetDerives({ if isDark then live.dark else live.light })
end

function Style.Destroy()
	local live = sheets
	if not live then
		return
	end
	live.style:Destroy()
	live.dark:Destroy()
	live.light:Destroy()
	sheets = nil
end

return Style
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="ModuleScript" referent="30">
      <Properties>
        <string name="Name">Path</string>
        <string name="Source"><![CDATA[--!strict
--!optimize 2

-- Turns a dotted DataModel path like "Workspace.Rig.Torso" into the Instance it names, and says
-- which segment went missing when it can't. Every tool that takes a `root` argument goes through
-- this, so they all fail the same readable way.

local Path = {}

function Path.Resolve(path: string): (Instance?, string?)
	local current: Instance = game
	for segment in string.gmatch(path, "[^%.]+") do
		if current == game then
			if segment == "game" then
				continue
			end
			-- A service that has never been touched isn't a child of game yet, so FindFirstChild
			-- alone would miss half the DataModel.
			local ok, service = pcall(game.GetService, game, segment)
			if ok and service then
				current = service
				continue
			end
		end

		local child = current:FindFirstChild(segment)
		if not child then
			return nil, `no instance at "{path}" -- "{segment}" isn't under {current:GetFullName()}`
		end
		current = child
	end
	return current, nil
end

return Path
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="31">
      <Properties>
        <string name="Name">Playtest</string>
      </Properties>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">Session</string>
          <string name="Source"><![CDATA[--!strict

-- Starting and stopping the one playtest a Studio window is allowed to have.
--
-- There is very little to it now. Nothing is injected into the place and nothing is saved, because
-- the plugin loads into the playtest's DataModels by itself -- so all this does is press the
-- button and remember whether it was the one that pressed it.

local Session = {}

local state = {
	ours = false,
	players = 0,
	startedAt = 0,
}

local function service(): any
	return game:GetService("StudioTestService")
end

function Session.IsRunning(): boolean
	return not service().EditModeActive
end

-- One player gets Play Solo: a single DataModel that is both server and client, and far quicker to
-- start than the real thing. Two or more needs a genuine multiplayer test.
function Session.Start(players: number): string?
	if Session.IsRunning() then
		return "a playtest is already running -- stop that one first"
	end

	state.ours = true
	state.players = players
	state.startedAt = os.clock()

	-- Both calls yield until the test ends, and the plugin has to stay answerable the whole time a
	-- session is open, so the waiting happens on its own thread.
	task.spawn(function()
		local studio = service()
		local ok, failure
		if players <= 1 then
			ok, failure = pcall(studio.ExecutePlayModeAsync, studio, {})
		else
			ok, failure = pcall(studio.ExecuteMultiplayerTestAsync, studio, players, {})
		end
		if not ok then
			warn(`[VMCP] the playtest would not start: {failure}`)
		end
		state.ours = false
	end)
	return nil
end

function Session.Status(): { [string]: any }
	local running = Session.IsRunning()
	return {
		running = running,
		-- Studio's own Play button counts as a playtest; it just is not one we started, so we
		-- should not stop it out from under anyone either.
		ours = running and state.ours,
		players = if running then state.players else nil,
		seconds = if running then math.floor(os.clock() - state.startedAt) else nil,
	}
end

function Session.Forget()
	state.ours = false
end

return Session
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">Swap</string>
          <string name="Source"><![CDATA[--!strict

-- Starts a playtest that runs different Source in some scripts than the place has, without the
-- place ever holding it.
--
-- A playtest copies every script at start, so the trick is timing: write the replacement Source
-- in the edit DataModel, start the test, wait until its server is up, put the original back. The
-- playtest keeps the swapped copies until it stops; Studio's copy was different for a few
-- seconds and is untouched again by the time anyone reads it. Nothing is saved, and nothing lands
-- on disk -- Rojo only syncs toward Studio.
--
-- profile_scripts uses this to get its debug.profilebegin sections in; try_scripts uses it to let
-- the user play the candidate fix before it's applied anywhere.

local Bridge = require(script.Parent.Parent.Bridge)
local Session = require(script.Parent.Session)

local PEER_TIMEOUT = 90
local STOP_TIMEOUT = 30

local Swap = {}

export type Replacement = { instance: Instance, source: string }

local function stopRunning(): string?
	Bridge.Invoke("peer", { action = "stop", context = "server" }, 20)
	Session.Forget()
	local deadline = os.clock() + STOP_TIMEOUT
	while Session.IsRunning() and os.clock() < deadline do
		task.wait(0.25)
	end
	return if Session.IsRunning() then "the running playtest wouldn't stop" else nil
end

-- A playtest DataModel takes a few seconds to boot and connect, and there's no event for it.
function Swap.WaitFor(context: string, player: number?): string?
	local deadline = os.clock() + PEER_TIMEOUT
	local last = "never answered"
	repeat
		local reached, result = Bridge.Invoke("peer", { action = "ping", context = context, player = player }, 10)
		if reached and result ~= nil and result.isError ~= true then
			return nil
		end
		last = if reached then "not up yet" else tostring(result)
		task.wait(0.5)
	until os.clock() >= deadline
	return `the {context} never came up ({last})`
end

-- Reads each script once so the caller gets the text to build a replacement from, and the exact
-- text to restore.
function Swap.ReadSource(instance: Instance): (string?, string?)
	if not instance:IsA("LuaSourceContainer") then
		return nil, `{instance:GetFullName()} is a {instance.ClassName}, not a script`
	end
	local readable, source = pcall(function()
		return (instance :: any).Source
	end)
	if not readable or type(source) ~= "string" then
		return nil, `couldn't read {instance:GetFullName()} -- allow script injection for VMCP in Plugin Management`
	end
	return source, nil
end

-- Swaps, starts, waits for `context` to answer, restores. `restarted` says whether a playtest
-- that was already running had to be stopped first. `temporary` instances ride along the same
-- way: parented for the boot, destroyed once the playtest has its copy.
function Swap.Start(
	replacements: { Replacement },
	players: number,
	context: string,
	player: number?,
	temporary: { Instance }?
): (string?, boolean)
	local restarted = false
	if Session.IsRunning() then
		local failure = stopRunning()
		if failure then
			return failure, false
		end
		restarted = true
	end

	local originals: { Replacement } = {}
	local function restore()
		for _, original in originals do
			pcall(function()
				(original.instance :: any).Source = original.source
			end)
		end
		if temporary then
			for _, instance in temporary do
				instance:Destroy()
			end
		end
	end

	for _, replacement in replacements do
		local current, why = Swap.ReadSource(replacement.instance)
		if not current then
			restore()
			return why, restarted
		end
		table.insert(originals, { instance = replacement.instance, source = current })
		local written = pcall(function()
			(replacement.instance :: any).Source = replacement.source
		end)
		if not written then
			restore()
			return `couldn't write {replacement.instance:GetFullName()}`, restarted
		end
	end

	local failure = Session.Start(math.clamp(players, 1, 8))
	if failure then
		restore()
		return failure, restarted
	end

	local notUp = Swap.WaitFor(context, player)
	restore()
	return notUp, restarted
end

return Swap
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="34">
      <Properties>
        <string name="Name">Timeline</string>
      </Properties>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">Runtime</string>
          <string name="Source"><![CDATA[--!strict

-- The two halves of running a timeline inside one DataModel: the shared context, and the clock.
--
-- The context isn't held here. The edit DataModel, the test server and each test client are
-- separate processes running separate copies of this plugin, so the socket back to VMCP is the
-- only thing all of them can touch -- every read and write is a round trip. That's slower than a
-- table and it's the only version that's actually correct, so treat `ctx.thing` as a network read
-- and pull it into a local if you need it more than once.

local UserInputService = game:GetService("UserInputService")

local Bridge = require(script.Parent.Parent.Bridge)

local Runtime = {}

export type Event = {
	at: number,
	blocking: boolean?,
	label: string?,
	run: (ctx: any, input: any, vmcp: any) -> ...any,
}

local DEFAULT_AWAIT = 5
-- Await polls instead of waiting on a signal, because what it's waiting for may be set in another
-- process entirely. Every tick is a round trip, so this is deliberately slower than a frame.
local AWAIT_POLL = 0.05

local Methods = {}

local function origin(self: any): string
	return rawget(self, "__origin") :: string
end

-- Blocks until another context sets `key`. This is what turns a racy read into something the
-- payload declares rather than a coin flip, and a miss is recorded -- so an assertion that fails
-- because the value never arrived says so, instead of quietly reading nil.
function Methods.Await(self: any, key: string, timeout: number?): any
	local limit = timeout or DEFAULT_AWAIT
	local deadline = os.clock() + limit

	repeat
		local value = Bridge.CtxGet(key)
		if value ~= nil then
			return value
		end
		task.wait(AWAIT_POLL)
	until os.clock() >= deadline

	Bridge.CtxNote(`[{origin(self)}] Await("{key}") gave up after {limit}s`)
	return nil
end

function Methods.Note(self: any, text: string)
	Bridge.CtxNote(`[{origin(self)}] {text}`)
end

function Methods.Snapshot(_: any): { [string]: any }
	local snapshot = Bridge.CtxSnapshot()
	return if snapshot then snapshot.values else {}
end

local Proxy = {
	__index = function(self: any, key: string): any
		local method = Methods[key]
		if method then
			return method
		end
		return Bridge.CtxGet(key)
	end,
	__newindex = function(self: any, key: string, value: any)
		Bridge.CtxSet(key, value, origin(self))
	end,
}

-- `where` names this context in the write log: "plugin", "server", "client 2".
function Runtime.Context(where: string): any
	return setmetatable({ __origin = where }, Proxy)
end

-- How late an event may fire before it's worth mentioning. A frame of slop is normal; a tenth of
-- a second means something before it ran long.
local OVERRUN = 0.1

-- Fires each event when its time comes, then holds until `duration` so trailing effects land. A
-- yielding event never delays the next one unless it asked to with `blocking`, which is what a
-- setup step wants. Running late is recorded rather than silently shifting everything after it.
function Runtime.Run(events: { Event }, ctx: any, input: any, vmcp: any, duration: number, note: (string) -> ())
	table.sort(events, function(a, b)
		return a.at < b.at
	end)

	local started = os.clock()
	local function fire(event: Event)
		local ok, err = pcall(event.run, ctx, input, vmcp)
		if not ok then
			local label = if event.label then ` ({event.label})` else ""
			note(`event at {event.at}s{label} failed: {err}`)
		end
	end

	for _, event in events do
		local elapsed = os.clock() - started
		if event.at > elapsed then
			task.wait(event.at - elapsed)
		elseif elapsed - event.at > OVERRUN then
			note(`event at {event.at}s fired {string.format("%.2f", elapsed - event.at)}s late`)
		end

		if event.blocking then
			fire(event)
		else
			task.spawn(fire, event)
		end
	end

	local remaining = duration - (os.clock() - started)
	if remaining > 0 then
		task.wait(remaining)
	end
end

local BUTTONS: { [string]: Enum.UserInputType } = {
	left = Enum.UserInputType.MouseButton1,
	right = Enum.UserInputType.MouseButton2,
	middle = Enum.UserInputType.MouseButton3,
}

local TAP_SECONDS = 0.05

-- Every one of these throws on contact with the topbar, a core-bound key like Escape, a button
-- that's already down, or a mouse delta without a locked cursor. A failed keypress should cost
-- one line in the log, not the whole run, so each call is wrapped and the reason kept.
function Runtime.Input(): any
	local virtual = (UserInputService :: any):CreateVirtualInput()
	local held: { [string]: Enum.KeyCode? } = {}
	local down: { [string]: Enum.UserInputType? } = {}
	local input = { problems = {} :: { string } }

	local function attempt(what: string, action: () -> ...any): boolean
		local ok, err = pcall(action)
		if not ok then
			table.insert(input.problems, `{what}: {err}`)
		end
		return ok
	end

	local function keyCode(name: string): Enum.KeyCode?
		local code = (Enum.KeyCode :: any)[name]
		if not code then
			table.insert(input.problems, `no KeyCode named "{name}"`)
		end
		return code
	end

	function input.Hold(_: any, name: string)
		local code = keyCode(name)
		if not code or held[name] then
			return
		end
		local pressed = attempt(`Hold "{name}"`, function()
			virtual:SendKey(true, code)
		end)
		if pressed then
			held[name] = code
		end
	end

	function input.Release(_: any, name: string)
		local code = held[name]
		if not code then
			return
		end
		held[name] = nil
		attempt(`Release "{name}"`, function()
			virtual:SendKey(false, code)
		end)
	end

	function input.Tap(self: any, name: string, hold: number?)
		input.Hold(self, name)
		task.wait(hold or TAP_SECONDS)
		input.Release(self, name)
	end

	function input.Move(_: any, x: number, y: number)
		attempt(`Move to {x},{y}`, function()
			virtual:SendMousePosition(Vector2.new(x, y))
		end)
	end

	function input.Click(self: any, x: number, y: number, button: string?)
		local name = button or "left"
		local which = BUTTONS[name]
		if not which then
			table.insert(input.problems, `no mouse button named "{name}"`)
			return
		end

		local at = Vector2.new(x, y)
		input.Move(self, x, y)
		local pressed = attempt(`Click {name} at {x},{y}`, function()
			virtual:SendMouseButton(at, which, true)
		end)
		if not pressed then
			return
		end

		down[name] = which
		task.wait(TAP_SECONDS)
		down[name] = nil
		attempt(`Release {name} button`, function()
			virtual:SendMouseButton(at, which, false)
		end)
	end

	function input.Drag(self: any, x1: number, y1: number, x2: number, y2: number, steps: number?)
		local count = math.max(steps or 10, 1)
		local from, to = Vector2.new(x1, y1), Vector2.new(x2, y2)

		input.Move(self, x1, y1)
		local pressed = attempt("Drag press", function()
			virtual:SendMouseButton(from, Enum.UserInputType.MouseButton1, true)
		end)
		if not pressed then
			return
		end
		down.left = Enum.UserInputType.MouseButton1

		for step = 1, count do
			local point = from:Lerp(to, step / count)
			attempt("Drag move", function()
				virtual:SendMousePosition(point)
			end)
			task.wait()
		end

		down.left = nil
		attempt("Drag release", function()
			virtual:SendMouseButton(to, Enum.UserInputType.MouseButton1, false)
		end)
	end

	function input.Type(_: any, text: string)
		attempt(`Type {#text} chars`, function()
			virtual:SendTextInput(text)
		end)
	end

	function input.Scroll(_: any, x: number, y: number, amount: number)
		attempt(`Scroll {amount}`, function()
			virtual:SendPointerAction(Vector2.new(x, y), { Wheel = amount })
		end)
	end

	-- Runs at teardown however the run ended, because a Hold whose Release never came -- an event
	-- that errored between the two, say -- leaves that key down for everything after it.
	function input.ReleaseEverything(_: any)
		for name, code in held do
			held[name] = nil
			attempt(`Release "{name}"`, function()
				virtual:SendKey(false, code)
			end)
		end
		for name, which in down do
			down[name] = nil
			attempt(`Release {name} button`, function()
				virtual:SendMouseButton(Vector2.zero, which, false)
			end)
		end
	end

	return input
end

return Runtime
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="36">
      <Properties>
        <string name="Name">Tools</string>
      </Properties>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">ApplyBuild</string>
          <string name="Source"><![CDATA[--!strict

-- One pass of the build loop in one call: run the code, measure what it made, say what's wrong,
-- draw it. The code is the thing being iterated on -- it's the only description of the build that
-- holds every part at once -- so everything this returns is meant to be read next to the source
-- and turned into an edit to it.

local Build = require(script.Parent.Parent.Lib.Build)
local Path = require(script.Parent.Parent.Path)

local BADGE_LIMIT = 40
local MAX_PARTS = 1500

-- Problem lines from the last apply, per root. Intentional ones (rubble sunk into the ground)
-- would otherwise be printed again on every pass for the rest of the build.
local remembered: { [Instance]: { [string]: boolean } } = setmetatable({}, { __mode = "k" }) :: any

local function newProblems(root: Instance, problems: { Build.Problem }): ({ Build.Problem }, number, number)
	local seen: { [string]: boolean } = remembered[root] or {}
	local current: { [string]: boolean } = {}
	local fresh = {}
	for _, problem in problems do
		local key = `{problem.part:GetFullName()} -- {problem.kind}: {problem.detail}`
		current[key] = true
		if not seen[key] then
			table.insert(fresh, problem)
		end
	end
	local resolved = 0
	for key in seen do
		if not current[key] then
			resolved += 1
		end
	end
	remembered[root] = current
	return fresh, #problems - #fresh, resolved
end

type Result = {
	content: { { type: "text", text: string } },
	isError: boolean?,
	postProcess: { [string]: any }?,
}

local Tool = {}

Tool.Definition = {
	name = "apply_build",
	description = "Runs build code against a root, then checks the geometry and draws it -- one "
		.. "call per pass of the write, check, fix loop. The code is the `return function(root)` "
		.. "shape get_build produces, and it should hold the whole build: a build lives in its "
		.. "source, not in a picture, so keep the full source and edit it between passes rather "
		.. "than placing parts one call at a time. What comes back is numbers first -- bounds, "
		.. "the extent of each top-level group, and a problem list with the depth and axis of "
		.. "every overlap, gaps under floating parts, near-square rotations, duplicates and "
		.. "strays -- then a legend and one blockout picture. Fix from the numbers; use the "
		.. "picture for proportions and whether the layout reads.",
	inputSchema = {
		type = "object",
		properties = {
			code = {
				type = "string",
				description = "Luau source ending in `return function(root) ... end`. `ensure(parent, "
					.. "name, class)` inside it updates by name, so re-applying moves only what changed.",
			},
			file = {
				type = "string",
				description = "Path to a file holding the source, read by the VMCP server on the machine "
					.. "it runs on; absolute or relative to the server's working directory. Use this "
					.. "instead of code once the build lives in a file: edit the file, apply by path, "
					.. "and the source never has to be re-sent.",
			},
			root = {
				type = "string",
				description = 'Dotted path, like "Workspace.Arena". If the last segment is missing a '
					.. "Model with that name is made under its parent. Defaults to Workspace.",
			},
			clear = {
				type = "boolean",
				description = "Destroy everything under the root before applying, so renamed or "
					.. "removed parts don't linger. Off by default.",
			},
			views = {
				type = "array",
				description = "Angles to draw, tiled into one image. Defaults to iso. Named: iso, "
					.. "corner, front, back, left, right, top, bottom; or { yaw, pitch, name } in degrees. "
					.. "Add at ({x, y, z} or a dotted path to a part or model) and radius (studs) to "
					.. "centre and scale a panel on one spot; clip = true hides parts further than "
					.. "radius from it.",
				items = { type = { "string", "object" } },
				maxItems = 9,
			},
			size = {
				type = "integer",
				description = "Pixels per view. Defaults to 512.",
				minimum = 128,
				maximum = 1024,
			},
			name = {
				type = "string",
				description = "Image file name, letters digits underscore hyphen. Defaults to a timestamp.",
			},
			render = {
				type = "boolean",
				description = "Draw the picture. On by default; off saves the image when only the "
					.. "numbers are needed.",
			},
			badges = {
				type = "boolean",
				description = `Number each part in the picture and list it in the legend. On by default when the panels show up to {BADGE_LIMIT} parts (clipped panels count only what's in frame).`,
			},
		},
		-- One of code or file; the server turns file into code before it gets here.
		required = {},
	},
	tags = { title = "Apply Build", destructive = true },
	timeoutMs = 60000,
}

local function resolveOrCreate(path: string): (Instance?, string?)
	local found, problem = Path.Resolve(path)
	if found then
		return found, nil
	end
	local parentPath, name = string.match(path, "^(.*)%.([^%.]+)$")
	if not parentPath then
		return nil, problem
	end
	local parent = Path.Resolve(parentPath :: string)
	if not parent then
		return nil, problem
	end
	local model = Instance.new("Model")
	model.Name = name :: string
	model.Parent = parent
	return model, nil
end

function Tool.Run(arguments: {
	code: string?,
	root: string?,
	clear: boolean?,
	views: { any }?,
	size: number?,
	name: string?,
	render: boolean?,
	badges: boolean?,
}): Result
	local code = arguments.code
	if type(code) ~= "string" or code == "" then
		return { content = { { type = "text", text = "pass code or file" } }, isError = true }
	end

	local root: Instance = workspace
	if type(arguments.root) == "string" and arguments.root ~= "" then
		local found, problem = resolveOrCreate(arguments.root :: string)
		if not found then
			return { content = { { type = "text", text = problem :: string } }, isError = true }
		end
		root = found
	end

	if arguments.clear then
		root:ClearAllChildren()
	end

	local ok, failure = Build.Apply(code, root)
	local parts, instances, capped = Build.Geometry(root, MAX_PARTS)
	local count = #instances

	local lines = {}
	if ok then
		table.insert(
			lines,
			`applied: {#root:GetDescendants()} instance(s) under {root:GetFullName()}, {count} of them parts`
		)
	else
		-- The failure line comes first and the report still follows: whatever ran before the
		-- error is in the place now, and knowing what that looks like is how you fix the code.
		table.insert(lines, `error: {failure}`)
		table.insert(lines, `{count} part(s) under {root:GetFullName()} after the partial run`)
	end
	if capped then
		table.insert(lines, `stopped measuring at {count} parts -- there are more`)
	end

	if count == 0 then
		table.insert(lines, "no parts to check or draw")
		return { content = { { type = "text", text = table.concat(lines, "\n") } }, isError = not ok }
	end

	local render = arguments.render ~= false
	local views, missing = Build.ResolveViews(arguments.views or { "iso" })
	local shown = Build.Shown(instances, views)
	local shownCount = 0
	for _ in shown do
		shownCount += 1
	end
	local badges = if arguments.badges ~= nil then arguments.badges else shownCount <= BADGE_LIMIT
	local problems, unchanged, resolved = newProblems(root, Build.Problems(root, MAX_PARTS, instances))
	table.insert(lines, Build.Report(root, instances, if badges and render then shown else nil, problems))
	if unchanged > 0 then
		table.insert(lines, `{unchanged} from the last apply still there, not repeated`)
	end
	if resolved > 0 then
		table.insert(lines, `{resolved} from the last apply gone`)
	end
	for _, problem in missing do
		table.insert(lines, `view target not found, drawing the whole build instead: {problem}`)
	end

	return {
		content = { { type = "text", text = table.concat(lines, "\n") } },
		isError = not ok,
		postProcess = if render
			then {
				kind = "scene",
				name = arguments.name,
				size = arguments.size,
				views = views,
				badges = badges,
				parts = parts,
			}
			else nil,
	}
end

return Tool
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">ApplyFix</string>
          <string name="Source"><![CDATA[--!strict

-- The one step that changes the game, with a net under it: write the script's file on disk, wait
-- for Rojo to carry it into Studio, start a fresh playtest with the previous version planted next
-- to it, run the caller's check in the game VM, and put the old file back if anything failed.
--
-- Everything before this in the loop was reversible by stopping a playtest. This is reversible
-- by the same tool, automatically, which is what lets it run unattended.

local ServerStorage = game:GetService("ServerStorage")

local Bridge = require(script.Parent.Parent.Bridge)
local Path = require(script.Parent.Parent.Path)
local Session = require(script.Parent.Parent.Playtest.Session)
local Swap = require(script.Parent.Parent.Playtest.Swap)

local SYNC_TIMEOUT = 20
local PREVIOUS_PREFIX = "__VMCP_Previous_"

type Result = {
	content: { { type: "text", text: string } },
	isError: boolean?,
}

local Tool = {}

Tool.Definition = {
	name = "apply_fix",
	description = "Applies a candidate to the real script: writes the file Rojo syncs it from, waits "
		.. "for Studio to pick it up, restarts the playtest, and runs your `check` in the game VM "
		.. "with the previous version available as ServerStorage.__VMCP_Previous_<Name> for an "
		.. "Equiv.Check against the live one. If the sync never lands, the check errors or returns "
		.. "anything but true, or the server logs an error, the old file is written back and the "
		.. "reply says why. On success the playtest stays up running the applied code -- hand it to "
		.. "the user. Only call this after the user has said yes.",
	inputSchema = {
		type = "object",
		properties = {
			script = { type = "string", description = 'Dotted path, like "ServerScriptService.Combat".' },
			source = { type = "string", description = "The complete new Source." },
			check = {
				type = "string",
				description = "Luau body run in the game VM after the restart. Return true to pass; "
					.. "anything else (a string, an Equiv result's text) fails and reverts. "
					.. "`require(game.ServerStorage.__VMCP_Previous_<Name>)` is the old module; "
					.. "`require(game.ServerScriptService.<path>.__VMCP_Equiv)` next to the game bridge "
					.. "has Equiv.Check. Optional but strongly encouraged.",
			},
			players = {
				type = "integer",
				minimum = 1,
				maximum = 8,
				description = "Players for the playtest. Defaults to 1.",
			},
		},
		required = { "script", "source" },
	},
	tags = { title = "Apply Fix", destructive = true },
	timeoutMs = 240000,
}

local function text(body: string, isError: boolean?): Result
	return { content = { { type = "text", text = body } }, isError = isError }
end

local function normalise(source: string): string
	return (source:gsub("\r\n", "\n"):gsub("%s+$", ""))
end

-- Rojo pushes disk changes into Studio on its own clock; this is the only way to know it did.
local function waitForSync(instance: Instance, wanted: string): boolean
	local target = normalise(wanted)
	local deadline = os.clock() + SYNC_TIMEOUT
	repeat
		local current = Swap.ReadSource(instance)
		if current and normalise(current) == target then
			return true
		end
		task.wait(0.5)
	until os.clock() >= deadline
	return false
end

local function writeFile(path: string, className: string, source: string): (boolean, any)
	return Bridge.Request("source/write", { path = path, className = className, source = source }, 15)
end

function Tool.Run(arguments: { script: string?, source: string?, check: string?, players: number? }): Result
	if type(arguments.script) ~= "string" or type(arguments.source) ~= "string" or arguments.source == "" then
		return text("apply_fix needs script and source", true)
	end
	local instance, why = Path.Resolve(arguments.script :: string)
	if not instance then
		return text(why :: string, true)
	end
	local before, unreadable = Swap.ReadSource(instance)
	if not before then
		return text(unreadable :: string, true)
	end

	local written, reply = writeFile(instance:GetFullName(), instance.ClassName, arguments.source :: string)
	if not written then
		return text(`couldn't write the file: {tostring(reply)}`, true)
	end
	local file: string = reply.file
	local previousOnDisk: string = reply.previous

	local function revert(reason: string): Result
		local restored, failure = writeFile(instance:GetFullName(), instance.ClassName, previousOnDisk)
		local note = if restored
			then `{file} is back to what it was`
			else `AND the revert failed ({tostring(failure)}) -- {file} holds the candidate, restore it by hand`
		if Session.IsRunning() then
			Bridge.Invoke("peer", { action = "stop", context = "server" }, 20)
			Session.Forget()
		end
		return text(`NOT applied: {reason}\n{note}`, true)
	end

	if not waitForSync(instance, arguments.source :: string) then
		return revert(
			`wrote {file} but Studio's copy didn't change within {SYNC_TIMEOUT}s -- is the Rojo plugin connected?`
		)
	end

	-- The previous version rides into the playtest as a sibling module, so a check can require
	-- both and compare them in the same VM. Archivable stays on: the playtest copies the place the
	-- way a save would, and Swap destroys it the moment the copy exists.
	local previous: Instance = Instance.new("ModuleScript")
	previous.Name = PREVIOUS_PREFIX .. instance.Name;
	(previous :: ModuleScript).Source = before
	previous.Parent = ServerStorage

	local failure = Swap.Start({}, math.clamp(arguments.players or 1, 1, 8), "server", nil, { previous })
	if failure then
		return revert(`the playtest wouldn't start: {failure}`)
	end

	local lines = { `applied to {file}; Studio synced; playtest restarted` }
	if type(arguments.check) == "string" and arguments.check ~= "" then
		local reached, result = Bridge.Invoke("run_luau", {
			context = "server",
			vm = "game",
			code = arguments.check,
			timeoutSeconds = 60,
		}, 90)
		if not reached then
			return revert(`the check couldn't run: {tostring(result)}`)
		end
		local body = ""
		for _, item in result.content or {} do
			if type(item.text) == "string" then
				body ..= item.text
			end
		end
		if result.isError or not string.match(body, "^returned: true") then
			return revert(`the check didn't pass:\n{body}`)
		end
		table.insert(lines, "check passed")
	end

	local _, logs = Bridge.Invoke("get_logs", { context = "server", severity = "error", sinceSeconds = 30 }, 10)
	local errorText = ""
	for _, item in (logs and logs.content) or {} do
		if type(item.text) == "string" then
			errorText ..= item.text
		end
	end
	if errorText ~= "" and not string.find(errorText, "^no log lines") then
		return revert(`the server logged errors after the restart:\n{errorText}`)
	end

	table.insert(lines, "no server errors since the restart")
	table.insert(lines, "The playtest is running the applied code -- have the user play it now.")
	return text(table.concat(lines, "\n"))
end

return Tool
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">CountLines</string>
          <string name="Source"><![CDATA[--!strict

local Path = require(script.Parent.Parent.Path)

local DEFAULT_MAX_RESULTS = 50
local HARD_MAX_RESULTS = 500
local EXCLUDE_TAG = "excludeLOC"

type Result = {
	content: { { type: "text", text: string } },
	isError: boolean?,
}

local Tool = {}

Tool.Definition = {
	name = "count_lines",
	description = "Lines of code for every script under a root, biggest first, with totals and a hot "
		.. "column (per-frame connections, while-true loops, connect count) since a 40-line Heartbeat "
		.. "handler outranks a 2000-line shop. Skips any "
		.. `script tagged {EXCLUDE_TAG} and anything under an instance with that tag -- tag LibMP, `
		.. "vendored libraries and the VMCP plugin itself so they don't dominate the list. This is "
		.. "the first step of a performance pass: the long scripts are where the frame time usually "
		.. "is, so read the top of this list and hand the suspects to profile_scripts.",
	inputSchema = {
		type = "object",
		properties = {
			root = {
				type = "string",
				description = 'Dotted path to count under, like "ServerScriptService". Defaults to game.',
			},
			maxResults = {
				type = "integer",
				description = "How many scripts to list. Defaults to 50. Totals always cover everything.",
				minimum = 1,
				maximum = HARD_MAX_RESULTS,
			},
			minLines = {
				type = "integer",
				description = "Leave out scripts shorter than this. Defaults to 0.",
				minimum = 0,
			},
		},
	},
	tags = { title = "Count Lines", readOnly = true, idempotent = true },
}

type Entry = {
	path: string,
	className: string,
	lines: number,
	code: number,
	perFrame: number,
	polling: number,
	connects: number,
}

-- Cheap signals that a script does per-frame work, which ranks better than length does.
local PER_FRAME_PATTERNS = {
	"Heartbeat:Connect",
	"RenderStepped:Connect",
	"Stepped:Connect",
	"PreSimulation:Connect",
	"PostSimulation:Connect",
	"PreRender:Connect",
	"PreAnimation:Connect",
	"BindToRenderStep",
}

local function countHot(source: string): (number, number, number)
	local perFrame = 0
	for _, pattern in PER_FRAME_PATTERNS do
		local _, hits = string.gsub(source, pattern, "")
		perFrame += hits
	end
	local _, polling = string.gsub(source, "while%s+true%s+do", "")
	local _, connects = string.gsub(source, ":Connect%(", "")
	return perFrame, polling, connects
end

-- Total lines and lines that aren't blank or a bare comment, so a script that's half header
-- comments doesn't outrank one that's all logic.
local function measure(source: string): (number, number)
	local lines, code = 0, 0
	for line in string.gmatch(source .. "\n", "([^\n]*)\n") do
		lines += 1
		local trimmed = string.match(line, "^%s*(.-)%s*$") :: string
		if trimmed ~= "" and string.sub(trimmed, 1, 2) ~= "--" then
			code += 1
		end
	end
	return lines, code
end

function Tool.Run(arguments: { root: string?, maxResults: number?, minLines: number? }): Result
	local root: Instance = game
	if type(arguments.root) == "string" and arguments.root ~= "" then
		local found, why = Path.Resolve(arguments.root :: string)
		if not found then
			return { content = { { type = "text", text = why :: string } }, isError = true }
		end
		root = found
	end

	local excluded: { [Instance]: boolean } = {}
	for _, instance in root:QueryDescendants(`.{EXCLUDE_TAG} >> LuaSourceContainer`) do
		excluded[instance] = true
	end

	local entries: { Entry } = {}
	local unreadable = 0
	local totalLines, totalCode = 0, 0
	for _, instance in root:QueryDescendants(`LuaSourceContainer:not(.{EXCLUDE_TAG})`) do
		if excluded[instance] then
			continue
		end
		-- Reading Source needs script injection allowed for the plugin.
		local readable, source = pcall(function()
			return (instance :: any).Source
		end)
		if not readable or type(source) ~= "string" then
			unreadable += 1
			continue
		end
		local lines, code = measure(source)
		local perFrame, polling, connects = countHot(source)
		totalLines += lines
		totalCode += code
		table.insert(entries, {
			path = instance:GetFullName(),
			className = instance.ClassName,
			lines = lines,
			code = code,
			perFrame = perFrame,
			polling = polling,
			connects = connects,
		})
	end

	table.sort(entries, function(a, b)
		return a.lines > b.lines
	end)

	local minLines = arguments.minLines or 0
	local limit = math.clamp(arguments.maxResults or DEFAULT_MAX_RESULTS, 1, HARD_MAX_RESULTS)
	local out = {
		`{#entries} script(s) under {root:GetFullName()}: {totalLines} lines, {totalCode} of them code`,
		"",
	}
	local shown = 0
	for _, entry in entries do
		if entry.lines < minLines then
			break
		end
		if shown >= limit then
			table.insert(out, `-- {#entries - shown} more; raise maxResults or set minLines`)
			break
		end
		shown += 1
		local hot = {}
		if entry.perFrame > 0 then
			table.insert(hot, `{entry.perFrame} per-frame`)
		end
		if entry.polling > 0 then
			table.insert(hot, `{entry.polling} while-true`)
		end
		if entry.connects > 0 then
			table.insert(hot, `{entry.connects} connect`)
		end
		table.insert(
			out,
			string.format(
				"%6d  (%5d code)  %-12s %s%s",
				entry.lines,
				entry.code,
				entry.className,
				entry.path,
				if #hot > 0 then "  [" .. table.concat(hot, ", ") .. "]" else ""
			)
		)
	end
	if unreadable > 0 then
		table.insert(
			out,
			`-- {unreadable} script(s) couldn't be read (allow script injection for VMCP in Plugin Management)`
		)
	end

	return { content = { { type = "text", text = table.concat(out, "\n") } } }
end

return Tool
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">GetBuild</string>
          <string name="Source"><![CDATA[--!strict

local Build = require(script.Parent.Parent.Lib.Build)
local Path = require(script.Parent.Parent.Path)

type Result = {
	content: { { type: "text", text: string } },
	isError: boolean?,
}

local Tool = {}

Tool.Definition = {
	name = "get_build",
	description = "Returns a region of the place as Luau that rebuilds it -- one line per property "
		.. "that differs from the class default, plus attributes and tags. Use it instead of "
		.. "get_tree when you intend to change something: a tree dump tells you what's there, this "
		.. "gives you something you can edit and run back. The generated code updates what's "
		.. "already there rather than duplicating it, so applying an edited version only moves "
		.. "what actually changed. Run it back with run_luau.",
	inputSchema = {
		type = "object",
		properties = {
			root = {
				type = "string",
				description = 'Dotted path to the region, like "Workspace.Arena". Defaults to Workspace.',
			},
			depth = {
				type = "integer",
				description = "How many levels below the root to include. Defaults to 12.",
				minimum = 1,
				maximum = 12,
			},
			maxNodes = {
				type = "integer",
				description = "Stop after this many instances. Defaults to 800.",
				minimum = 1,
				maximum = 800,
			},
			tags = {
				type = "boolean",
				description = "Include attributes and CollectionService tags. On by default.",
			},
		},
	},
	tags = { title = "Get Build", readOnly = true, idempotent = true },
}

function Tool.Run(arguments: { root: string?, depth: number?, maxNodes: number?, tags: boolean? }): Result
	local root: Instance = workspace
	if type(arguments.root) == "string" and arguments.root ~= "" then
		local found, problem = Path.Resolve(arguments.root :: string)
		if not found then
			return { content = { { type = "text", text = problem :: string } }, isError = true }
		end
		root = found
	end

	local source, count = Build.Dump(root, {
		depth = arguments.depth,
		maxNodes = arguments.maxNodes,
		tags = arguments.tags,
	})
	if count == 0 then
		return { content = { { type = "text", text = `{root:GetFullName()} has nothing in it` } } }
	end

	return {
		content = {
			{ type = "text", text = `{count} instance(s) under {root:GetFullName()}:\n\n{source}` },
		},
	}
end

return Tool
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">GetLogs</string>
          <string name="Source"><![CDATA[--!strict

local Buffer = require(script.Parent.Parent.Log.Buffer)

local DEFAULT_COUNT = 50
local MAX_COUNT = 300

type Result = {
	content: { { type: "text", text: string } },
	isError: boolean?,
}

local Tool = {}

Tool.Definition = {
	name = "get_logs",
	description = "Reads Studio's output window from a buffer the plugin has been filling since "
		.. "it loaded. This is how you see an error thrown by the place's own scripts -- run_luau "
		.. "only ever shows you output from its own snippet.",
	inputSchema = {
		type = "object",
		properties = {
			count = {
				type = "integer",
				description = "How many of the most recent lines to return. Defaults to 50.",
				minimum = 1,
				maximum = MAX_COUNT,
			},
			severity = {
				type = "string",
				description = "Only lines at this level. Defaults to everything.",
				enum = { "print", "info", "warn", "error" },
			},
			sinceSeconds = {
				type = "number",
				description = "Only lines logged in the last this many seconds.",
				minimum = 1,
			},
			match = {
				type = "string",
				description = "Only lines matching this Luau string pattern (not a regex).",
			},
		},
	},
	tags = { title = "Get Logs", readOnly = true },
}

function Tool.Run(arguments: { count: number?, severity: string?, sinceSeconds: number?, match: string? }): Result
	local all, dropped = Buffer.Since(0)
	local severity = arguments.severity
	local match = arguments.match
	local cutoff = if arguments.sinceSeconds then os.time() - arguments.sinceSeconds else nil

	local kept = {}
	for _, entry in all do
		if severity and entry.severity ~= severity then
			continue
		end
		if cutoff and entry.time < cutoff then
			continue
		end
		if match then
			-- A bad pattern raises rather than returning nothing, and "malformed pattern" is a
			-- much more useful answer than an empty log.
			local ok, found = pcall(string.find, entry.text, match)
			if not ok then
				return {
					content = { { type = "text", text = `match isn't a valid pattern: {found}` } },
					isError = true,
				}
			end
			if not found then
				continue
			end
		end
		table.insert(kept, entry)
	end

	if #kept == 0 then
		return { content = { { type = "text", text = "no log lines matched" } } }
	end

	local count = math.clamp(arguments.count or DEFAULT_COUNT, 1, MAX_COUNT)
	local first = math.max(#kept - count + 1, 1)
	local lines = {}
	for index = first, #kept do
		local entry = kept[index]
		table.insert(lines, `{os.date("%H:%M:%S", entry.time)} [{entry.severity}] {entry.text}`)
	end

	if first > 1 or dropped > 0 then
		table.insert(lines, 1, `-- showing the last {#lines} of {#kept + dropped} lines`)
	end

	return { content = { { type = "text", text = table.concat(lines, "\n") } } }
end

return Tool
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">GetTree</string>
          <string name="Source"><![CDATA[--!strict

local Path = require(script.Parent.Parent.Path)

local DEFAULT_DEPTH = 3
local DEFAULT_MAX_NODES = 300
local HARD_MAX_NODES = 2000

type Result = {
	content: { { type: "text", text: string } },
	isError: boolean?,
}

local Tool = {}

Tool.Definition = {
	name = "get_tree",
	description = "Lists what's under an instance, as an indented tree of name and class. Takes "
		.. "a root so you can look at one model instead of the whole place; the default depth is "
		.. "shallow on purpose. Use the className filter to answer 'where are the Motor6Ds' "
		.. "without reading everything in between.",
	inputSchema = {
		type = "object",
		properties = {
			root = {
				type = "string",
				description = 'Dotted path to start from, like "Workspace.Rig". Defaults to game.',
			},
			depth = {
				type = "integer",
				description = "How many levels below the root to show. Defaults to 3.",
				minimum = 1,
				maximum = 20,
			},
			className = {
				type = "string",
				description = "Only list instances that IsA this class. Their ancestors are still "
					.. "shown so the paths make sense.",
			},
			maxNodes = {
				type = "integer",
				description = "Stop after this many instances. Defaults to 300.",
				minimum = 1,
				maximum = HARD_MAX_NODES,
			},
		},
	},
	tags = { title = "Get Tree", readOnly = true, idempotent = true },
}

type Walk = {
	lines: { string },
	className: string?,
	maxNodes: number,
	depth: number,
	visited: number,
	skipped: number,
}

-- Returns whether anything at or below `instance` matched, so a filtered walk can drop branches
-- that contain nothing interesting instead of printing the whole skeleton.
local function walk(state: Walk, instance: Instance, depth: number): boolean
	if state.visited >= state.maxNodes then
		state.skipped += 1
		return false
	end
	state.visited += 1

	local matched = state.className == nil or instance:IsA(state.className :: string)
	local mark = #state.lines + 1
	table.insert(state.lines, `{string.rep("  ", depth)}{instance.Name} ({instance.ClassName})`)

	if depth < state.depth then
		for _, child in instance:GetChildren() do
			matched = walk(state, child, depth + 1) or matched
		end
	end

	if not matched then
		table.remove(state.lines, mark)
	end
	return matched
end

function Tool.Run(arguments: { root: string?, depth: number?, className: string?, maxNodes: number? }): Result
	local rootPath = arguments.root
	local root: Instance = game
	if type(rootPath) == "string" and rootPath ~= "" then
		local found, problem = Path.Resolve(rootPath)
		if not found then
			return { content = { { type = "text", text = problem :: string } }, isError = true }
		end
		root = found
	end

	local className = arguments.className
	if className ~= nil and type(className) ~= "string" then
		return { content = { { type = "text", text = "className must be a string" } }, isError = true }
	end

	local state: Walk = {
		lines = {},
		className = className,
		maxNodes = math.clamp(arguments.maxNodes or DEFAULT_MAX_NODES, 1, HARD_MAX_NODES),
		depth = math.clamp(arguments.depth or DEFAULT_DEPTH, 1, 20),
		visited = 0,
		skipped = 0,
	}

	walk(state, root, 0)

	if #state.lines == 0 then
		-- IsA returns false for a misspelled class rather than erroring, so an empty result and a
		-- typo are the same thing from here. Saying both beats guessing which one it was.
		local why = if className
			then `nothing under {root:GetFullName()} is a {className} -- check the spelling if you expected hits`
			else `{root:GetFullName()} is empty`
		return { content = { { type = "text", text = why } } }
	end

	if state.skipped > 0 then
		table.insert(state.lines, `-- stopped at {state.maxNodes} instances; raise maxNodes or narrow the root`)
	end

	return { content = { { type = "text", text = table.concat(state.lines, "\n") } } }
end

return Tool
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">InspectStyle</string>
          <string name="Source"><![CDATA[--!strict

-- Answers "why does this rule do nothing" in one call. The engine has no API that says which
-- rules matched an instance, so this lays out everything that decides it: the instance's class,
-- name and tags (the selector's inputs), the direct value next to the styled value next to the
-- class default (the precedence fight), and every rule in the linked sheets that sets the
-- property, with its selector, priority, stored value and SelectorError.

local CollectionService = game:GetService("CollectionService")

local Path = require(script.Parent.Parent.Path)

type Result = {
	content: { { type: "text", text: string } },
	isError: boolean?,
}

local Tool = {}

Tool.Definition = {
	name = "inspect_style",
	description = "Explains what StyleSheet rules did to one instance. For each property: the value set "
		.. "directly on the instance, the value the rules resolved (GetStyled), the class default, and "
		.. "every rule in the linked sheets that sets that property (selector, priority, stored value, "
		.. "SelectorError). Also lists the instance's tags, since `.Name` is a tag and `#Name` is the "
		.. "instance name. A direct value that isn't the class default beats every rule; a rule whose "
		.. "stored value is the class default may not reach a playtest client. Run it with context "
		.. "client to see what the player actually gets.",
	inputSchema = {
		type = "object",
		properties = {
			root = { type = "string", description = "Dotted path to the GuiObject to inspect." },
			properties = {
				type = "array",
				items = { type = "string" },
				description = "Property names to explain. Defaults to the common visual ones.",
			},
			context = {
				type = "string",
				description = "Which DataModel. Defaults to plugin.",
				enum = { "plugin", "server", "client" },
			},
			player = {
				type = "integer",
				description = "Which test client, 1-based. Only meaningful with context client.",
				minimum = 1,
				maximum = 8,
			},
		},
		required = { "root" },
	},
	tags = { title = "Inspect Style", readOnly = true },
	timeoutMs = 15000,
}

local DEFAULT_PROPERTIES: { string } = {
	"BackgroundColor3", "BackgroundTransparency", "TextColor3", "TextSize", "TextXAlignment",
	"FontFace", "ImageColor3", "ImageTransparency", "Size", "Position", "Visible",
}

local function show(value: any): string
	local kind = typeof(value)
	if kind == "Color3" then
		local c = value :: Color3
		return `rgb({math.round(c.R * 255)}, {math.round(c.G * 255)}, {math.round(c.B * 255)})`
	elseif kind == "Font" then
		return (value :: Font).Family:match("([^/]+)%.json$") or tostring(value)
	end
	return tostring(value)
end

-- Every sheet the instance can see: the StyleLinks on it and its ancestors, plus what those
-- sheets derive from.
local function sheets(instance: Instance): { StyleSheet }
	local out, seen = {}, {}
	local function add(sheet: StyleSheet?)
		if not sheet or seen[sheet] then
			return
		end
		seen[sheet] = true
		table.insert(out, sheet)
		for _, derive in sheet:GetChildren() do
			if derive:IsA("StyleDerive") then
				add(derive.StyleSheet)
			end
		end
	end
	local node: Instance? = instance
	while node do
		for _, child in node:GetChildren() do
			if child:IsA("StyleLink") then
				add(child.StyleSheet)
			end
		end
		node = node.Parent
	end
	return out
end

local function fail(text: string): Result
	return { content = { { type = "text", text = text } }, isError = true }
end

function Tool.Run(arguments: { root: string, properties: { string }? }): Result
	local found, problem = Path.Resolve(arguments.root)
	if not found then
		return fail(problem :: string)
	end
	local instance = found :: Instance
	local names: { string } = if arguments.properties and #arguments.properties > 0 then arguments.properties else DEFAULT_PROPERTIES

	local defaults: any = nil
	pcall(function()
		defaults = Instance.new(instance.ClassName)
	end)

	local rules = {}
	local linked = sheets(instance)
	for _, sheet in linked do
		for _, rule in sheet:GetDescendants() do
			if rule:IsA("StyleRule") then
				table.insert(rules, rule)
			end
		end
	end

	local lines = {
		`{instance:GetFullName()} ({instance.ClassName}) tags: {table.concat(CollectionService:GetTags(instance), ", ")}`,
		`sheets: {#linked}, rules: {#rules}`,
	}
	for _, name in names do
		local okDirect, direct = pcall(function()
			return (instance :: any)[name]
		end)
		if not okDirect then
			table.insert(lines, `\n{name}: no such property on {instance.ClassName}`)
			continue
		end
		local okStyled, styled = pcall(function()
			return (instance :: any):GetStyled(name)
		end)
		local default = if defaults then (defaults :: any)[name] else nil
		local verdict = if direct ~= default
			then "direct value wins (not the class default)"
			elseif okStyled and styled ~= direct then "a rule decides it"
			else "class default; no rule changed it"
		table.insert(lines, `\n{name}: direct={show(direct)} styled={if okStyled then show(styled) else "?"} default={show(default)} -- {verdict}`)
		for _, rule in rules do
			local value = rule:GetProperty(name)
			if value ~= nil then
				local err = rule.SelectorError
				table.insert(lines, `  [{rule.Priority}] {rule.Selector} = {show(value)}{if err ~= "" then " SELECTOR ERROR: " .. err else ""}{if value == default then " (class default: may not reach a client)" else ""}`)
			end
		end
	end
	if defaults then
		defaults:Destroy()
	end
	return { content = { { type = "text", text = table.concat(lines, "\n") } } }
end

return Tool
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">LintHotpaths</string>
          <string name="Source"><![CDATA[--!strict

local Lint = require(script.Parent.Parent.Lib.Lint)
local Path = require(script.Parent.Parent.Path)

local DEFAULT_MAX_RESULTS = 60
local HARD_MAX_RESULTS = 400
local MAX_LINES = 15000
local EXCLUDE_TAG = "excludeLOC"

type Result = {
	content: { { type: "text", text: string } },
	isError: boolean?,
}

local Tool = {}

Tool.Definition = {
	name = "lint_hotpaths",
	description = "Static pass over every script under a root for the shapes that cost frame time, "
		.. "ranked by how often they'd run: tree walks, Instance.new/Clone, string building and "
		.. "physics queries inside Heartbeat/RenderStepped/Touched handlers or loops; polling "
		.. "while-true loops; legacy wait/spawn; deep game.X.Y.Z paths and require inside "
		.. "functions; connections made per run. Reads Studio's Source, so it sees Studio-only "
		.. "scripts too. No playtest needed. It's a shortlist for profile_scripts, not a verdict -- a "
		.. "high finding in code that runs once a match is fine. Skips anything tagged excludeLOC.",
	inputSchema = {
		type = "object",
		properties = {
			root = {
				type = "string",
				description = 'Dotted path to scan under, like "ServerScriptService". Defaults to game.',
			},
			minSeverity = {
				type = "string",
				description = "Lowest severity to list. Defaults to medium.",
				enum = { "high", "medium", "low" },
			},
			maxResults = {
				type = "integer",
				description = "Findings to list. Defaults to 60.",
				minimum = 1,
				maximum = HARD_MAX_RESULTS,
			},
		},
	},
	tags = { title = "Lint Hot Paths", readOnly = true, idempotent = true },
	timeoutMs = 60000,
}

type Row = { path: string, finding: Lint.Finding }

function Tool.Run(arguments: { root: string?, minSeverity: string?, maxResults: number? }): Result
	local root: Instance = game
	if type(arguments.root) == "string" and arguments.root ~= "" then
		local found, why = Path.Resolve(arguments.root :: string)
		if not found then
			return { content = { { type = "text", text = why :: string } }, isError = true }
		end
		root = found
	end
	local floor = Lint.Rank[arguments.minSeverity or "medium"] or 2
	local limit = math.clamp(arguments.maxResults or DEFAULT_MAX_RESULTS, 1, HARD_MAX_RESULTS)

	local excluded: { [Instance]: boolean } = {}
	for _, instance in root:QueryDescendants(`.{EXCLUDE_TAG} >> LuaSourceContainer`) do
		excluded[instance] = true
	end

	local rows: { Row } = {}
	local scanned, unreadable, skipped = 0, 0, 0
	local perScript: { [string]: number } = {}
	for _, instance in root:QueryDescendants(`LuaSourceContainer:not(.{EXCLUDE_TAG})`) do
		if excluded[instance] then
			continue
		end
		local readable, source = pcall(function()
			return (instance :: any).Source
		end)
		if not readable or type(source) ~= "string" then
			unreadable += 1
			continue
		end
		local _, newlines = string.gsub(source, "\n", "")
		if newlines > MAX_LINES then
			skipped += 1
			continue
		end
		scanned += 1
		local path = instance:GetFullName()
		for _, finding in Lint.Script(source) do
			if Lint.Rank[finding.severity] >= floor then
				table.insert(rows, { path = path, finding = finding })
				perScript[path] = (perScript[path] or 0) + Lint.Rank[finding.severity]
			end
		end
	end

	table.sort(rows, function(a, b)
		local ra, rb = Lint.Rank[a.finding.severity], Lint.Rank[b.finding.severity]
		if ra ~= rb then
			return ra > rb
		end
		if a.path ~= b.path then
			return a.path < b.path
		end
		return a.finding.line < b.finding.line
	end)

	local out = {
		`{#rows} finding(s) at {arguments.minSeverity or "medium"} or worse across {scanned} script(s) under {root:GetFullName()}`,
	}
	if #rows > 0 then
		-- Which scripts to open first: the sum of their severities.
		local ranked = {}
		for path, score in perScript do
			table.insert(ranked, { path = path, score = score })
		end
		table.sort(ranked, function(a, b)
			return a.score > b.score
		end)
		local names = {}
		for index = 1, math.min(8, #ranked) do
			table.insert(names, `{ranked[index].path} ({ranked[index].score})`)
		end
		table.insert(out, "scripts by weight: " .. table.concat(names, ", "))
		table.insert(out, "")
	end
	for index, row in rows do
		if index > limit then
			table.insert(out, `-- {#rows - limit} more; raise maxResults or minSeverity`)
			break
		end
		local finding = row.finding
		table.insert(
			out,
			string.format(
				"%-6s %s:%d  %s [%s] -- %s",
				finding.severity,
				row.path,
				finding.line,
				finding.pattern,
				finding.context,
				finding.detail
			)
		)
	end
	if skipped > 0 then
		table.insert(
			out,
			`-- {skipped} script(s) over {MAX_LINES} lines skipped; tag them {EXCLUDE_TAG} or lint them alone`
		)
	end
	if unreadable > 0 then
		table.insert(out, `-- {unreadable} script(s) couldn't be read (allow script injection for VMCP)`)
	end
	return { content = { { type = "text", text = table.concat(out, "\n") } } }
end

return Tool
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="45">
        <Properties>
          <string name="Name">OptimizationLedger</string>
          <string name="Source"><![CDATA[--!strict

-- The memory of an optimization pass, kept on the VMCP server per place: what's been profiled,
-- what was found, what was proposed, what the user said. Read it at the start of a pass so a
-- second session doesn't redo the first one's work, and write it as each script is closed out.

local Bridge = require(script.Parent.Parent.Bridge)

type Result = {
	content: { { type: "text", text: string } },
	isError: boolean?,
}

local Tool = {}

Tool.Definition = {
	name = "optimization_ledger",
	description = "Per-place record of the optimization pass, stored by the VMCP server under "
		.. "~/.vmcp/optimization/<place>.json. read lists every script touched so far with its status "
		.. "and numbers; write merges fields into one script's entry (status: profiled | proposed | "
		.. "tried | applied | rejected | skipped, plus whatever else is worth keeping -- worst frame "
		.. "before/after, the fix in one line, why it was rejected); clear removes an entry. Read it "
		.. "before starting a pass and write it before moving to the next script, so the final report "
		.. "can total what the pass saved.",
	inputSchema = {
		type = "object",
		properties = {
			action = { type = "string", enum = { "read", "write", "clear" } },
			script = { type = "string", description = "Dotted path of the script the entry is about (write/clear)." },
			entry = {
				type = "object",
				description = "Fields to merge for write. Free-form; `status` and `summary` are the ones the "
					.. "listing shows.",
				additionalProperties = true,
			},
		},
		required = { "action" },
	},
	tags = { title = "Optimization Ledger", idempotent = true },
}

local function text(body: string, isError: boolean?): Result
	return { content = { { type = "text", text = body } }, isError = isError }
end

local function render(entries: { [string]: any }): string
	local keys = {}
	for key in entries do
		table.insert(keys, key)
	end
	if #keys == 0 then
		return "the ledger is empty for this place"
	end
	table.sort(keys)
	local lines = { `{#keys} script(s) in the ledger:` }
	for _, key in keys do
		local entry = entries[key]
		local extras = {}
		for field, value in entry do
			if field ~= "status" and field ~= "summary" and field ~= "updatedAt" then
				table.insert(extras, `{field}={tostring(value)}`)
			end
		end
		table.sort(extras)
		table.insert(
			lines,
			string.format(
				"  %-10s %s -- %s%s",
				tostring(entry.status or "?"),
				key,
				tostring(entry.summary or ""),
				if #extras > 0 then " (" .. table.concat(extras, ", ") .. ")" else ""
			)
		)
	end
	return table.concat(lines, "\n")
end

function Tool.Run(arguments: { action: string?, script: string?, entry: { [string]: any }? }): Result
	local action = arguments.action
	if action == "read" then
		local ok, payload = Bridge.Request("ledger/read", {}, 10)
		if not ok then
			return text(tostring(payload), true)
		end
		return text(render(payload.entries or {}))
	end

	if type(arguments.script) ~= "string" or arguments.script == "" then
		return text(`{tostring(action)} needs a script path`, true)
	end
	if action == "write" then
		if type(arguments.entry) ~= "table" then
			return text("write needs an entry object", true)
		end
	elseif action ~= "clear" then
		return text(`action must be read, write or clear -- got "{tostring(action)}"`, true)
	end

	local ok, payload = Bridge.Request("ledger/write", {
		key = arguments.script,
		-- Absent on the wire for clear; the server reads that as "delete".
		entry = if action == "clear" then nil else arguments.entry,
	}, 10)
	if not ok then
		return text(tostring(payload), true)
	end
	return text(render(payload.entries or {}))
end

return Tool
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="46">
        <Properties>
          <string name="Name">Peer</string>
          <string name="Source"><![CDATA[--!strict

-- Plumbing, not a tool anyone calls directly: it's tagged internal, so the server keeps it out of
-- the list it advertises but still routes tool/invoke to it.
--
-- Everything here is something only a DataModel can answer about itself. "ping" is how the edit
-- session finds out a playtest's DataModels have finished connecting, and "stop" is how a playtest
-- ends -- EndTest only works from inside the test server, which the edit session isn't.

local Bridge = require(script.Parent.Parent.Bridge)

type Result = {
	content: { { type: "text", text: string } },
	isError: boolean?,
}

local Tool = {}

Tool.Definition = {
	name = "peer",
	description = "Internal. Reports on, or ends, the DataModel it runs in.",
	inputSchema = {
		type = "object",
		properties = {
			action = { type = "string", enum = { "ping", "stop" } },
			context = { type = "string", enum = { "plugin", "server", "client" } },
			player = { type = "integer", minimum = 1 },
		},
		required = { "action" },
	},
	tags = { title = "Peer", internal = true },
}

function Tool.Run(arguments: { action: string? }): Result
	if arguments.action == "stop" then
		local ok, failure = pcall(function()
			(game:GetService("StudioTestService") :: any):EndTest("stopped by VMCP")
		end)
		if not ok then
			return { content = { { type = "text", text = `couldn't end the test: {failure}` } }, isError = true }
		end
		return { content = { { type = "text", text = "ended the playtest" } } }
	end

	local connection = Bridge.Connection()
	local index = connection.peerIndex
	local who = if index == nil then connection.role else `{connection.role} {index}`
	return { content = { { type = "text", text = `{who} is up` } } }
end

return Tool
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="47">
        <Properties>
          <string name="Name">Playtest</string>
          <string name="Source"><![CDATA[--!strict

local Bridge = require(script.Parent.Parent.Bridge)
local Session = require(script.Parent.Parent.Playtest.Session)

local MAX_PLAYERS = 8

type Result = {
	content: { { type: "text", text: string } },
	isError: boolean?,
}

local Tool = {}

Tool.Definition = {
	name = "playtest",
	description = "Starts, stops or reports on a live playtest, and leaves it running between "
		.. "calls. While one is open, run_luau with context server or client runs inside the real "
		.. "game instead of paying to start one each time, and run_timeline uses it rather than "
		.. "launching its own. One player gets Play Solo, which is much quicker to start; two or "
		.. "more gets a real multiplayer test. One playtest per Studio window.",
	inputSchema = {
		type = "object",
		properties = {
			action = {
				type = "string",
				description = "start opens a playtest, stop ends it, status says what's running.",
				enum = { "start", "stop", "status" },
			},
			players = {
				type = "integer",
				description = "How many test clients to launch. Defaults to 1, max 8.",
				minimum = 1,
				maximum = MAX_PLAYERS,
			},
		},
		required = { "action" },
	},
	tags = { title = "Playtest", destructive = true },
	-- Launching a server plus clients is slow enough that the default would trip on a cold start.
	timeoutMs = 120000,
}

local function text(body: string, isError: boolean?): Result
	return { content = { { type = "text", text = body } }, isError = isError }
end

function Tool.Run(arguments: { action: string?, players: number? }): Result
	local action = arguments.action

	if action == "status" then
		local status = Session.Status()
		if not status.running then
			return text("No playtest is running.")
		end
		local whose = if status.ours then "" else " (started outside VMCP)"
		return text(`A playtest has been running for {status.seconds}s{whose}.`)
	end

	if action == "stop" then
		if not Session.IsRunning() then
			return text("No playtest is running.")
		end
		-- EndTest only works from inside the test server, and the edit session isn't it. The call
		-- goes out to the VMCP server and back into the running game's own copy of the plugin.
		local reached, result = Bridge.Invoke("peer", { action = "stop", context = "server" }, 20)
		Session.Forget()
		if not reached then
			return text(`couldn't reach the test server to stop it: {tostring(result)}`, true)
		end
		return text("Asked the playtest to stop. Check status in a second or two.")
	end

	if action ~= "start" then
		return text(`action must be start, stop or status -- got "{tostring(action)}"`, true)
	end

	local failure = Session.Start(math.clamp(arguments.players or 1, 1, MAX_PLAYERS))
	if failure then
		return text(failure, true)
	end

	return text(
		"Playtest starting. Give it a few seconds, then run_luau with context server or client "
			.. "runs inside it, sharing the require cache with the game's own scripts when you ask "
			.. "for the game VM."
	)
end

return Tool
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="48">
        <Properties>
          <string name="Name">Print</string>
          <string name="Source"><![CDATA[--!strict

-- An example tool. A tool module is two things: a `Definition` that goes into the `tools`
-- list at handshake time, and a `Run` that takes the decoded arguments and returns the
-- result for the tool/call reply. docs/protocol.md has the rest.
--
-- Definition fields:
--   name          [A-Za-z0-9_-], 1-64 chars, unique in the place. What Claude calls.
--   description   Claude reads this to pick the tool -- write it for a person.
--   inputSchema   JSON Schema, passed to Claude untouched and never enforced by the
--                 server, so Run checks its own arguments.
--   outputSchema  optional; if you declare it, send structuredContent back too.
--   tags          optional; what the tool does to the place.
--   timeoutMs     optional; overrides the 30s default. A long job is better off sending
--                 tool/progress -- every progress message restarts the timeout.
--
-- Schema rules that bite:
--   `type = "object"` is required at the root of every schema.
--   An array needs `items`: { type = "array", items = { type = "string" } }.
--   A nested object needs its own `type` and `properties` -- never a bare {}, which
--   Luau encodes as [].
--   `required` is a list of names, not a string.
--
-- Tags, all optional:
--   title        friendlier display name than the id
--   readOnly     changes nothing
--   destructive  can overwrite or destroy existing work
--   idempotent   running it twice is the same as running it once
--   external     reaches outside the place: HTTP, Creator Store, filesystem
-- A misspelled tag is a hard error, not a silent no-op. `idempotent` also gets you retry
-- safety: the server caches the result under a retryKey it adds itself, nothing to handle.
--
-- Run returns { content = {...} }, plus `isError = true` for a failure Claude should read
-- and correct itself from -- bad arguments, nothing selected. A JSON-RPC error reads as
-- the plugin falling over instead. Anything that isn't a content table gets wrapped in a
-- text block, so `return "done"` is fine while prototyping.

export type Result = {
	content: { { type: "text", text: string } },
	structuredContent: { [string]: any }?,
	isError: boolean?,
}

local Tool = {}

Tool.Definition = {
	name = "print",
	description = "Prints a message to the Studio output window.",
	inputSchema = {
		type = "object",
		properties = {
			message = { type = "string", description = "The text to print." },
			times = {
				type = "integer",
				description = "How many times to print it. Defaults to 1.",
				minimum = 1,
				maximum = 10,
			},
		},
		required = { "message" },
	},
	outputSchema = {
		type = "object",
		properties = {
			printed = { type = "integer", description = "How many lines were printed." },
		},
	},
	tags = { title = "Print", readOnly = true, idempotent = true },
}

function Tool.Run(arguments: { message: string?, times: number? }): Result
	local message = arguments.message
	if type(message) ~= "string" or message == "" then
		return {
			content = { { type = "text", text = "message must be a non-empty string" } },
			isError = true,
		}
	end

	local times = arguments.times or 1
	for _ = 1, times do
		print(`[VMCP] {message}`)
	end

	-- The text block goes out even with structuredContent -- some clients ignore structured
	-- output entirely.
	return {
		content = { { type = "text", text = `Printed {times}x: {message}` } },
		structuredContent = { printed = times },
	}
end

return Tool
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="49">
        <Properties>
          <string name="Name">ProfileScripts</string>
          <string name="Source"><![CDATA[--!strict

-- Hammers functions in the running game under the MicroProfiler and says what the frame time went
-- on. Two halves in one module, told apart by which DataModel it's running in:
--
--   edit session   builds instrumented Source for the sections, starts a playtest running it
--                  (Playtest/Swap -- the place never keeps it), hands the run to the live context.
--   playtest       builds the load loop, runs it in the game's own VM under a LibMP capture,
--                  reads the capture, and posts it to the VMCP server as a .gprx dump.
--
-- Nothing here changes what the game does. Instrumentation is a pair of profiler calls around
-- lines you chose, applied in Studio only for as long as the tool is running, and the load calls
-- the same functions the game would with arguments you made up in `setup`.

local RunService = game:GetService("RunService")

local Bridge = require(script.Parent.Parent.Bridge)
local Env = require(script.Parent.Parent.Env)
local Instrument = require(script.Parent.Parent.Lib.Instrument)
local Path = require(script.Parent.Parent.Path)
local Profile = require(script.Parent.Parent.Lib.Profile)
local Session = require(script.Parent.Parent.Playtest.Session)
local Swap = require(script.Parent.Parent.Playtest.Swap)

local DEFAULT_SECONDS = 2
local MAX_TARGETS = 8
local MAX_TOTAL_SECONDS = 120

type Result = {
	content: { { type: "text", text: string } },
	isError: boolean?,
}

type Section = {
	script: string,
	fromLine: number,
	toLine: number,
	label: string,
}

local Tool = {}

Tool.Definition = {
	name = "profile_scripts",
	description = "Profiles the live game with the MicroProfiler. Two modes, usable together: `observe` "
		.. "captures the game running on its own for N seconds (the real-load baseline -- what "
		.. "actually costs frame time while someone plays), and `targets` hammer specific functions "
		.. "thousands of times with fake data. Reports your labels with per-call, allocation-per-call "
		.. "and worst-frame numbers, "
		.. "the top scopes by self time across every thread, the slowest frames and what filled them, "
		.. "and the Luau heap delta. Each target is a `setup` Luau body that runs once in the game's "
		.. "own VM (so require() returns the live module with its real state) and returns the "
		.. "function to hammer; the tool wraps every call in debug.profilebegin(label). `sections` "
		.. "additionally brackets line ranges inside scripts with profilebegin/profileend so a slow "
		.. "loop inside a function shows up as its own scope, and `autoSections` does that for every "
		.. "named function in a script at once -- the edits live only in the playtest, never the place. "
		.. "Needs LibMP in the place (pass "
		.. "installLibMP to insert it). Starts a playtest if none is running; if sections are given "
		.. "and one is already running, restarts it so the instrumented code is what runs. Each "
		.. "capture is also written to disk as a .gprx dump for LibMP under Lute. Batch: put every "
		.. "function you want numbers for in one call's targets, and for old-vs-new comparisons or "
		.. "anything that also needs setup, output checks or state reads, call vmcp.Profile.Hammer "
		.. "from a run_timeline server event instead so the whole pass is one call. Load the "
		.. "vmcp-optimization skill before using this.",
	inputSchema = {
		type = "object",
		properties = {
			observe = {
				type = "object",
				description = "Capture the game as it runs, no hammering. Drive it yourself (play, or a "
					.. "client timeline event) during the window. Runs before any targets.",
				properties = {
					seconds = {
						type = "number",
						description = "How long to watch. Defaults to 3; 256 frames is the cap.",
						minimum = 0.5,
					},
				},
			},
			autoSections = {
				type = "array",
				description = "Scripts to instrument function-by-function: every named function gets its own "
					.. 'scope, labelled <ScriptName>.<function>. The fastest way from "this script is slow" to '
					.. '"it\'s this function".',
				items = { type = "string", description = 'Dotted path, like "ServerScriptService.Combat".' },
			},
			targets = {
				type = "array",
				description = "What to hammer. Each runs as its own capture, one after another. Optional when "
					.. "observe is given.",
				minItems = 1,
				maxItems = MAX_TARGETS,
				items = {
					type = "object",
					properties = {
						label = {
							type = "string",
							description = "Scope name in the profiler. Keep it short and unique, like Combat.ResolveHit.",
						},
						setup = {
							type = "string",
							description = "Luau body. Runs once, in the game VM by default, and must `return` the "
								.. "function to call. Build fake arguments here. The function gets the call "
								.. "index (1..calls) as its only argument, so it can vary its data.",
						},
						calls = {
							type = "integer",
							description = "How many calls. Defaults to 500. Stops early when seconds runs out.",
							minimum = 1,
						},
						seconds = {
							type = "number",
							description = "Spread the calls over this long. Defaults to 2 -- the capture only "
								.. "holds frameLimit frames (~2s at 60fps), so longer loads lose their start.",
							minimum = 0.1,
						},
						perFrame = {
							type = "integer",
							description = "Calls per frame before yielding. Defaults to calls / (seconds * 60), "
								.. "which spreads them evenly.",
							minimum = 1,
						},
						warmup = {
							type = "integer",
							description = "Calls thrown away first so lazy init isn't in the numbers. Defaults to 5.",
							minimum = 0,
						},
					},
					required = { "label", "setup" },
				},
			},
			sections = {
				type = "array",
				description = "Line ranges to wrap in debug.profilebegin(label)/profileend() while the run "
					.. "happens. Lines are 1-based and inclusive, in the script's current Source. Pick "
					.. "whole statements: a range that ends inside a block or contains an early return "
					.. "reads wrong.",
				items = {
					type = "object",
					properties = {
						script = { type = "string", description = 'Dotted path, like "ServerScriptService.Combat".' },
						fromLine = { type = "integer", minimum = 1 },
						toLine = { type = "integer", minimum = 1 },
						label = { type = "string" },
					},
					required = { "script", "fromLine", "toLine", "label" },
				},
			},
			where = {
				type = "string",
				description = "Which live context runs the load. Defaults to server.",
				enum = { "server", "client" },
			},
			player = {
				type = "integer",
				description = "Which test client, 1-based, when where is client.",
				minimum = 1,
				maximum = 8,
			},
			vm = {
				type = "string",
				description = "game (default) runs setup in the game's VM, sharing the require cache with the "
					.. "running scripts. plugin runs it in VMCP's VM with `vmcp` in scope -- fresh module "
					.. "copies, so only for pure functions.",
				enum = { "game", "plugin" },
			},
			frameLimit = {
				type = "integer",
				description = "Frames the profiler keeps, 8-256. Defaults to 128. More frames, bigger dump.",
				minimum = 8,
				maximum = 256,
			},
			top = {
				type = "integer",
				description = "How many scopes to list by self time. Defaults to 15.",
				minimum = 1,
				maximum = 60,
			},
			dump = {
				type = "boolean",
				description = "Write each capture to ~/.vmcp/profiles/<name>-<label>.gprx. Defaults to true.",
			},
			name = {
				type = "string",
				description = "Dump file prefix. Defaults to a timestamp.",
			},
			installLibMP = {
				type = "boolean",
				description = "Insert LibMP from the Creator Store into ReplicatedStorage if it isn't there.",
			},
			players = {
				type = "integer",
				description = "Players for the playtest this starts, if it has to. Defaults to 1.",
				minimum = 1,
				maximum = 8,
			},
		},
	},
	tags = { title = "Profile Scripts", destructive = true },
	timeoutMs = 240000,
}

local function text(body: string, isError: boolean?): Result
	return { content = { { type = "text", text = body } }, isError = isError }
end

local function checkTargets(targets: any, observing: boolean): (string?, number)
	if targets == nil and observing then
		return nil, 0
	end
	if type(targets) ~= "table" or #targets == 0 then
		return "targets must be a non-empty array (or pass observe)", 0
	end
	if #targets > MAX_TARGETS then
		return `at most {MAX_TARGETS} targets per call`, 0
	end
	local total = 0
	for index, target in targets do
		if type(target.label) ~= "string" or target.label == "" then
			return `target {index} needs a label`, 0
		end
		if type(target.setup) ~= "string" or target.setup == "" then
			return `target "{target.label}" needs a setup body`, 0
		end
		total += target.seconds or DEFAULT_SECONDS
	end
	if total > MAX_TOTAL_SECONDS then
		return `the targets add up to {total}s of load; keep it under {MAX_TOTAL_SECONDS}s per call`, 0
	end
	return nil, total
end

-- The playtest half. Everything real is Profile.Hammer, so a timeline event can do the same thing
-- without a tool call per target.
local function capture(arguments: any): Result
	local observe = arguments.observe
	local problem = checkTargets(arguments.targets, observe ~= nil)
	if problem then
		return text(problem, true)
	end
	local labels = {}
	for _, section in arguments.sections or {} do
		table.insert(labels, section.label)
	end
	for _, label in arguments.autoLabels or {} do
		table.insert(labels, label)
	end

	local parts = {}
	local failed = false
	if observe then
		local watched = Profile.Observe(observe.seconds, {
			frameLimit = arguments.frameLimit,
			top = arguments.top,
			labels = labels,
			dump = arguments.dump ~= false,
			name = arguments.name,
		})
		table.insert(parts, watched)
	end
	if arguments.targets then
		local body, hammerFailed = Profile.Hammer(arguments.targets, {
			vm = arguments.vm,
			env = Env,
			frameLimit = arguments.frameLimit,
			top = arguments.top,
			dump = arguments.dump,
			name = arguments.name,
			labels = labels,
		})
		table.insert(parts, body)
		failed = hammerFailed
	end
	table.insert(
		parts,
		"The last capture is still open in this context: a run_luau or timeline event here can "
			.. "reopen it with vmcp.Profile.Session() and walk it with LibMP directly."
	)
	return text(table.concat(parts, "\n\n"), failed)
end

local function splitLines(source: string): { string }
	local lines = {}
	for line in string.gmatch(source .. "\n", "([^\n]*)\n") do
		table.insert(lines, line)
	end
	return lines
end

-- Builds each script's Source with the profiler calls in. Sections on one script are merged in a
-- single pass over the original line numbers, so they can nest or overlap without shifting each
-- other. Nothing is written here -- Swap does that, briefly.
local function instrument(sections: { Section }, autoScripts: { string }): ({ Swap.Replacement }, { string }, string?)
	local byScript: { [Instance]: { Section } } = {}
	local autoLabels: { string } = {}
	local autoOn: { [Instance]: boolean } = {}
	for _, path in autoScripts do
		local instance, why = Path.Resolve(path)
		if not instance then
			return {}, {}, why
		end
		if not instance:IsA("LuaSourceContainer") then
			return {}, {}, `{path} is a {instance.ClassName}, not a script`
		end
		autoOn[instance] = true
		byScript[instance] = byScript[instance] or {}
	end
	for index, section in sections do
		local instance, why = Path.Resolve(section.script)
		if not instance then
			return {}, {}, why
		end
		if not instance:IsA("LuaSourceContainer") then
			return {}, {}, `{section.script} is a {instance.ClassName}, not a script`
		end
		if type(section.label) ~= "string" or section.label == "" then
			return {}, {}, `section {index} needs a label`
		end
		local list = byScript[instance]
		if not list then
			list = {}
			byScript[instance] = list
		end
		table.insert(list, section)
	end

	local replacements: { Swap.Replacement } = {}
	for instance, list in byScript do
		local source, why = Swap.ReadSource(instance)
		if not source then
			return {}, {}, why
		end
		-- Function scopes go in first; they're inserted inline, so the line numbers the sections
		-- were written against still hold.
		if autoOn[instance] then
			local labels
			source, labels = Instrument.Functions(source :: string, instance.Name)
			for _, label in labels do
				table.insert(autoLabels, label)
			end
		end
		local lines = splitLines(source :: string)
		for _, section in list do
			if section.fromLine > section.toLine or section.toLine > #lines then
				return {},
					{},
					`section "{section.label}" wants lines {section.fromLine}-{section.toLine} but {instance:GetFullName()} has {#lines}`
			end
		end

		local out = {}
		for number, line in lines do
			-- Outer sections open first, and close last.
			local opening = {}
			for _, section in list do
				if section.fromLine == number then
					table.insert(opening, section)
				end
			end
			table.sort(opening, function(a, b)
				return a.toLine > b.toLine
			end)
			for _, section in opening do
				table.insert(out, `debug.profilebegin({string.format("%q", section.label)})`)
			end
			table.insert(out, line)
			local closing = {}
			for _, section in list do
				if section.toLine == number then
					table.insert(closing, section)
				end
			end
			table.sort(closing, function(a, b)
				return a.fromLine > b.fromLine
			end)
			for _ in closing do
				table.insert(out, "debug.profileend()")
			end
		end

		table.insert(replacements, { instance = instance, source = table.concat(out, "\n") })
	end
	return replacements, autoLabels, nil
end

local function orchestrate(arguments: any): Result
	local problem, totalSeconds = checkTargets(arguments.targets, arguments.observe ~= nil)
	if problem then
		return text(problem, true)
	end
	if arguments.observe then
		totalSeconds += (arguments.observe.seconds or 3)
	end

	if not Profile.Find() then
		if not arguments.installLibMP then
			return text(
				"LibMP isn't in this place. Put the LibMP ModuleScript in ReplicatedStorage (Creator "
					.. "Store asset 109009378620272, or github.com/Roblox/libmp/releases), or call again "
					.. "with installLibMP = true.",
				true
			)
		end
		local _, why = Profile.Install()
		if why then
			return text(why, true)
		end
	end

	local notes = {}
	local sections: { Section } = arguments.sections or {}
	local autoScripts: { string } = arguments.autoSections or {}
	local autoLabels: { string } = {}
	local context = arguments.where or "server"
	local players = math.clamp(arguments.players or 1, 1, 8)
	local startedHere = false

	if #sections > 0 or #autoScripts > 0 then
		local replacements, labels, why = instrument(sections, autoScripts)
		if why then
			return text(why, true)
		end
		autoLabels = labels
		local failure, restarted = Swap.Start(replacements, players, context, arguments.player)
		if failure then
			return text(failure, true)
		end
		startedHere = true
		if restarted then
			table.insert(notes, "stopped the running playtest so the instrumented scripts would be the ones that ran")
		end
		table.insert(
			notes,
			`{#replacements} script(s) run instrumented in this playtest only; Studio's Source was never left changed`
		)
	elseif Session.IsRunning() then
		local notUp = Swap.WaitFor(context, arguments.player)
		if notUp then
			return text(notUp, true)
		end
	else
		local failure = Swap.Start({}, players, context, arguments.player)
		if failure then
			return text(failure, true)
		end
		startedHere = true
	end

	local reached, result = Bridge.Invoke("profile_scripts", {
		context = context,
		player = arguments.player,
		targets = arguments.targets,
		sections = sections,
		autoLabels = autoLabels,
		observe = arguments.observe,
		vm = arguments.vm,
		frameLimit = arguments.frameLimit,
		top = arguments.top,
		dump = arguments.dump,
		name = arguments.name,
	}, totalSeconds + 60)

	if not reached then
		return text(`couldn't run the profile in the {context}: {tostring(result)}`, true)
	end

	local body = {}
	for _, item in result.content or {} do
		if type(item.text) == "string" then
			table.insert(body, item.text)
		end
	end
	if startedHere then
		table.insert(notes, 'the playtest is still open -- stop it with playtest { action = "stop" } when you\'re done')
	end
	if #notes > 0 then
		table.insert(body, "-- " .. table.concat(notes, "\n-- "))
	end
	return text(table.concat(body, "\n\n"), result.isError == true)
end

function Tool.Run(arguments: any): Result
	if RunService:IsEdit() then
		return orchestrate(arguments)
	end
	return capture(arguments)
end

return Tool
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="50">
        <Properties>
          <string name="Name">RenderAnim</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local AnimationClipProvider = game:GetService("AnimationClipProvider")

local Anim = require(script.Parent.Parent.Lib.Anim)
local Build = require(script.Parent.Parent.Lib.Build)
local Rig = require(script.Parent.Parent.Lib.Rig)
local Path = require(script.Parent.Parent.Path)

local MAX_FRAMES = 12
local DUMMY_NAME = "VMCPRig"

type Result = {
	content: { { type: "text", text: string } },
	isError: boolean?,
	postProcess: { [string]: any }?,
}

local Tool = {}

Tool.Definition = {
	name = "render_anim",
	description = "Draws an animation as a filmstrip: the rig posed at each keyframe, left to right, "
		.. "one panel per view, rendered by the VMCP server with no playtest. Takes the same per-joint "
		.. "tracks vmcp.Anim.Compile takes, compiles them too, and returns a temporary animation id "
		.. "you can play straight away. Nothing in the place moves; the poses are computed from the "
		.. "rig's Motor6Ds. With no rig given it spawns a classic-coloured R15 dummy at "
		.. `Workspace.{DUMMY_NAME} and reuses it after that.`,
	inputSchema = {
		type = "object",
		properties = {
			tracks = {
				type = "object",
				description = 'Joint name -> keys. A key is { time, angles = [x, y, z] degrees, easing = "Cubic/Out" } '
					.. "or { time, cframe = [12 CFrame components] }. Easing sits on the key it leaves from.",
			},
			animationId = {
				type = "string",
				description = "Draw an existing animation (rbxassetid://...) instead of tracks. Its tracks come back in the text.",
			},
			rig = {
				type = "string",
				description = `Dotted path to a rigged model. Defaults to Workspace.{DUMMY_NAME}, created if missing.`,
			},
			times = {
				type = "array",
				items = { type = "number" },
				description = `Seconds to sample at. Defaults to every keyframe time, up to {MAX_FRAMES}.`,
				maxItems = MAX_FRAMES,
			},
			views = {
				type = "array",
				items = { type = { "string", "object" } },
				description = "Angles, one panel each: front, right, left, back, top, iso, or { yaw, pitch, name }. Defaults to front and right.",
				maxItems = 4,
			},
			size = {
				type = "integer",
				description = "Pixels per panel. Defaults to 768.",
				minimum = 128,
				maximum = 1024,
			},
			loop = { type = "boolean", description = "Sequence loops. Defaults to true." },
			priority = { type = "string", description = "Animation priority name. Defaults to Action." },
			name = { type = "string", description = "File name. Defaults to a timestamp." },
		},
	},
	tags = { title = "Render Animation", readOnly = true },
	timeoutMs = 60000,
}

-- Classic noob colours, because a grey dummy is one blob in a blockout render and this makes
-- head, torso, arms and legs tell apart at a glance.
local YELLOW, BLUE, GREEN = Color3.fromRGB(245, 205, 48), Color3.fromRGB(13, 105, 172), Color3.fromRGB(75, 151, 75)
local CLASSIC: { [string]: Color3 } = {
	Head = YELLOW,
	UpperTorso = BLUE,
	LowerTorso = BLUE,
	LeftUpperArm = YELLOW,
	LeftLowerArm = YELLOW,
	LeftHand = YELLOW,
	RightUpperArm = YELLOW,
	RightLowerArm = YELLOW,
	RightHand = YELLOW,
	LeftUpperLeg = GREEN,
	LeftLowerLeg = GREEN,
	LeftFoot = GREEN,
	RightUpperLeg = GREEN,
	RightLowerLeg = GREEN,
	RightFoot = GREEN,
}

local function dummy(): (Model?, string?)
	local existing = workspace:FindFirstChild(DUMMY_NAME)
	if existing and existing:IsA("Model") then
		return existing, nil
	end
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(Instance.new("HumanoidDescription"), Enum.HumanoidRigType.R15)
	end)
	if not ok then
		return nil, `couldn't create a dummy ({model}); pass rig = a path to a rigged model instead`
	end
	model.Name = DUMMY_NAME
	for _, child in model:GetChildren() do
		local color = CLASSIC[child.Name]
		if color and child:IsA("BasePart") then
			child.Color = color
		end
	end
	model:PivotTo(CFrame.new(0, 3, 0))
	model.Parent = workspace
	return model, nil
end

-- World CFrame of every rig part with the joint transforms applied, the root placed at `base`.
-- Motor6D: Part1 = Part0 * C0 * Transform * C1^-1, so an identity Transform is the rest pose.
local function pose(rig: Rig.Rig, at: number, tracks: Anim.Tracks, base: CFrame): { [string]: CFrame }
	local world: { [string]: CFrame } = { [rig.root.part.Name] = base }
	local function walk(node: Rig.Node)
		for _, child in node.children do
			local motor = child.motor :: Motor6D
			local keys = tracks[child.part.Name]
			local transform = if keys then Anim.Sample(keys, at) else CFrame.identity
			world[child.part.Name] = world[node.part.Name] * motor.C0 * transform * motor.C1:Inverse()
			walk(child)
		end
	end
	walk(rig.root)
	return world
end

local function fetch(animationId: string): (KeyframeSequence?, string?)
	local ok, clip = pcall(function()
		return AnimationClipProvider:GetAnimationClipAsync(animationId)
	end)
	if not ok then
		return nil, `couldn't load {animationId}: {clip}`
	end
	if not clip:IsA("KeyframeSequence") then
		return nil, `{animationId} is a {clip.ClassName}, not a KeyframeSequence`
	end
	return clip, nil
end

local function fmt(value: number): string
	return string.format("%.3g", value)
end

-- Decompiled keys carry CFrames; written back as angles so they can be edited and sent straight in.
local function keyText(key: Anim.Key): string
	local cframe = key.cframe :: CFrame
	local rx, ry, rz = cframe:ToEulerAnglesXYZ()
	local value = `angles = \{ {fmt(math.deg(rx))}, {fmt(math.deg(ry))}, {fmt(math.deg(rz))} }`
	if cframe.Position ~= Vector3.zero then
		value ..= ` (+ position {fmt(cframe.X)}, {fmt(cframe.Y)}, {fmt(cframe.Z)})`
	end
	local easing = if key.easing and key.easing ~= "Linear/Out" then `, easing = "{key.easing}"` else ""
	return `\{ time = {fmt(key.time)}, {value}{easing} }`
end

function Tool.Run(arguments: {
	tracks: Anim.Tracks?,
	animationId: string?,
	rig: string?,
	times: { number }?,
	views: { any }?,
	size: number?,
	loop: boolean?,
	priority: string?,
	name: string?,
}): Result
	local function fail(text: string): Result
		return { content = { { type = "text", text = text } }, isError = true }
	end

	local model: Instance?, problem: string?
	if arguments.rig then
		model, problem = Path.Resolve(arguments.rig)
	else
		model, problem = dummy()
	end
	if not model then
		return fail(problem :: string)
	end
	if not model:IsA("Model") then
		return fail(`{model:GetFullName()} is a {model.ClassName}, not a Model`)
	end

	local rig
	rig, problem = Rig.Build(model)
	if not rig then
		return fail(problem :: string)
	end

	local tracks = arguments.tracks
	local decompiled = false
	if arguments.animationId then
		local clip
		clip, problem = fetch(arguments.animationId)
		if not clip then
			return fail(problem :: string)
		end
		tracks = Anim.Decompile(clip)
		decompiled = true
	end
	if type(tracks) ~= "table" or next(tracks) == nil then
		return fail("give tracks or an animationId")
	end
	local resolved = tracks :: Anim.Tracks

	local built
	built, problem = Anim.Compile(model, resolved, { loop = arguments.loop, priority = arguments.priority })
	if not built then
		return fail(problem :: string)
	end

	local times: { number } = arguments.times or {}
	if #times == 0 then
		local seen: { [number]: true } = {}
		for _, keys in resolved do
			for _, key in keys do
				if not seen[key.time] then
					seen[key.time] = true
					table.insert(times, key.time)
				end
			end
		end
		table.sort(times)
	end
	if #times > MAX_FRAMES then
		return fail(`{#times} frames is too many to read; pass times to pick up to {MAX_FRAMES}`)
	end

	-- The renderer's "front" camera sits on +Z and a character faces -Z, so the rig is turned to
	-- look at it; that also puts its right side towards the "right" camera. Frames step along the
	-- diagonal every preset sees side-on, so they never stack behind each other.
	local _, extents = model:GetBoundingBox()
	local step = Vector3.new(1, 0, -1).Unit * extents.X * 2
	local facing = CFrame.Angles(0, math.pi, 0)
	local parts = {}
	for frame, at in times do
		local world = pose(rig, at, resolved, CFrame.new(step * (frame - 1)) * facing)
		for _, name in rig.order do
			local part = rig.byName[name].part
			if part.Transparency < 1 then
				table.insert(parts, Build.Describe(part, #parts + 1, world[name]))
			end
		end
	end

	local labels = {}
	for _, at in times do
		table.insert(labels, `t={fmt(at)}`)
	end
	local text = `{model:GetFullName()}: {#times} frame(s) left to right: {table.concat(labels, "  ")}\n`
		.. `id = {built.id}  length = {fmt(built.length)}  joints = {table.concat(built.joints, ", ")}`
	if decompiled then
		local lines = {}
		for joint, keys in resolved do
			local items = {}
			for _, key in keys do
				table.insert(items, keyText(key))
			end
			table.insert(lines, `{joint} = \{ {table.concat(items, ", ")} }`)
		end
		table.sort(lines)
		text ..= "\ntracks:\n" .. table.concat(lines, "\n")
	end

	return {
		content = { { type = "text", text = text } },
		postProcess = {
			kind = "scene",
			name = arguments.name,
			size = arguments.size or 768,
			views = (Build.ResolveViews(arguments.views or { "front", "right" })),
			badges = false,
			parts = parts,
		},
	}
end

return Tool
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="51">
        <Properties>
          <string name="Name">RenderBuild</string>
          <string name="Source"><![CDATA[--!strict

local Build = require(script.Parent.Parent.Lib.Build)
local Path = require(script.Parent.Parent.Path)

local MAX_PARTS = 1500
-- Past this many parts the badges stop being readable and start being a grey fog, so they go off
-- unless asked for by name.
local BADGE_LIMIT = 40

type Result = {
	content: { { type: "text", text: string } },
	isError: boolean?,
	postProcess: { [string]: any }?,
}

local Tool = {}

Tool.Definition = {
	name = "render_build",
	description = "Draws a region of the place as a picture and writes it to a PNG, so you can "
		.. "look at what your build code actually made instead of reading it back and guessing. "
		.. "Studio sends the geometry; the VMCP server renders it, so this needs no camera, no "
		.. "playtest and no screenshot. Each part gets a number in the picture and a line in the "
		.. "legend naming it, so something you can see is something you can grep for in the "
		.. "get_build source. Also reports what's wrong in code rather than by eye: parts sunk "
		.. "into each other, floating, rotated a fraction off square, built twice, or stranded "
		.. "miles from everything else.",
	inputSchema = {
		type = "object",
		properties = {
			root = {
				type = "string",
				description = 'Dotted path to the region, like "Workspace.Arena". Defaults to Workspace.',
			},
			views = {
				type = "array",
				description = "Which angles to draw, tiled into one image. Defaults to iso alone. "
					.. "Named: iso, corner, front, back, left, right, top, bottom. Or an object "
					.. "{ yaw, pitch, name } in degrees for anything else. Aim a view at one spot "
					.. "with at (an {x, y, z} or a dotted path to a part or model) and radius (studs "
					.. "from at to the panel edge); that panel is centred and scaled on it instead of "
					.. "the whole build. clip = true drops parts further than radius from at, so a "
					.. 'wall between the camera and the spot doesn\'t hide it. view = "front" picks '
					.. "a preset angle for a targeted view instead of yaw/pitch.",
				items = { type = { "string", "object" } },
				maxItems = 9,
			},
			size = {
				type = "integer",
				description = "Pixels per view. Defaults to 512.",
				minimum = 128,
				maximum = 1024,
			},
			name = {
				type = "string",
				description = "File name, letters digits underscore hyphen. Defaults to a timestamp.",
			},
			badges = {
				type = "boolean",
				description = `Number each part in the picture and list it in the legend. On by default when the panels show up to {BADGE_LIMIT} parts (clipped panels count only what's in frame).`,
			},
			problems = {
				type = "boolean",
				description = "Check the geometry and report what looks wrong. On by default.",
			},
			maxParts = {
				type = "integer",
				description = `Stop collecting after this many parts. Defaults to {MAX_PARTS}.`,
				minimum = 1,
				maximum = MAX_PARTS,
			},
		},
	},
	tags = { title = "Render Build", readOnly = true },
	timeoutMs = 60000,
}

function Tool.Run(arguments: {
	root: string?,
	views: { any }?,
	size: number?,
	name: string?,
	badges: boolean?,
	problems: boolean?,
	maxParts: number?,
}): Result
	local root: Instance = workspace
	if type(arguments.root) == "string" and arguments.root ~= "" then
		local found, problem = Path.Resolve(arguments.root :: string)
		if not found then
			return { content = { { type = "text", text = problem :: string } }, isError = true }
		end
		root = found
	end

	local parts, instances, capped = Build.Geometry(root, arguments.maxParts)
	local count = #instances
	if count == 0 then
		return {
			content = {
				{ type = "text", text = `{root:GetFullName()} has no parts in it, so there's nothing to draw` },
			},
			isError = true,
		}
	end

	local views, missing = Build.ResolveViews(arguments.views or { "iso" })
	local shown = Build.Shown(instances, views)
	local shownCount = 0
	for _ in shown do
		shownCount += 1
	end
	local badges = if arguments.badges ~= nil then arguments.badges else shownCount <= BADGE_LIMIT
	local note = if capped then `, stopped at {count} -- there are more` else ""
	local problems = if arguments.problems ~= false then Build.Problems(root, arguments.maxParts, instances) else nil

	local text = `{count} part(s) under {root:GetFullName()}, {#views} view(s){note}\n`
		.. Build.Report(root, instances, if badges then shown else nil, problems)
	for _, problem in missing do
		text ..= `\nview target not found, drawing the whole build instead: {problem}`
	end

	return {
		content = { { type = "text", text = text } },
		postProcess = {
			kind = "scene",
			name = arguments.name,
			size = arguments.size,
			views = views,
			badges = badges,
			parts = parts,
		},
	}
end

return Tool
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="52">
        <Properties>
          <string name="Name">ReviewRemotes</string>
          <string name="Source"><![CDATA[--!strict

local Audit = require(script.Parent.Parent.Lib.Audit)
local Path = require(script.Parent.Parent.Path)

type Result = {
	content: { { type: "text", text: string } },
	isError: boolean?,
}

local Tool = {}

Tool.Definition = {
	name = "review_remotes",
	description = "Hands you the code to security-review the game's remotes. Finds every "
		.. "RemoteEvent/RemoteFunction and the server scripts that handle them, traces which "
		.. "remote each handler serves, and returns those scripts' full source -- so you read "
		.. "the real handlers, not a summary. Review each for exploitable holes (missing type or "
		.. "ownership or range checks, client-authoritative currency/damage, no rate limit, "
		.. "loadstring, client-steered DataStore writes), then abuse the ones you flag from a "
		.. "client with run_timeline + vmcp.Exploit.AbuseAll. Reads Studio's current source, so "
		.. "run it against the edit session or a live server, not a real client.",
	inputSchema = {
		type = "object",
		properties = {
			root = {
				type = "string",
				description = 'Dotted path to scan under, like "ServerScriptService". Defaults to '
					.. "game. Narrow it when the game is large and you know where the remotes live.",
			},
		},
	},
	tags = { title = "Review Remotes", readOnly = true, idempotent = true },
}

function Tool.Run(arguments: { root: string? }): Result
	local root: Instance? = nil
	if arguments.root then
		local found, problem = Path.Resolve(arguments.root)
		if not found then
			return { content = { { type = "text", text = problem :: string } }, isError = true }
		end
		root = found
	end

	local surface = Audit.Surface(root)
	if #surface.handlers == 0 and #surface.remotes == 0 then
		return { content = { { type = "text", text = "no remotes found under that root" } } }
	end
	return { content = { { type = "text", text = Audit.Render(surface) } } }
end

return Tool
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="53">
        <Properties>
          <string name="Name">RunLuau</string>
          <string name="Source"><![CDATA[--!strict

-- The broad one. Everything the narrow builders would have done is a snippet through here.
--
-- Where it runs is the server's business, not this file's: a call naming a live context is routed
-- to the copy of the plugin loaded into that DataModel, and this same code runs there. So the only
-- choice left here is which VM inside that DataModel -- the plugin's, or the game's own.

local Buffer = require(script.Parent.Parent.Log.Buffer)
local Env = require(script.Parent.Parent.Env)
local GameVm = require(script.Parent.Parent.Exec.GameVm)
local Inject = require(script.Parent.Parent.Exec.Inject)
local Serialize = require(script.Parent.Parent.Exec.Serialize)

local MAX_TIMEOUT = 60

type Result = {
	content: { { type: "text", text: string } },
	isError: boolean?,
	postProcess: { [string]: any }?,
}

local Tool = {}

Tool.Definition = {
	name = "run_luau",
	description = "Runs Luau and returns what it returned plus anything it printed. `return` a "
		.. "value to see it -- Instances, CFrames and nested tables all come back readable. "
		.. "context picks the DataModel: plugin is Studio's edit session, server and client are a "
		.. "live playtest (start one with the playtest tool first). vm picks which VM inside it: "
		.. "plugin is the default and can reach everything, game shares the require cache with the "
		.. "running game's own scripts, which is the only way to see the real state a module has "
		.. "built up. `vmcp` holds the library, and vmcp.Tool calls any other VMCP tool.",
	inputSchema = {
		type = "object",
		properties = {
			code = {
				type = "string",
				description = "Luau source. Runs as a function body, so `return` works and is how "
					.. "you get a value back.",
			},
			context = {
				type = "string",
				description = "Which DataModel. Defaults to plugin.",
				enum = { "plugin", "server", "client" },
			},
			player = {
				type = "integer",
				description = "Which test client, 1-based. Only meaningful with context client.",
				minimum = 1,
				maximum = 8,
			},
			vm = {
				type = "string",
				description = "plugin (default) or game. game shares the running scripts' require "
					.. "cache, so require(SomeModule) hands back the live one rather than a fresh "
					.. "copy. Needs a playtest, and the result is rendered to text on the game's "
					.. "side, so only the text comes back.",
				enum = { "plugin", "game" },
			},
			timeoutSeconds = {
				type = "number",
				description = "Give up after this long. Defaults to 10, max 60.",
				minimum = 1,
				maximum = MAX_TIMEOUT,
			},
		},
		required = { "code" },
	},
	tags = { title = "Run Luau", destructive = true },
	timeoutMs = 70000,
}

function Tool.Run(arguments: { code: string?, vm: string?, timeoutSeconds: number? }): Result
	local code = arguments.code
	if type(code) ~= "string" or code == "" then
		return { content = { { type = "text", text = "code must be a non-empty string" } }, isError = true }
	end

	local timeout = math.clamp(arguments.timeoutSeconds or 10, 1, MAX_TIMEOUT)
	local cursor = Buffer.written

	local ok: boolean
	local rendered: string
	local directive: { [string]: any }? = nil

	if arguments.vm == "game" then
		ok, rendered = GameVm.Run(code)
	else
		local produced: any
		ok, produced = Inject.Run(code, Env, timeout)
		-- A snippet asks for work on the VMCP server -- writing a Canvas recording out as a PNG,
		-- so far -- by returning a table with a postProcess field. It rides back untouched.
		directive = if ok and type(produced) == "table" then produced.postProcess else nil

		if directive then
			rendered = `a {tostring(directive.kind)} job for the VMCP server to finish`
		elseif ok then
			rendered = Serialize.Render(produced)
		else
			rendered = tostring(produced)
		end
	end

	-- MessageOut lands a frame after the print that caused it, so without this the snippet's last
	-- line of output is always missing.
	task.wait()
	local logged = Buffer.Since(cursor)

	local parts = { if ok then `returned: {rendered}` else `error: {rendered}` }
	if #logged > 0 then
		local lines = {}
		for _, entry in logged do
			table.insert(lines, `  [{entry.severity}] {entry.text}`)
		end
		-- Studio logs everything to one place, so a noisy game script can land in here too.
		table.insert(parts, `output during the run:\n{table.concat(lines, "\n")}`)
	end

	return {
		content = { { type = "text", text = table.concat(parts, "\n\n") } },
		isError = not ok,
		postProcess = directive,
	}
end

return Tool
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="54">
        <Properties>
          <string name="Name">RunTimeline</string>
          <string name="Source"><![CDATA[--!strict

local Bridge = require(script.Parent.Parent.Bridge)
local Inject = require(script.Parent.Parent.Exec.Inject)
local Runtime = require(script.Parent.Parent.Timeline.Runtime)
local Session = require(script.Parent.Parent.Playtest.Session)

local MAX_PLAYERS = 8
local MAX_DURATION = 60
local MAX_EVENTS = 200
local PEER_TIMEOUT = 90

type Result = {
	content: { { type: "text", text: string } },
	isError: boolean?,
}

local Tool = {}

Tool.Definition = {
	name = "run_timeline",
	description = "Runs a batched test: one list of Luau snippets, each with a time and a context, "
		.. "fired on a shared clock across Studio itself, a real server and real clients, ending in "
		.. "an assertion. Contexts share ctx -- write ctx.thing = 1 anywhere and read ctx.thing "
		.. 'anywhere else, or ctx:Await("thing", 2) to wait for it rather than hope. Every event '
		.. "also gets vmcp: vmcp.Tool calls any other VMCP tool in any context, vmcp.Game.Require "
		.. "reads a live module's real state, vmcp.Remotes watches remote traffic, vmcp.Exploit "
		.. "replays the game's own remote traffic with its arguments broken and abuses remotes you flag, vmcp.Bench times a "
		.. "function under load. Client events also "
		.. "get input, for real keys and clicks. Starts its own playtest if one isn't already open.",
	inputSchema = {
		type = "object",
		properties = {
			events = {
				type = "array",
				description = "What happens and when.",
				items = {
					type = "object",
					properties = {
						at = { type = "number", description = "Seconds after the start.", minimum = 0 },
						context = {
							type = "string",
							description = "plugin is Studio's edit session; server and client are the live game.",
							enum = { "plugin", "server", "client" },
						},
						player = {
							type = "integer",
							description = "Which client, 1-based. Client events only; defaults to 1.",
							minimum = 1,
							maximum = MAX_PLAYERS,
						},
						code = {
							type = "string",
							description = "Luau. Runs as a function body with ctx, input and vmcp in scope.",
						},
						blocking = {
							type = "boolean",
							description = "Hold the schedule until this finishes. For setup steps.",
						},
						label = { type = "string", description = "Name for the log." },
					},
					required = { "at", "context", "code" },
				},
			},
			duration = {
				type = "number",
				description = "Seconds to keep running after the last event, so trailing effects land.",
				minimum = 0,
				maximum = MAX_DURATION,
			},
			players = {
				type = "integer",
				description = "Test clients to launch, if a playtest isn't already open. Defaults to 1.",
				minimum = 1,
				maximum = MAX_PLAYERS,
			},
			assertion = {
				type = "string",
				description = "Luau run in Studio at the end, with ctx in scope. Return true to pass.",
			},
			keepOpen = {
				type = "boolean",
				description = "Leave the playtest running afterwards instead of stopping it.",
			},
		},
		required = { "events" },
	},
	tags = { title = "Run Timeline", destructive = true },
	timeoutMs = 300000,
}

local function text(body: string, isError: boolean?): Result
	return { content = { { type = "text", text = body } }, isError = isError }
end

local function validate(events: any): (number, string?)
	if type(events) ~= "table" or #events == 0 then
		return 0, "events must be a non-empty array"
	end
	if #events > MAX_EVENTS then
		return 0, `that's {#events} events; the cap is {MAX_EVENTS}`
	end

	local longest = 0
	for index, event in events do
		if type(event) ~= "table" then
			return 0, `events[{index}] must be an object`
		end
		if type(event.at) ~= "number" or event.at < 0 then
			return 0, `events[{index}].at must be a number of seconds`
		end
		local context = event.context
		if context ~= "plugin" and context ~= "server" and context ~= "client" then
			return 0, `events[{index}].context must be plugin, server or client`
		end
		if type(event.code) ~= "string" or event.code == "" then
			return 0, `events[{index}].code must be a non-empty string`
		end
		longest = math.max(longest, event.at)
	end
	return longest, nil
end

type Bundle = { context: string, player: number?, origin: string, events: { any } }

-- One bundle per DataModel. A client event names its player, so two clients are two bundles and
-- each one only ever hears about its own events.
local function split(events: { any }): { Bundle }
	local parts: { Bundle } = {}
	local byKey: { [string]: Bundle } = {}

	for _, event in events do
		local player = if event.context == "client" then (event.player or 1) else nil
		local key = if player then `client{player}` else event.context
		local part = byKey[key]
		if not part then
			local created: Bundle = {
				context = event.context,
				player = player,
				origin = if player then `client {player}` else event.context,
				events = {},
			}
			byKey[key] = created
			table.insert(parts, created)
			part = created
		end
		table.insert((part :: Bundle).events, event)
	end
	return parts
end

-- A playtest DataModel takes a few seconds to boot and connect, and there's no event for it: the
-- edit session only finds out by asking the server whether anyone has answered yet.
local function waitForPeers(parts: { Bundle }): string?
	local deadline = os.clock() + PEER_TIMEOUT
	for _, part in parts do
		if part.context == "plugin" then
			continue
		end

		local up = false
		local last = "never answered"
		repeat
			local reached, result = Bridge.Invoke("peer", {
				action = "ping",
				context = part.context,
				player = part.player,
			}, 10)
			up = reached and result ~= nil and result.isError ~= true
			if not up then
				last = if reached then "not up yet" else tostring(result)
				task.wait(0.5)
			end
		until up or os.clock() >= deadline

		if not up then
			return `{part.origin} never came up ({last})`
		end
	end
	return nil
end

-- Run in the edit session, after everything else has stopped, against the context as it finally
-- stands. Keeping it out of the timeline is the point: it judges the run, it isn't part of it.
local function runAssertion(source: string): (boolean, string)
	local run, problem = Inject.Compile(source, "ctx, input, vmcp")
	if not run then
		return false, `the assertion didn't compile: {problem}`
	end

	local env = require(script.Parent.Parent.Env)
	local ok, produced = pcall(run, Runtime.Context("assertion"), nil, env)
	if not ok then
		return false, `the assertion errored: {produced}`
	end
	if produced == true then
		return true, "assertion passed"
	end
	return false, `assertion returned {tostring(produced)}`
end

local function render(passed: boolean, verdict: string, snapshot: any): Result
	local lines = { if passed then `PASS -- {verdict}` else `FAIL -- {verdict}` }

	if snapshot and snapshot.values and next(snapshot.values) ~= nil then
		table.insert(lines, "")
		table.insert(lines, "context at the end:")
		for key, value in snapshot.values do
			table.insert(lines, `  {key} = {tostring(value)}`)
		end
	end

	if snapshot and snapshot.writes and #snapshot.writes > 0 then
		table.insert(lines, "")
		table.insert(lines, "writes, in the order they happened:")
		for _, write in snapshot.writes do
			table.insert(lines, `  {write.from} set {write.key}`)
		end
	end

	if snapshot and snapshot.notes and #snapshot.notes > 0 then
		table.insert(lines, "")
		table.insert(lines, "notes and output:")
		for _, note in snapshot.notes do
			table.insert(lines, `  {note}`)
		end
	end

	return { content = { { type = "text", text = table.concat(lines, "\n") } }, isError = not passed }
end

function Tool.Run(arguments: {
	events: any,
	duration: number?,
	players: number?,
	assertion: string?,
	keepOpen: boolean?,
}): Result
	local longest, problem = validate(arguments.events)
	if problem then
		return text(problem, true)
	end

	local parts = split(arguments.events)
	local needsGame = false
	for _, part in parts do
		needsGame = needsGame or part.context ~= "plugin"
	end

	-- Started only if the payload actually needs a running game, and stopped again only if this
	-- call is what started it. A playtest someone else opened stays open.
	local weStarted = false
	if needsGame and not Session.IsRunning() then
		local failure = Session.Start(math.clamp(arguments.players or 1, 1, MAX_PLAYERS))
		if failure then
			return text(failure, true)
		end
		weStarted = true
	end

	local function finish(result: Result): Result
		if weStarted and not arguments.keepOpen then
			Bridge.Invoke("peer", { action = "stop", context = "server" }, 20)
			Session.Forget()
		end
		return result
	end

	local waited = waitForPeers(parts)
	if waited then
		return finish(text(waited, true))
	end

	Bridge.CtxClear()
	-- The tail runs past the last event, so the two add up rather than the payload having to state
	-- a duration longer than its own schedule.
	local duration = longest + math.clamp(arguments.duration or 1, 0, MAX_DURATION)

	local running = 0
	local failures: { string } = {}
	for _, part in parts do
		running += 1
		task.spawn(function()
			local reached, result = Bridge.Invoke("timeline_part", {
				context = part.context,
				player = part.player,
				origin = part.origin,
				events = part.events,
				duration = duration,
			}, duration + 60)

			if not reached then
				table.insert(failures, `{part.origin}: {tostring(result)}`)
			elseif result.isError then
				table.insert(failures, `{part.origin}: {result.content[1].text}`)
			end
			running -= 1
		end)
	end

	local deadline = os.clock() + duration + 90
	while running > 0 and os.clock() < deadline do
		task.wait(0.1)
	end
	if running > 0 then
		table.insert(failures, `{running} context(s) never finished`)
	end

	local snapshot = Bridge.CtxSnapshot()
	for _, failure in failures do
		if snapshot and snapshot.notes then
			table.insert(snapshot.notes, failure)
		end
	end

	local passed, verdict = true, "no assertion"
	if arguments.assertion then
		passed, verdict = runAssertion(arguments.assertion)
	elseif #failures > 0 then
		passed, verdict = false, "no assertion given, and a context failed"
	end

	return finish(render(passed, verdict, snapshot))
end

return Tool
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="55">
        <Properties>
          <string name="Name">ScreenshotUi</string>
          <string name="Source"><![CDATA[--!strict

-- Draws a GUI tree as a picture. Studio has no screenshot a plugin can take, so this walks the
-- GuiObjects in render order, reads every visual property through GetStyled (the only read that
-- sees StyleRules), and hands the flat list to the VMCP server, which rasterizes it.
--
-- What comes back is a layout check, not a render: boxes, strokes, gradients, corner radii and
-- rotation are exact; text is a bitmap font; EditableImage pixels are real, asset images are a
-- placeholder, and a ViewportFrame is a box naming what's inside it.

local Path = require(script.Parent.Parent.Path)

local MAX_NODES = 4000
-- Pixels for an ImageLabel backed by an EditableImage are shipped when it's this small or less;
-- bigger ones (a wall of previews) get the placeholder so the payload stays sane.
local MAX_IMAGE_SIDE = 128
local DEFAULT_MAX_SIDE = 1024

type Result = {
	content: { { type: "text", text: string } },
	isError: boolean?,
	postProcess: { [string]: any }?,
}

type Rect = { x: number, y: number, w: number, h: number }

local Tool = {}

Tool.Definition = {
	name = "screenshot_ui",
	description = "Draws a ScreenGui (or any GuiObject) as a PNG so you can look at the layout "
		.. "instead of reading AbsolutePosition numbers. Reads styled values, so StyleSheet rules "
		.. "show. Boxes, strokes, gradients, corners and rotation are exact; text is a bitmap "
		.. "font (check overflow with TextFits, not by eye); EditableImage icons are real pixels, "
		.. "asset images are a tinted placeholder, ViewportFrames are a box naming their contents. "
		.. "context plugin draws StarterGui as Studio lays it out; context client draws the "
		.. "player's live PlayerGui.",
	inputSchema = {
		type = "object",
		properties = {
			root = {
				type = "string",
				description = 'Dotted path to a ScreenGui, GuiObject, or a container of ScreenGuis. '
					.. "Defaults to StarterGui in the edit session and the local PlayerGui in a client.",
			},
			context = {
				type = "string",
				description = "Which DataModel. Defaults to plugin.",
				enum = { "plugin", "server", "client" },
			},
			player = {
				type = "integer",
				description = "Which test client, 1-based. Only meaningful with context client.",
				minimum = 1,
				maximum = 8,
			},
			scale = {
				type = "number",
				description = "Output pixels per screen pixel, 0.1 to 1. Defaults to whatever fits the longer side into 1024.",
				minimum = 0.1,
				maximum = 1,
			},
			name = {
				type = "string",
				description = "File name, letters digits underscore hyphen. Defaults to a timestamp.",
			},
		},
	},
	tags = { title = "Screenshot UI", readOnly = true },
	timeoutMs = 60000,
}

local function styled(instance: Instance, name: string): any
	local ok, value = pcall(function()
		return (instance :: any):GetStyled(name)
	end)
	if ok then
		return value
	end
	return (instance :: any)[name]
end

local function rgb(color: Color3): { number }
	return { color.R, color.G, color.B }
end

local function intersect(a: Rect?, b: Rect): Rect
	if not a then
		return b
	end
	local x1, y1 = math.max(a.x, b.x), math.max(a.y, b.y)
	local x2, y2 = math.min(a.x + a.w, b.x + b.w), math.min(a.y + a.h, b.y + b.h)
	return { x = x1, y = y1, w = math.max(x2 - x1, 0), h = math.max(y2 - y1, 0) }
end

local ALIGN_X = { [Enum.TextXAlignment.Left] = 0, [Enum.TextXAlignment.Center] = 0.5, [Enum.TextXAlignment.Right] = 1 }
local ALIGN_Y = { [Enum.TextYAlignment.Top] = 0, [Enum.TextYAlignment.Center] = 0.5, [Enum.TextYAlignment.Bottom] = 1 }

local base64: (buffer) -> string
do
	local ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	local ENCODE = table.create(64)
	for i = 1, 64 do
		ENCODE[i - 1] = string.byte(ALPHABET, i)
	end
	base64 = function(bytes: buffer): string
		local length = buffer.len(bytes)
		local out = buffer.create(math.ceil(length / 3) * 4)
		local o = 0
		local full = length - length % 3
		for i = 0, full - 1, 3 do
			local n = buffer.readu8(bytes, i) * 65536 + buffer.readu8(bytes, i + 1) * 256 + buffer.readu8(bytes, i + 2)
			buffer.writeu8(out, o, ENCODE[n // 262144])
			buffer.writeu8(out, o + 1, ENCODE[n // 4096 % 64])
			buffer.writeu8(out, o + 2, ENCODE[n // 64 % 64])
			buffer.writeu8(out, o + 3, ENCODE[n % 64])
			o += 4
		end
		local rest = length - full
		if rest == 1 then
			local a = buffer.readu8(bytes, full)
			buffer.writeu8(out, o, ENCODE[a // 4])
			buffer.writeu8(out, o + 1, ENCODE[a % 4 * 16])
			buffer.writeu8(out, o + 2, 61)
			buffer.writeu8(out, o + 3, 61)
		elseif rest == 2 then
			local a, b = buffer.readu8(bytes, full), buffer.readu8(bytes, full + 1)
			buffer.writeu8(out, o, ENCODE[a // 4])
			buffer.writeu8(out, o + 1, ENCODE[a % 4 * 16 + b // 16])
			buffer.writeu8(out, o + 2, ENCODE[b % 16 * 4])
			buffer.writeu8(out, o + 3, 61)
		end
		return buffer.tostring(out)
	end
end

-- One EditableImage's pixels are read once however many labels show it.
local pixelCache: { [EditableImage]: { px: string, pw: number, ph: number }? } = {}

local function imagePixels(image: EditableImage): { px: string, pw: number, ph: number }?
	local cached = pixelCache[image]
	if cached ~= nil then
		return cached
	end
	local size = image.Size
	local result = nil
	if size.X <= MAX_IMAGE_SIDE and size.Y <= MAX_IMAGE_SIDE then
		local ok, bytes = pcall(function()
			return image:ReadPixelsBuffer(Vector2.zero, size)
		end)
		if ok then
			result = { px = base64(bytes), pw = size.X, ph = size.Y }
		end
	end
	pixelCache[image] = result
	return result
end

type Walk = { nodes: { any }, origin: Vector2, count: number, skipped: number, global: boolean }

local function describe(state: Walk, gui: GuiObject, clip: Rect?)
	local pos = gui.AbsolutePosition - state.origin
	local size = gui.AbsoluteSize
	local node: { [string]: any } = {
		k = "rect",
		x = pos.X,
		y = pos.Y,
		w = size.X,
		h = size.Y,
		rot = gui.AbsoluteRotation,
		bg = rgb(styled(gui, "BackgroundColor3")),
		a = 1 - styled(gui, "BackgroundTransparency"),
		clip = clip,
		z = styled(gui, "ZIndex"),
	}

	for _, child in gui:GetChildren() do
		if child:IsA("UIStroke") and styled(child, "Enabled") and styled(child, "ApplyStrokeMode") == Enum.ApplyStrokeMode.Border then
			node.stroke = { color = rgb(styled(child, "Color")), a = 1 - styled(child, "Transparency"), t = styled(child, "Thickness") }
		elseif child:IsA("UICorner") then
			local radius: UDim = styled(child, "CornerRadius")
			node.corner = radius.Offset + radius.Scale * math.min(size.X, size.Y)
		elseif child:IsA("UIGradient") and styled(child, "Enabled") then
			local colors, alphas = {}, {}
			for _, key in (styled(child, "Color") :: ColorSequence).Keypoints do
				table.insert(colors, { key.Time, key.Value.R, key.Value.G, key.Value.B })
			end
			for _, key in (styled(child, "Transparency") :: NumberSequence).Keypoints do
				table.insert(alphas, { key.Time, key.Value })
			end
			node.grad = { rot = styled(child, "Rotation"), colors = colors, alphas = alphas }
		end
	end

	if gui:IsA("TextLabel") or gui:IsA("TextButton") or gui:IsA("TextBox") then
		node.k = "text"
		local text: string = styled(gui, "Text")
		if gui:IsA("TextBox") and text == "" then
			text = styled(gui, "PlaceholderText")
		end
		local textSize: number = if styled(gui, "TextScaled") then math.min(gui.TextBounds.Y, size.Y) else styled(gui, "TextSize")
		node.text = {
			s = text,
			size = textSize,
			color = rgb(styled(gui, "TextColor3")),
			a = 1 - styled(gui, "TextTransparency"),
			ax = ALIGN_X[styled(gui, "TextXAlignment")] or 0.5,
			ay = ALIGN_Y[styled(gui, "TextYAlignment")] or 0.5,
			wrap = styled(gui, "TextWrapped") == true,
		}
	elseif gui:IsA("ImageLabel") or gui:IsA("ImageButton") then
		node.k = "image"
		local image: { [string]: any } = {
			color = rgb(styled(gui, "ImageColor3")),
			a = 1 - styled(gui, "ImageTransparency"),
		}
		local content: Content = styled(gui, "ImageContent")
		local object = if content.SourceType == Enum.ContentSourceType.Object then content.Object else nil
		if object and object:IsA("EditableImage") then
			local pixels = imagePixels(object)
			if pixels then
				image.px, image.pw, image.ph = pixels.px, pixels.pw, pixels.ph
			end
		elseif content.SourceType == Enum.ContentSourceType.None and (styled(gui, "Image") :: string) == "" then
			image.a = 0
		end
		if styled(gui, "ScaleType") == Enum.ScaleType.Tile then
			local tile: UDim2 = styled(gui, "TileSize")
			image.tile = { w = tile.X.Offset + tile.X.Scale * size.X, h = tile.Y.Offset + tile.Y.Scale * size.Y }
		end
		node.image = image
	elseif gui:IsA("ViewportFrame") then
		node.k = "viewport"
		local parts = 0
		for _, d in gui:GetDescendants() do
			if d:IsA("BasePart") then
				parts += 1
			end
		end
		node.label = if parts > 0 then `VIEWPORT: {parts} PARTS` else "VIEWPORT: EMPTY"
	end

	return node
end

local function walk(state: Walk, gui: GuiObject, clip: Rect?, order: { any })
	if state.count >= MAX_NODES then
		state.skipped += 1
		return
	end
	if not styled(gui, "Visible") then
		return
	end
	state.count += 1
	local node = describe(state, gui, clip)
	table.insert(order, node)

	local childClip = clip
	if styled(gui, "ClipsDescendants") then
		childClip = intersect(clip, { x = node.x, y = node.y, w = node.w, h = node.h })
	end

	local children = {}
	for index, child in gui:GetChildren() do
		if child:IsA("GuiObject") then
			table.insert(children, { child = child, z = styled(child, "ZIndex"), index = index })
		end
	end
	if not state.global then
		table.sort(children, function(a, b)
			if a.z ~= b.z then
				return a.z < b.z
			end
			return a.index < b.index
		end)
	end
	for _, entry in children do
		walk(state, entry.child, childClip, order)
	end
end

-- ScreenGuis in a container draw by DisplayOrder, then by the order they were added.
local function screenGuisUnder(container: Instance): { ScreenGui }
	local guis = {}
	for _, child in container:GetChildren() do
		if child:IsA("ScreenGui") and child.Enabled then
			table.insert(guis, child)
		end
	end
	table.sort(guis, function(a, b)
		return a.DisplayOrder < b.DisplayOrder
	end)
	return guis
end

function Tool.Run(arguments: { root: string?, scale: number?, name: string? }): Result
	local root: Instance
	if type(arguments.root) == "string" and arguments.root ~= "" then
		local found, problem = Path.Resolve(arguments.root)
		if not found then
			return { content = { { type = "text", text = problem :: string } }, isError = true }
		end
		root = found
	else
		local player = game:GetService("Players").LocalPlayer
		local playerGui = if player then player:FindFirstChild("PlayerGui") else nil
		root = playerGui or game:GetService("StarterGui")
	end

	-- Every list of GuiObjects to draw, each with the ScreenGui whose ZIndexBehavior governs it.
	local layers: { { guis: { GuiObject }, global: boolean } } = {}
	local reference: GuiBase2d? = nil
	if root:IsA("GuiObject") then
		local screen = root:FindFirstAncestorWhichIsA("ScreenGui")
		local global = screen ~= nil and screen.ZIndexBehavior == Enum.ZIndexBehavior.Global
		table.insert(layers, { guis = { root }, global = global })
		reference = root
	elseif root:IsA("ScreenGui") then
		local guis = {}
		for _, child in root:GetChildren() do
			if child:IsA("GuiObject") then
				table.insert(guis, child)
			end
		end
		table.insert(layers, { guis = guis, global = root.ZIndexBehavior == Enum.ZIndexBehavior.Global })
		reference = root
	else
		for _, screen in screenGuisUnder(root) do
			local guis = {}
			for _, child in screen:GetChildren() do
				if child:IsA("GuiObject") then
					table.insert(guis, child)
				end
			end
			table.insert(layers, { guis = guis, global = screen.ZIndexBehavior == Enum.ZIndexBehavior.Global })
			reference = reference or screen
		end
	end
	if not reference then
		return {
			content = { { type = "text", text = `{root:GetFullName()} has no ScreenGui or GuiObject to draw` } },
			isError = true,
		}
	end

	local origin = reference.AbsolutePosition
	local size = reference.AbsoluteSize
	if size.X < 1 or size.Y < 1 then
		return {
			content = { { type = "text", text = `{reference:GetFullName()} has no size yet -- nothing is laid out` } },
			isError = true,
		}
	end

	table.clear(pixelCache)
	local state: Walk = { nodes = {}, origin = origin, count = 0, skipped = 0, global = false }
	for _, layer in layers do
		state.global = layer.global
		local order = {}
		local children = {}
		for index, gui in layer.guis do
			table.insert(children, { child = gui, z = styled(gui, "ZIndex"), index = index })
		end
		table.sort(children, function(a, b)
			if a.z ~= b.z then
				return a.z < b.z
			end
			return a.index < b.index
		end)
		for _, entry in children do
			walk(state, entry.child, nil, order)
		end
		if layer.global then
			-- Global: every descendant sorts by ZIndex alone, ties keep tree order.
			for index, node in order do
				node.i = index
			end
			table.sort(order, function(a, b)
				if a.z ~= b.z then
					return a.z < b.z
				end
				return a.i < b.i
			end)
		end
		for _, node in order do
			node.z, node.i = nil, nil
			table.insert(state.nodes, node)
		end
	end
	table.clear(pixelCache)

	local scale = arguments.scale or math.min(1, DEFAULT_MAX_SIDE / math.max(size.X, size.Y))
	local note = if state.skipped > 0 then `, stopped after {MAX_NODES} elements` else ""
	return {
		content = {
			{
				type = "text",
				text = `{state.count} element(s) under {root:GetFullName()}, {size.X}x{size.Y} at {string.format("%.2f", scale)}x{note}`,
			},
		},
		postProcess = {
			kind = "ui",
			name = arguments.name,
			width = size.X,
			height = size.Y,
			scale = scale,
			nodes = state.nodes,
		},
	}
end

return Tool
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="56">
        <Properties>
          <string name="Name">SearchScripts</string>
          <string name="Source"><![CDATA[--!strict

local Bridge = require(script.Parent.Parent.Bridge)
local Path = require(script.Parent.Parent.Path)

local DEFAULT_MAX_RESULTS = 40
local HARD_MAX_RESULTS = 200
local MAX_CONTEXT = 10

type Result = {
	content: { { type: "text", text: string } },
	isError: boolean?,
}

local Tool = {}

Tool.Definition = {
	name = "search_scripts",
	description = "Searches the source of every script under a root and returns the matching "
		.. "lines with their paths. The pattern is a Luau string pattern, not a regex -- use "
		.. "%w and %s, and escape a literal dot as %.. Reads what Studio currently has, which "
		.. "isn't always what's on disk -- pass drift = true instead of a pattern to get the "
		.. "list of scripts where the two disagree.",
	inputSchema = {
		type = "object",
		properties = {
			pattern = {
				type = "string",
				description = "Luau string pattern to search for. Required unless drift is set.",
			},
			drift = {
				type = "boolean",
				description = "Skip searching and instead report every script whose source no "
					.. 'longer matches the file Rojo syncs it from. Answers "is Studio showing '
					.. 'me the same code as the repo" in one call.',
			},
			root = {
				type = "string",
				description = 'Dotted path to search under, like "ServerScriptService". Defaults to game.',
			},
			contextLines = {
				type = "integer",
				description = "Lines of surrounding source to show around each hit. Defaults to 0.",
				minimum = 0,
				maximum = MAX_CONTEXT,
			},
			maxResults = {
				type = "integer",
				description = "Stop after this many matching lines. Defaults to 40.",
				minimum = 1,
				maximum = HARD_MAX_RESULTS,
			},
		},
	},
	tags = { title = "Search Scripts", readOnly = true, idempotent = true },
}

-- FNV-1a, 32 bit. The server runs the same thing over the file on disk; agreeing exactly with it
-- matters far more than the hash being a good one, since all either side ever does is compare a
-- file against itself.
local function mul32(a: number, b: number): number
	-- Split because a * 16777619 loses low bits once a is near 2^32 -- doubles run out of mantissa
	-- well before the product fits.
	local high = bit32.band(bit32.rshift(a, 16) * b, 0xFFFF)
	return bit32.band(bit32.lshift(high, 16) + bit32.band(a, 0xFFFF) * b, 0xFFFFFFFF)
end

local function fingerprint(source: string): number
	-- Line endings and a trailing newline are the editor's business, not a real difference.
	local text = source:gsub("\r\n", "\n"):gsub("%s+$", "")
	local hash = 2166136261
	for index = 1, #text do
		hash = mul32(bit32.bxor(hash, string.byte(text, index)), 16777619)
	end
	return hash
end

local function checkDrift(root: Instance): Result
	local scripts = {}
	local unreadable = 0
	for _, instance in root:GetDescendants() do
		if not instance:IsA("LuaSourceContainer") then
			continue
		end
		local readable, source = pcall(function()
			return (instance :: any).Source
		end)
		if not readable or type(source) ~= "string" then
			unreadable += 1
			continue
		end
		table.insert(scripts, {
			path = instance:GetFullName(),
			className = instance.ClassName,
			hash = fingerprint(source),
		})
	end

	local ok, payload = Bridge.Request("source/drift", { scripts = scripts }, 30)
	if not ok then
		return { content = { { type = "text", text = tostring(payload) } }, isError = true }
	end

	local drift = payload.drift or {}
	if #drift == 0 then
		local text = `Studio and {payload.projectPath} agree on all {#scripts} script(s).`
		if unreadable > 0 then
			text ..= ` {unreadable} couldn't be read -- allow script injection for VMCP in Plugin Management.`
		end
		return { content = { { type = "text", text = text } } }
	end

	local lines = { `{#drift} of {#scripts} script(s) disagree with {payload.projectPath}:` }
	for _, entry in drift do
		local where = if entry.file then ` -> {entry.file}` else ""
		table.insert(lines, `  {entry.problem}: {entry.path}{where}`)
	end
	table.insert(lines, "")
	table.insert(lines, '"not in studio" means the file exists but never synced; "not on disk"')
	table.insert(lines, "means the script was made in Studio and Rojo has nothing to write it to.")

	return { content = { { type = "text", text = table.concat(lines, "\n") } } }
end

local function splitLines(source: string): { string }
	local lines = {}
	for line in string.gmatch(source .. "\n", "([^\n]*)\n") do
		table.insert(lines, line)
	end
	return lines
end

function Tool.Run(
	arguments: { pattern: string?, root: string?, contextLines: number?, maxResults: number?, drift: boolean? }
): Result
	local root: Instance = game
	if type(arguments.root) == "string" and arguments.root ~= "" then
		local found, why = Path.Resolve(arguments.root :: string)
		if not found then
			return { content = { { type = "text", text = why :: string } }, isError = true }
		end
		root = found
	end

	if arguments.drift then
		return checkDrift(root)
	end

	local pattern = arguments.pattern
	if type(pattern) ~= "string" or pattern == "" then
		return {
			content = { { type = "text", text = "pass either a pattern to search for or drift = true" } },
			isError = true,
		}
	end
	local valid, problem = pcall(string.find, "", pattern)
	if not valid then
		return { content = { { type = "text", text = `pattern isn't valid: {problem}` } }, isError = true }
	end

	local context = math.clamp(arguments.contextLines or 0, 0, MAX_CONTEXT)
	local limit = math.clamp(arguments.maxResults or DEFAULT_MAX_RESULTS, 1, HARD_MAX_RESULTS)

	local out = {}
	local hits = 0
	local unreadable = 0
	local truncated = false

	for _, instance in root:GetDescendants() do
		if not instance:IsA("LuaSourceContainer") then
			continue
		end
		-- Reading Source needs the same script injection permission writing it does.
		local readable, source = pcall(function()
			return (instance :: any).Source
		end)
		if not readable or type(source) ~= "string" then
			unreadable += 1
			continue
		end
		if not string.find(source, pattern) then
			continue
		end

		local lines = splitLines(source)
		for number, line in lines do
			if not string.find(line, pattern) then
				continue
			end
			if hits >= limit then
				truncated = true
				break
			end
			hits += 1

			table.insert(out, `{instance:GetFullName()}:{number}`)
			for index = math.max(number - context, 1), math.min(number + context, #lines) do
				local marker = if index == number then ">" else " "
				table.insert(out, `{marker} {index}: {lines[index]}`)
			end
		end
		if truncated then
			break
		end
	end

	if hits == 0 then
		local text = `no script under {root:GetFullName()} matched`
		if unreadable > 0 then
			text ..= `. {unreadable} script(s) couldn't be read -- allow script injection for VMCP in Plugin Management`
		end
		return { content = { { type = "text", text = text } } }
	end

	if truncated then
		table.insert(out, `-- stopped at {limit} matches; narrow the pattern or the root`)
	end
	if unreadable > 0 then
		table.insert(out, `-- {unreadable} script(s) couldn't be read (script injection not allowed)`)
	end

	return { content = { { type = "text", text = table.concat(out, "\n") } } }
end

return Tool
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="57">
        <Properties>
          <string name="Name">TimelinePart</string>
          <string name="Source"><![CDATA[--!strict

-- Plumbing: the half of run_timeline that runs inside one DataModel. Tagged internal, so it never
-- shows up in the tool list -- run_timeline invokes it once per context, and the server routes
-- each call to the right place.

local RunService = game:GetService("RunService")

local Bridge = require(script.Parent.Parent.Bridge)
local Buffer = require(script.Parent.Parent.Log.Buffer)
local Env = require(script.Parent.Parent.Env)
local Inject = require(script.Parent.Parent.Exec.Inject)
local Runtime = require(script.Parent.Parent.Timeline.Runtime)

local MAX_LOG_LINES = 60

type Result = {
	content: { { type: "text", text: string } },
	isError: boolean?,
}

local Tool = {}

Tool.Definition = {
	name = "timeline_part",
	description = "Internal. Runs one context's share of a timeline.",
	inputSchema = {
		type = "object",
		properties = {
			events = { type = "array", items = { type = "object" } },
			duration = { type = "number" },
			origin = { type = "string" },
			context = { type = "string", enum = { "plugin", "server", "client" } },
			player = { type = "integer", minimum = 1 },
		},
		required = { "events" },
	},
	tags = { title = "Timeline Part", internal = true },
	timeoutMs = 300000,
}

function Tool.Run(arguments: { events: any, duration: number?, origin: string? }): Result
	local events = arguments.events
	if type(events) ~= "table" then
		return { content = { { type = "text", text = "events must be an array" } }, isError = true }
	end

	local connection = Bridge.Connection()
	local origin = arguments.origin or connection.role
	local ctx = Runtime.Context(origin)

	-- Compiled up front, all of them, before the clock starts: an event that doesn't compile
	-- should stop the run rather than fire a hole in the middle of it.
	local compiled: { Runtime.Event } = {}
	for index, spec in events do
		local run, problem = Inject.Compile(spec.code, "ctx, input, vmcp")
		if not run then
			local label = spec.label or `events[{index}]`
			return {
				content = { { type = "text", text = `{label} didn't compile: {problem}` } },
				isError = true,
			}
		end
		table.insert(compiled, { at = spec.at, blocking = spec.blocking, label = spec.label, run = run })
	end

	-- Input only exists on a client: UserInputService is client-side, and a virtual keypress on
	-- the server would have nothing to press against.
	local input = if RunService:IsClient() then Runtime.Input() else nil
	local cursor = Buffer.written

	Runtime.Run(compiled, ctx, input, Env, arguments.duration or 0, function(text: string)
		ctx:Note(text)
	end)

	if input then
		input:ReleaseEverything()
		for _, problem in input.problems do
			ctx:Note(`input: {problem}`)
		end
	end

	-- Output goes back as context notes rather than in this reply, because run_timeline reads the
	-- context and never sees the individual replies.
	task.wait()
	local logged = Buffer.Since(cursor)
	for index, entry in logged do
		if index > MAX_LOG_LINES then
			ctx:Note(`... and {#logged - MAX_LOG_LINES} more lines of output`)
			break
		end
		ctx:Note(`[{entry.severity}] {entry.text}`)
	end

	return { content = { { type = "text", text = `{origin} ran {#compiled} event(s)` } } }
end

return Tool
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="58">
        <Properties>
          <string name="Name">TryScripts</string>
          <string name="Source"><![CDATA[--!strict

-- Starts a playtest in which some scripts run replacement Source, so the user can play a
-- candidate fix before it's written anywhere. The place, the file on disk and Studio's own copy
-- are all untouched by the time this returns; stopping the playtest is the whole revert.

local Path = require(script.Parent.Parent.Path)
local Swap = require(script.Parent.Parent.Playtest.Swap)

local MAX_SCRIPTS = 16

type Result = {
	content: { { type: "text", text: string } },
	isError: boolean?,
}

local Tool = {}

Tool.Definition = {
	name = "try_scripts",
	description = "Starts a playtest that runs the Source you pass in place of the named scripts -- "
		.. "for handing the user a candidate fix to play before anything is applied. The swap "
		.. "happens only for the seconds the playtest takes to boot; Studio's Source is back to "
		.. "the original before this returns, nothing is saved and nothing reaches disk. Stopping "
		.. 'the playtest (playtest { action = "stop" }, or the user\'s Stop button) is the revert. '
		.. "A playtest already running is stopped and restarted. Batch every script the fix "
		.. "touches into one call; pass the whole Source, not a diff.",
	inputSchema = {
		type = "object",
		properties = {
			scripts = {
				type = "array",
				minItems = 1,
				maxItems = MAX_SCRIPTS,
				items = {
					type = "object",
					properties = {
						script = { type = "string", description = 'Dotted path, like "ServerScriptService.Combat".' },
						source = { type = "string", description = "The complete replacement Source." },
					},
					required = { "script", "source" },
				},
			},
			players = {
				type = "integer",
				description = "Test clients to launch. Defaults to 1 (Play Solo).",
				minimum = 1,
				maximum = 8,
			},
		},
		required = { "scripts" },
	},
	tags = { title = "Try Scripts", destructive = true },
	timeoutMs = 150000,
}

local function text(body: string, isError: boolean?): Result
	return { content = { { type = "text", text = body } }, isError = isError }
end

function Tool.Run(arguments: { scripts: { { script: string, source: string } }?, players: number? }): Result
	local scripts = arguments.scripts
	if type(scripts) ~= "table" or #scripts == 0 then
		return text("scripts must be a non-empty array of { script, source }", true)
	end
	if #scripts > MAX_SCRIPTS then
		return text(`at most {MAX_SCRIPTS} scripts per call`, true)
	end

	local replacements: { Swap.Replacement } = {}
	local names = {}
	for index, entry in scripts do
		if type(entry.source) ~= "string" or entry.source == "" then
			return text(`script {index} needs a source`, true)
		end
		local instance, why = Path.Resolve(entry.script)
		if not instance then
			return text(why :: string, true)
		end
		local _, unreadable = Swap.ReadSource(instance)
		if unreadable then
			return text(unreadable, true)
		end
		table.insert(replacements, { instance = instance, source = entry.source })
		table.insert(names, instance:GetFullName())
	end

	local failure, restarted = Swap.Start(replacements, arguments.players or 1, "server")
	if failure then
		return text(failure, true)
	end

	local lines = {
		`Playtest running with replacement Source in {#replacements} script(s):`,
		"  " .. table.concat(names, "\n  "),
		"",
		"Studio, the place and disk all still hold the originals. Tell the user to play it; stop "
			.. 'the playtest with playtest { action = "stop" } to go back to the original everywhere.',
	}
	if restarted then
		table.insert(lines, "(a playtest was already running and was restarted)")
	end
	return text(table.concat(lines, "\n"))
end

return Tool
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="59">
        <Properties>
          <string name="Name">UploadImage</string>
          <string name="Source"><![CDATA[--!strict

-- Publishes a picture as a Roblox Image asset, so a script can use rbxassetid://id at runtime
-- instead of an EditableImage that only exists in this session. The upload itself happens on
-- the VMCP server over Open Cloud, because Studio's own CreateAssetAsync isn't enabled
-- everywhere yet; the plugin's job is to say what to upload and who should own it.

local Path = require(script.Parent.Parent.Path)
local Canvas = require(script.Parent.Parent.Lib.Canvas)

type Result = {
	content: { { type: "text", text: string } },
	isError: boolean?,
	postProcess: { [string]: any }?,
}

local Tool = {}

Tool.Definition = {
	name = "upload_image",
	description = "Uploads an image as a Roblox Image asset and returns its rbxassetid, so the "
		.. "picture can be used at runtime without EditableImage. Give it either `file`, the "
		.. "name of a PNG vmcp.Render already wrote under ~/.vmcp/images, or `root`, a dotted "
		.. "path to an ImageLabel/ImageButton showing an EditableImage (or the EditableImage "
		.. "itself). `owner` is the Studio user by default; pass a group id to upload there. "
		.. "First-time setup: pass `apiKey` once (an Open Cloud key with the assets read/write "
		.. "scope for that user or group) and it's remembered in ~/.vmcp/roblox-api-key. "
		.. "Moderation runs after upload, so the id is usable at once and the picture appears a "
		.. "little later.",
	inputSchema = {
		type = "object",
		properties = {
			file = {
				type = "string",
				description = "Name of a PNG under ~/.vmcp/images, without the extension -- what you gave vmcp.Render.",
			},
			root = {
				type = "string",
				description = "Dotted path to an ImageLabel, ImageButton or EditableImage in the place.",
			},
			name = {
				type = "string",
				description = "Asset display name. Defaults to the file or instance name.",
			},
			description = { type = "string", description = "Asset description." },
			owner = {
				type = "string",
				description = '"user" (default: whoever is logged into Studio) or a group id like "12345678".',
			},
			apiKey = {
				type = "string",
				description = "Open Cloud API key to remember for every later upload. Only needed once.",
			},
		},
	},
	tags = { title = "Upload Image", external = true },
	timeoutMs = 90000,
}

local function studioUserId(): number?
	local ok, id = pcall(function()
		return game:GetService("StudioService"):GetUserId()
	end)
	return if ok then id else nil
end

local function fail(text: string): Result
	return { content = { { type = "text", text = text } }, isError = true }
end

function Tool.Run(arguments: {
	file: string?,
	root: string?,
	name: string?,
	description: string?,
	owner: string?,
	apiKey: string?,
}): Result
	local directive: { [string]: any } = {
		kind = "upload",
		apiKey = arguments.apiKey,
		description = arguments.description,
	}

	local owner = arguments.owner
	if owner == nil or owner == "" or owner == "user" then
		local userId = studioUserId()
		if not userId then
			return fail("couldn't read the Studio user; pass owner as a group id instead")
		end
		directive.userId = userId
	else
		local groupId = tonumber(owner)
		if not groupId then
			return fail(`owner must be "user" or a group id, not "{owner}"`)
		end
		directive.groupId = groupId
	end

	if type(arguments.file) == "string" and arguments.file ~= "" then
		directive.file = arguments.file
		directive.name = arguments.name or arguments.file
	elseif type(arguments.root) == "string" and arguments.root ~= "" then
		local found, problem = Path.Resolve(arguments.root)
		if not found then
			return fail(problem :: string)
		end
		local image: EditableImage? = nil
		if found:IsA("EditableImage") then
			image = found
		elseif found:IsA("ImageLabel") or found:IsA("ImageButton") then
			local content = (found :: any):GetStyled("ImageContent") :: Content
			local object = if content.SourceType == Enum.ContentSourceType.Object then content.Object else nil
			if object and object:IsA("EditableImage") then
				image = object
			end
		end
		if not image then
			return fail(`{found:GetFullName()} isn't an EditableImage or an image label showing one`)
		end
		local pixels = Canvas.Base64Pixels(image)
		if not pixels then
			return fail(`{found:GetFullName()} is too big to send ({image.Size.X}x{image.Size.Y}); render it with vmcp.Render first and upload the file`)
		end
		directive.width = image.Size.X
		directive.height = image.Size.Y
		directive.pixels = pixels
		directive.name = arguments.name or found.Name
	elseif arguments.apiKey then
		-- Just storing the key is a fine call on its own.
		directive.name = nil
	else
		return fail("give `file` (a PNG vmcp.Render wrote) or `root` (an image in the place)")
	end

	local what = if directive.file then `~/.vmcp/images/{directive.file}.png` elseif directive.pixels then arguments.root else "nothing"
	local who = if directive.groupId then `group {directive.groupId}` else `user {directive.userId}`
	return {
		content = { { type = "text", text = `uploading {what} as "{directive.name or "-"}" owned by {who}` } },
		postProcess = directive,
	}
end

return Tool
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>